; Python schema architecture policy. Executing analysis and
; orchestration are native TypeScript owners, absent from this import graph.
;
; Run with `lint-imports` (see scripts/check.ps1 and .github/workflows/ci.yml).

[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:core-is-the-floor]
; Metadata and migration connection wiring never import model or business owners.
name = Core depends on no business logic
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.domain
    app.models
    app.connectors

[importlinter:contract:models-are-persistence-only]
name = Models depend on no upper layer
type = forbidden
source_modules =
    app.models
forbidden_modules =
    app.domain
    app.core.migration_config
    app.core.config.dotenv

[importlinter:contract:schema-dependencies-only]
name = Schema tooling imports no retired application dependencies
type = forbidden
source_modules =
    app
forbidden_modules =
    pydantic
    pydantic_settings
    dotenv
    httpx
    cryptography
    argon2
    joserfc
