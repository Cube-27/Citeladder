{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citeladder.com/schemas/industry-pack.schema.json",
  "title": "CiteLadder Industry Knowledge Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "version",
    "catalog_contract_version",
    "label",
    "summary",
    "maturity",
    "risk_level",
    "aliases",
    "subindustries",
    "capability_ids",
    "classification_policy",
    "page_roles",
    "entity_types",
    "assertion_predicates",
    "relation_types",
    "journeys",
    "question_contracts",
    "analysis_rules",
    "brief_templates",
    "prompt_archetypes",
    "generation_policy",
    "review_requirements",
    "evaluation"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "catalog_contract_version": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "maturity": {
      "enum": [
        "foundation",
        "validated_candidate",
        "authoritative",
        "deprecated"
      ]
    },
    "risk_level": {
      "enum": [
        "standard",
        "moderate_regulated",
        "high_regulated"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "subindustries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "classification_policy": {
      "type": "object"
    },
    "page_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "entity_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "assertion_predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "relation_types": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "question_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "analysis_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "brief_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "prompt_archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "generation_policy": {
      "type": "object"
    },
    "review_requirements": {
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    }
  }
}
