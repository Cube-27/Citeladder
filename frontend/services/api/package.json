{
  "name": "@citeladder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "assets"
  ],
  "scripts": {
    "start": "node src/server.ts",
    "runner": "node src/runner.ts",
    "tick": "node src/tick.ts",
    "audit:reprice": "node src/cli/reprice-execution-costs.ts",
    "provision:platform": "node src/cli/provision-platform-providers.ts",
    "acquisition:control": "node src/cli/acquisition-control.ts",
    "agreement:record": "node src/cli/enterprise-agreement.ts",
    "account:manage": "node src/cli/account-manager.ts",
    "billing:admin": "node src/cli/billing-admin.ts",
    "billing:plans": "node src/cli/provision-razorpay-plans.ts",
    "billing:backfill": "node src/cli/backfill-billing.ts",
    "entitlement:site-health": "node src/cli/set-site-health-entitlement.ts",
    "bootstrap:catalog": "node src/cli/bootstrap-catalog.ts",
    "seed:site-health": "node scripts/seed-site-health.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:routes": "node scripts/check-route-ownership.ts",
    "jev:calibrate": "node scripts/jev-calibration.ts",
    "mcp:reference": "node scripts/export-mcp-tool-reference.ts",
    "crawl:worker": "node scripts/export-crawl-worker.ts",
    "db:types": "kysely-codegen --dialect postgres --url \"env(TYPES_DATABASE_URL)\" --exclude-pattern alembic_version --out-file src/generated/db-schema.ts",
    "db:types:check": "kysely-codegen --dialect postgres --url \"env(TYPES_DATABASE_URL)\" --exclude-pattern alembic_version --out-file src/generated/db-schema.ts --verify"
  },
  "dependencies": {
    "@citeladder/contracts": "workspace:*",
    "@fontsource/noto-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@noble/hashes": "^2.4.0",
    "@node-rs/argon2": "^2.2.1",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "fontkit": "^2.0.4",
    "hono": "^4.13.12",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "parse5": "^8.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
