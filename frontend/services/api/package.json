{
  "name": "@citeladder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "worker:discovery": "node src/discovery-worker.ts",
    "integration-worker": "node src/integration-worker.ts",
    "integration-dispatcher": "node src/integration-dispatcher.ts",
    "billing-worker": "node src/billing-worker.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:routes": "node scripts/check-route-ownership.ts",
    "jev:calibrate": "node scripts/jev-calibration.ts",
    "mcp:reference": "node scripts/export-mcp-tool-reference.ts",
    "db:types": "kysely-codegen --dialect postgres --url \"env(TYPES_DATABASE_URL)\" --exclude-pattern alembic_version --out-file src/generated/db-schema.ts",
    "db:types:check": "kysely-codegen --dialect postgres --url \"env(TYPES_DATABASE_URL)\" --exclude-pattern alembic_version --out-file src/generated/db-schema.ts --verify"
  },
  "dependencies": {
    "@citeladder/contracts": "workspace:*",
    "@fontsource/noto-sans": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@noble/hashes": "^2.4.0",
    "@node-rs/argon2": "^2.2.1",
    "csv-parse": "^7.0.3",
    "fontkit": "^2.0.4",
    "hono": "^4.13.10",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "parse5": "^8.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "tldts": "^7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  }
}
