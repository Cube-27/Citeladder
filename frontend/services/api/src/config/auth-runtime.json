{
  "settings": {
    "resend_api_key": { "env": ["RESEND_API_KEY"], "type": "str", "default": "" },
    "auth_mail_timeout_ms": {
      "env": ["AUTH_MAIL_TIMEOUT_MS"],
      "type": "int",
      "default": 5000,
      "minimum": 1,
      "maximum": 10000
    },
    "request_id_header": {
      "env": ["REQUEST_ID_HEADER"],
      "type": "str",
      "default": "X-Request-ID"
    },
    "session_cookie_name": {
      "env": ["SESSION_COOKIE_NAME"],
      "type": "str",
      "default": "citeladder_session"
    },
    "public_signup_enabled": {
      "env": ["PUBLIC_SIGNUP_ENABLED"],
      "type": "bool",
      "default": false
    },
    "dev_login_counter_allowance": {
      "env": ["DEV_LOGIN_COUNTER_ALLOWANCE", "dev_login_counter_allowance"],
      "type": "int",
      "default": 200,
      "minimum": 1,
      "maximum": 50000
    },
    "demo_monitored_url_limit": {
      "env": ["DEMO_MONITORED_URL_LIMIT", "demo_monitored_url_limit"],
      "type": "int",
      "default": 50000,
      "minimum": 1,
      "maximum": 50000
    },
    "jwt_secret_key": {
      "env": ["JWT_SECRET_KEY"],
      "type": "str",
      "default": "change-me-32-bytes-minimum-change-me"
    },
    "jwt_algorithm": {
      "env": ["JWT_ALGORITHM"],
      "type": "literal",
      "values": ["HS256"],
      "default": "HS256"
    },
    "jwt_expire_hours": {
      "env": ["JWT_EXPIRE_HOURS"],
      "type": "int",
      "default": 24
    },
    "frontend_url": {
      "env": ["FRONTEND_URL"],
      "type": "str",
      "default": "http://127.0.0.1:3000"
    },
    "public_api_url": {
      "env": ["PUBLIC_API_URL"],
      "type": "str",
      "default": ""
    },
    "trusted_proxy_cidrs": {
      "env": ["TRUSTED_PROXY_CIDRS"],
      "type": "str",
      "default": ""
    },
    "demo_mode": {
      "env": ["DEMO_MODE"],
      "type": "bool",
      "default": false
    },
    "demo_expires_at": {
      "env": ["DEMO_EXPIRES_AT"],
      "type": "datetime",
      "nullable": true,
      "default": null
    },
    "encryption_key": {
      "env": ["ENCRYPTION_KEY"],
      "type": "str",
      "default": "replace-with-32-byte-minimum-secret"
    },
    "api_key_pepper": {
      "env": ["API_KEY_PEPPER"],
      "type": "str",
      "default": "replace-with-a-32-byte-minimum-api-key-pepper"
    },
    "referral_hash_salt": {
      "env": ["REFERRAL_HASH_SALT"],
      "type": "str",
      "default": "replace-with-64-byte-random-secret"
    },
    "dev_login_email": {
      "env": ["DEV_LOGIN_EMAIL"],
      "type": "str",
      "default": "dev@citeladder.com"
    },
    "dev_login_password": {
      "env": ["DEV_LOGIN_PASSWORD"],
      "type": "str",
      "default": ""
    }
  },
  "terms_revision": "2026-09-24",
  "mailbox": {
    "daily_window_seconds": 86400,
    "verification_ttl_seconds": 86400,
    "reset_ttl_seconds": 1800,
    "cooldown_seconds": 60,
    "recipient_daily_limit": 10,
    "global_daily_limit": 1000,
    "trial_daily_limit": 100,
    "request_limit": 20,
    "request_window_seconds": 3600,
    "sender": "notifications@citeladder.com",
    "reply_to": "contact@citeladder.com",
    "endpoint": "https://api.resend.com/emails"
  },
  "privacy_revision": "2026-09-28",
  "session": { "clock_tolerance_seconds": 30 },
  "password": {
    "memoryCost": 19456,
    "timeCost": 2,
    "parallelism": 1,
    "outputLen": 32
  },
  "secret_policy": {
    "min_bytes": 32,
    "min_unique_chars": 12,
    "insecure_values": [
      "change-me",
      "change-me-32-bytes-minimum-change-me",
      "replace-with-32-byte-minimum-secret",
      "replace-with-64-byte-random-secret",
      "replace-with-a-32-byte-minimum-api-key-pepper"
    ],
    "weak_words": ["changeme", "citeladder", "password", "secret"],
    "login_password": {
      "min_chars": 8,
      "max_chars": 128,
      "min_unique_chars": 4,
      "weak_words": ["changeme", "citeladder", "password"]
    }
  }
}
