    "/nl",
    "/no",
    "/pl",
    "/pt",
    "/ru",
    "/sv",
    "/th",
    "/tr",
    "/vi",
    "/zh"
  ],
  "route_document_extensions": ["asp", "aspx", "htm", "html", "jsp", "php"],
  "homepage_locale_root_pattern": "^/[a-z]{2}[-_](?:[a-z]{2}|[0-9]{3}|hans|hant|latn|cyrl)$",
  "tracking_params": [
    "_hsenc",
    "_hsmi",
    "fbclid",
    "gclid",
    "intpromo",
    "mc_cid",
    "mc_eid",
    "msclkid",
    "ref",
    "ref_src",
    "utm_campaign",
    "utm_content",
    "utm_medium",
    "utm_source",
    "utm_term"
  ],
  "ignored_query_keys": [
    "_pos",
    "_psq",
    "_sid",
    "_ss",
    "_v",
    "qv",
    "srsltid",
    "variant",
    "variant_id"
  ],
  "ts_owned_task_kinds": [
    "analyze",
    "architecture",
    "change_intel",
    "discover",
    "finalize",
    "link_metrics",
    "site_setup"
  ],
  "web_fetch": {
    "user_agent": "CiteLadderSiteHealthBot/1.0 (+https://citeladder.com/crawler)",
    "ports": [80, 443],
    "schemes": ["http", "https"]
  }
}
