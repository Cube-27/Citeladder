{
  "crawl": {
    "page_kinds": {
      "homepage": {
        "priority": 100,
        "tracked_share": 1,
        "sitemap_words": [],
        "path_words": []
      },
      "product": {
        "priority": 90,
        "tracked_share": 3,
        "sitemap_words": ["product", "products"],
        "path_words": ["product", "products", "p"]
      },
      "comparison": {
        "priority": 85,
        "tracked_share": 2,
        "sitemap_words": [],
        "path_words": ["comparison", "compare", "vs", "versus"]
      },
      "service": {
        "priority": 80,
        "tracked_share": 2,
        "sitemap_words": [],
        "path_words": ["service", "services", "solutions"]
      },
      "local": {
        "priority": 80,
        "tracked_share": 2,
        "sitemap_words": ["store", "stores", "storelocation", "location", "locations"],
        "path_words": ["local", "locations", "location", "stores", "store", "store-locator"]
      },
      "category": {
        "priority": 70,
        "tracked_share": 2,
        "sitemap_words": [
          "category",
          "categories",
          "collection",
          "collections",
          "brand",
          "brands",
          "colour",
          "colours",
          "color",
          "colors"
        ],
        "path_words": ["category", "collections", "collection", "categories", "shop"]
      },
      "pricing": {
        "priority": 70,
        "tracked_share": 1,
        "sitemap_words": [],
        "path_words": ["pricing", "plans", "prices"]
      },
      "about_contact": {
        "priority": 65,
        "tracked_share": 1,
        "sitemap_words": [],
        "path_words": ["about", "company", "team", "who-we-are", "contact", "get-in-touch"]
      },
      "article": {
        "priority": 60,
        "tracked_share": 2,
        "sitemap_words": ["post", "posts", "blog", "blogs", "article", "articles", "news"],
        "path_words": ["article", "blog", "articles", "news", "insights"]
      },
      "guide": {
        "priority": 60,
        "tracked_share": 2,
        "sitemap_words": [],
        "path_words": ["guide", "guides", "resources", "learn"]
      },
      "faq": {
        "priority": 60,
        "tracked_share": 2,
        "sitemap_words": ["faq", "faqs"],
        "path_words": ["faq", "faqs"]
      },
      "docs": {
        "priority": 60,
        "tracked_share": 2,
        "sitemap_words": ["documentation", "docs", "help", "support"],
        "path_words": ["docs", "documentation", "help", "support"]
      },
      "trust_policy": {
        "priority": 40,
        "tracked_share": 1,
        "sitemap_words": [],
        "path_words": ["trust", "privacy", "terms", "legal", "policy", "policies", "security"]
      },
      "other": {
        "priority": 20,
        "tracked_share": 1,
        "sitemap_words": [],
        "path_words": []
      }
    },
    "sitemap_neutral_words": ["sitemap", "sitemaps", "core", "xml", "gz"],
    "sitemap_neutral_token_pattern": "^[a-z]{0,2}$",
    "exclusions": {
      "hard_path": "hard_excluded_path",
      "hard_asset": "hard_excluded_asset",
      "hard_query": "hard_excluded_query",
      "out_of_scope": "out_of_scope",
      "invalid": "invalid_url",
      "duplicate": "duplicate",
      "hard_host": "hard_excluded_host"
    },
    "inventory_document_extensions": [
      ".doc",
      ".docx",
      ".md",
      ".pdf",
      ".ppt",
      ".pptx",
      ".xls",
      ".xlsx"
    ],
    "document_media_types": [
      "application/msword",
      "application/pdf",
      "application/vnd.ms-excel",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "text/markdown"
    ],
    "disposition_version": "sh-disposition-1",
    "automatic_monitor_limit_key": "automatic_monitor_limit",
    "admission_policy_version": "sh-url-admission-1",
    "site_setup_priority_boost": 1000,
    "finalize": {
      "max_attempts": 3,
      "priority": 1000,
      "read_pages": 500,
      "batch_pages": 200,
      "projection_pages": 500,
      "error_code": "finalize_failed",
      "error_message": "Publishing this crawl's results failed after every retry"
    },
    "cancel_db_conflict_retries": 3,
    "analyze_priority_boost": 1000,
    "link_rewrite": {
      "reason": "encoded_tracking_query_delimiter",
      "version": "sh-link-rewrite-1"
    },
    "robots_path": "/robots.txt",
    "robots_statuses": {
      "fetched": "fetched",
      "access_blocked": "access_blocked",
      "fetch_failed": "fetch_failed",
      "not_found": "not_found"
    },
    "max_declared_sitemaps": 16,
    "max_url_chars": 2048,
    "max_referrers_per_url": 10,
    "frontier_statuses": {
      "admitted": "admitted",
      "pending": "pending"
    },
    "llms_path": "/llms.txt",
    "sitemap_default_paths": ["/sitemap.xml"],
    "sitemap_content_types": [
      "application/gzip",
      "application/x-gzip",
      "application/xml",
      "text/xml"
    ],
    "sitemap_path_suffixes": [".xml", ".xml.gz"],
    "sitemap_index_refetch": {
      "cache_bust_param": "cl",
      "child_answers": ["absent", "unread"]
    },
    "coverage_expected_value_kinds": ["about_contact", "pricing"]
  },
  "route_patterns": [
    [
      "editorial_index",
      "^/(?:[^/]+/)*?(blogs?|news|articles?|insights|resources|press)(?:/(?:page/\\d+|(?:category|categories|tag|tags)/[^/]+)(?:/page/\\d+)?)?$"
    ],
    ["article", "^/(?:[^/]+/)*?(blogs?|news|articles?)(/|$)"],
    ["product", "^/(?:[^/]+/)*?(products?|p)(/|$)"],
    [
      "category",
      "^/(?:[^/]+/)*?(category|categories|collections?|catalog|shop|offers?|offers-list|deals?|search|q)(/|$)"
    ],
    ["service", "^/(?:[^/]+/)*?(services?|solutions?)(/|$)"],
    ["local", "^/(?:[^/]+/)*?(locations?|stores?|offices?)(/|$)"],
    ["guide", "^/(?:[^/]+/)*?(guides?|care-guide|how-to|tutorials?)(/|$)"],
    ["editorial_index", "^/(?:[^/]+/)*?(compare|comparisons)$"],
    ["comparison", "^/(?:[^/]+/)*?(compare|comparisons?|vs)(/|$)"],
    ["pricing", "^/(?:[^/]+/)*?(pricing|plans)(/|$)"],
    ["faq", "^/(?:[^/]+/)*?faqs?(/|$)"],
    [
      "docs",
      "^/(?!.*(?:/|^)faqs?(?:/|$))(?:[^/]+/)*?(docs|documentation|reference|api|help|support)(/|$)"
    ],
    [
      "about_contact",
      "^/(?:[^/]+/)*?(about|about-us|company|our-story|contact|contact-us|request-demo|book-demo)(/|$)"
    ],
    [
      "case_study_review",
      "^/(?:[^/]+/)*?(case-study|case-studies|customers?|reviews?|testimonials?)(/|$)"
    ],
    [
      "trust_policy",
      "^/(?:[^/]+/)*?(privacy|privacy-policy|terms|terms-conditions|terms-of-service|cookies?|refund|returns?|returns-exchanges|shipping-policy|security|trust|policies?|legal)(/|$)"
    ]
  ],
  "slug_patterns": [
    ["comparison", "(^|-)(vs|versus|compared-to|comparison)(-|$)"],
    ["alternative", "(^|-)(alternatives?|competitors?|substitutes?)(-|$)"],
    ["how_to", "(^|-)(how-to|tutorials?)(-|$)"],
    ["listicle", "(^|-)(best(?!-sell)|top-\\d+|\\d+-best)(-|$)"]
  ],
  "homepage_paths": [
    "",
    "/ar",
    "/da",
    "/de",
    "/default",
    "/en",
    "/es",
    "/fi",
    "/fr",
    "/hi",
    "/home",
    "/id",
