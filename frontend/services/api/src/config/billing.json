{
  "settings": {
    "checkout_provider": {
      "env": ["BILLING_CHECKOUT_PROVIDER"],
      "type": "str",
      "default": "razorpay"
    },
    "india_gst_rate": {
      "env": ["BILLING_INDIA_GST_RATE"],
      "type": "decimal",
      "nullable": true,
      "default": null
    },
    "india_gst_approval_reference": {
      "env": ["BILLING_INDIA_GST_APPROVAL_REFERENCE"],
      "type": "str",
      "default": ""
    },
    "seller_legal_name": {
      "env": ["BILLING_SELLER_LEGAL_NAME"],
      "type": "str",
      "default": "CUBE27 IT PRIVATE LIMITED"
    },
    "seller_legal_address": {
      "env": ["BILLING_SELLER_LEGAL_ADDRESS"],
      "type": "str",
      "default": "Plot No 12, Mulberry Garden 1, Magarpatta City, Hadapsar, Pune, Maharashtra 411013, India"
    },
    "seller_email": {
      "env": ["BILLING_SELLER_EMAIL"],
      "type": "str",
      "default": "contact@cube27.com"
    },
    "seller_gstin": {
      "env": ["BILLING_SELLER_GSTIN"],
      "type": "str",
      "default": "27AAJCC0427H1ZU"
    },
    "seller_gst_state_code": {
      "env": ["BILLING_SELLER_GST_STATE_CODE"],
      "type": "str",
      "default": "27"
    },
    "seller_gst_state_name": {
      "env": ["BILLING_SELLER_GST_STATE_NAME"],
      "type": "str",
      "default": "Maharashtra"
    },
    "seller_sac": {
      "env": ["BILLING_SELLER_SAC"],
      "type": "str",
      "default": ""
    },
    "seller_lut_reference": {
      "env": ["BILLING_SELLER_LUT_REFERENCE"],
      "type": "str",
      "default": ""
    },
    "invoice_prefix": {
      "env": ["BILLING_INVOICE_PREFIX"],
      "type": "str",
      "default": "CL"
    },
    "request_timeout_seconds": {
      "env": ["BILLING_REQUEST_TIMEOUT_SECONDS"],
      "type": "float",
      "default": 15
    },
    "checkout_enabled": {
      "env": ["BILLING_CHECKOUT_ENABLED"],
      "type": "bool",
      "default": false
    },
    "checkout_audience": {
      "env": ["BILLING_CHECKOUT_AUDIENCE"],
      "type": "str",
      "default": "allow_list"
    },
    "contact_sales_url": {
      "env": ["BILLING_CONTACT_SALES_URL"],
      "type": "str",
      "default": "https://www.cube27.com/contact/"
    },
    "funded_monthly_budget_minor": {
      "env": ["BILLING_FUNDED_MONTHLY_BUDGET_MINOR"],
      "type": "int",
      "default": 50000
    },
    "trial_days": {
      "env": ["BILLING_TRIAL_DAYS"],
      "type": "int",
      "default": 7
    },
    "trial_data_retention_days": {
      "env": ["BILLING_TRIAL_DATA_RETENTION_DAYS"],
      "type": "int",
      "default": 30,
      "minimum": 1
    },
    "trial_purge_workspace_batch": {
      "env": ["BILLING_TRIAL_PURGE_WORKSPACE_BATCH"],
      "type": "int",
      "default": 5,
      "minimum": 1
    },
    "quote_validity_minutes": {
      "env": ["BILLING_QUOTE_VALIDITY_MINUTES"],
      "type": "int",
      "default": 60
    },
    "quote_signing_secret": {
      "env": ["BILLING_QUOTE_SIGNING_SECRET"],
      "type": "str",
      "default": ""
    },
    "reconciliation_batch_size": {
      "env": ["BILLING_RECONCILIATION_BATCH_SIZE"],
      "type": "int",
      "default": 50
    },
    "reconciliation_stale_after_seconds": {
      "env": ["BILLING_RECONCILIATION_STALE_AFTER_SECONDS"],
      "type": "int",
      "default": 300
    },
    "reconciliation_abandon_after_seconds": {
      "env": ["BILLING_RECONCILIATION_ABANDON_AFTER_SECONDS"],
      "type": "int",
      "default": 86400
    },
    "cancellation_send_lead_seconds": {
      "env": ["BILLING_CANCELLATION_SEND_LEAD_SECONDS"],
      "type": "int",
      "default": 172800,
      "minimum": 3600,
      "maximum": 604800
    },
    "reconciliation_clock_skew_seconds": {
      "env": ["BILLING_RECONCILIATION_CLOCK_SKEW_SECONDS"],
      "type": "int",
      "default": 300,
      "minimum": 0,
      "maximum": 3600
    },
    "reconciliation_list_count": {
      "env": ["BILLING_RECONCILIATION_LIST_COUNT"],
      "type": "int",
      "default": 100,
      "minimum": 1,
      "maximum": 100
    },
    "reconciliation_max_pages": {
      "env": ["BILLING_RECONCILIATION_MAX_PAGES"],
      "type": "int",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    },
    "reconciliation_lease_seconds": {
      "env": ["BILLING_RECONCILIATION_LEASE_SECONDS"],
      "type": "int",
      "default": 120
    },
    "reconciliation_max_attempts": {
      "env": ["BILLING_RECONCILIATION_MAX_ATTEMPTS"],
      "type": "int",
      "default": 8
    },
    "reconciliation_backoff_base_seconds": {
      "env": ["BILLING_RECONCILIATION_BACKOFF_BASE_SECONDS"],
      "type": "int",
      "default": 60
    },
    "webhook_lease_seconds": {
      "env": ["BILLING_WEBHOOK_LEASE_SECONDS"],
      "type": "int",
      "default": 120
    },
    "webhook_max_attempts": {
      "env": ["BILLING_WEBHOOK_MAX_ATTEMPTS"],
      "type": "int",
      "default": 8
    },
    "subscription_total_cycles": {
      "env": ["BILLING_SUBSCRIPTION_TOTAL_CYCLES"],
      "type": "int",
      "default": 1200,
      "minimum": 12,
      "maximum": 1200
    },
    "plan_change_minimum_charge_minor": {
      "env": ["BILLING_PLAN_CHANGE_MINIMUM_CHARGE_MINOR"],
      "type": "int",
      "default": 100,
      "minimum": 100
    },
    "max_webhook_body_bytes": {
      "env": ["BILLING_MAX_WEBHOOK_BODY_BYTES"],
      "type": "int",
      "default": 262144
    }
  },
  "razorpay_settings": {
    "mode": {
      "env": ["BILLING_RAZORPAY_MODE"],
      "type": "literal",
      "values": ["disabled", "test", "live"],
      "default": "disabled"
    },
    "key_id": {
      "env": ["BILLING_RAZORPAY_KEY_ID"],
      "type": "str",
      "default": ""
    },
    "key_secret": {
      "env": ["BILLING_RAZORPAY_KEY_SECRET"],
      "type": "str",
      "default": ""
    },
    "api_base_url": {
      "env": ["BILLING_RAZORPAY_API_BASE_URL"],
      "type": "str",
      "default": "https://api.razorpay.com/v1"
    },
    "deployment_env": {
      "env": ["APP_ENV"],
      "type": "str",
      "default": "development"
    },
    "test_key_id_alias": {
      "env": ["RAZORPAY_TEST_KEY_ID"],
      "type": "str",
      "default": ""
    },
    "test_key_secret_alias": {
      "env": ["RAZORPAY_TEST_KEY_SECRET"],
      "type": "str",
      "default": ""
    },
    "test_ready": {
      "env": ["BILLING_RAZORPAY_TEST_READY"],
      "type": "bool",
      "default": false
    },
    "test_international_ready": {
      "env": ["BILLING_RAZORPAY_TEST_INTERNATIONAL_READY"],
      "type": "bool",
      "default": false
    },
    "test_india_ready": {
      "env": ["BILLING_RAZORPAY_TEST_INDIA_READY"],
      "type": "bool",
      "default": false
    },
    "live_ready": {
      "env": ["BILLING_RAZORPAY_LIVE_READY"],
      "type": "bool",
      "default": false
    },
    "international_ready": {
      "env": ["BILLING_RAZORPAY_INTERNATIONAL_READY"],
      "type": "bool",
      "default": false
    },
    "webhook_secret": {
      "env": ["BILLING_RAZORPAY_WEBHOOK_SECRET"],
      "type": "str",
      "default": ""
    },
    "webhook_previous_secret": {
      "env": ["BILLING_RAZORPAY_WEBHOOK_PREVIOUS_SECRET"],
      "type": "str",
      "default": ""
    },
    "webhook_previous_secret_expires_at": {
      "env": ["BILLING_RAZORPAY_WEBHOOK_PREVIOUS_SECRET_EXPIRES_AT"],
      "type": "datetime",
      "nullable": true,
      "default": null
    },
    "webhook_previous_secret_started_at": {
      "env": ["BILLING_RAZORPAY_WEBHOOK_PREVIOUS_SECRET_STARTED_AT"],
      "type": "datetime",
      "nullable": true,
      "default": null
    }
  },
  "contracts": {
    "subscription_trialing": "trialing",
    "subscription_active": "active",
    "subscription_past_due": "past_due",
    "subscription_cancel_scheduled": "cancel_scheduled",
    "subscription_cancelled": "cancelled",
    "subscription_unpaid": "unpaid",
    "subscription_expired": "expired",
    "razorpay_event_types": [
      "subscription.activated",
      "subscription.authenticated",
      "subscription.cancelled",
      "subscription.charged",
      "subscription.completed",
      "subscription.expired",
      "subscription.halted",
      "subscription.paused",
      "subscription.pending",
      "subscription.resumed"
    ],
    "payment_pending": "payment_pending",
    "payment_paid": "paid",
    "payment_failed": "payment_failed",
    "plan_bundle_priority": 200,
    "upgrade_bundle_priority": 210,
    "idempotency_key_min_length": 8,
    "idempotency_key_max_length": 255,
    "telemetry_entitlement_unresolved": "billing.entitlement_unresolved",
    "telemetry_funded_budget_exhausted": "billing.funded_budget_exhausted",
    "subscription_pending": "pending"
  },
  "razorpay_origin": "https://api.razorpay.com/v1"
}
