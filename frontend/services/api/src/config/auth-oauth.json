{
  "settings": {
    "google_client_id": {
      "env": ["OAUTH_GOOGLE_CLIENT_ID"],
      "type": "str",
      "default": ""
    },
    "google_client_secret": {
      "env": ["OAUTH_GOOGLE_CLIENT_SECRET"],
      "type": "str",
      "default": ""
    },
    "google_redirect_uri": {
      "env": ["OAUTH_GOOGLE_REDIRECT_URI"],
      "type": "str",
      "default": ""
    },
    "google_enabled": {
      "env": ["OAUTH_GOOGLE_ENABLED"],
      "type": "bool",
      "default": false
    },
    "github_client_id": {
      "env": ["OAUTH_GITHUB_CLIENT_ID"],
      "type": "str",
      "default": ""
    },
    "github_client_secret": {
      "env": ["OAUTH_GITHUB_CLIENT_SECRET"],
      "type": "str",
      "default": ""
    },
    "github_redirect_uri": {
      "env": ["OAUTH_GITHUB_REDIRECT_URI"],
      "type": "str",
      "default": ""
    },
    "github_enabled": {
      "env": ["OAUTH_GITHUB_ENABLED"],
      "type": "bool",
      "default": false
    },
    "apple_client_id": {
      "env": ["OAUTH_APPLE_CLIENT_ID"],
      "type": "str",
      "default": ""
    },
    "apple_client_secret": {
      "env": ["OAUTH_APPLE_CLIENT_SECRET"],
      "type": "str",
      "default": ""
    },
    "apple_redirect_uri": {
      "env": ["OAUTH_APPLE_REDIRECT_URI"],
      "type": "str",
      "default": ""
    },
    "apple_enabled": {
      "env": ["OAUTH_APPLE_ENABLED"],
      "type": "bool",
      "default": false
    },
    "state_ttl_seconds": {
      "env": ["OAUTH_STATE_TTL_SECONDS"],
      "type": "int",
      "default": 600
    }
  },
  "labels": {
    "google": "Google",
    "github": "GitHub",
    "apple": "Apple"
  },
  "authorize_urls": {
    "google": "https://accounts.google.com/o/oauth2/v2/auth",
    "github": "https://github.com/login/oauth/authorize",
    "apple": "https://appleid.apple.com/auth/authorize"
  },
  "token_urls": {
    "google": "https://oauth2.googleapis.com/token",
    "github": "https://github.com/login/oauth/access_token",
    "apple": "https://appleid.apple.com/auth/token"
  },
  "userinfo_urls": {
    "google": "https://openidconnect.googleapis.com/v1/userinfo"
  },
  "scopes": {
    "google": "openid email profile",
    "github": "read:user user:email",
    "apple": "name email"
  },
  "implemented": ["google"],
  "approved_hosts": [
    "accounts.google.com",
    "oauth2.googleapis.com",
    "openidconnect.googleapis.com"
  ],
  "cookie_name": "citeladder_auth_oauth",
  "cookie_path": "/api/v1/auth/oauth",
  "callback_path": "/api/v1/auth/oauth/{provider}/callback",
  "landing_path": "/projects",
  "error_path": "/login",
  "timeout_seconds": 15.0,
  "response_max_bytes": 65536
}
