{
  "name": "citeladder-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "dev": "astro dev --root apps/marketing --host 0.0.0.0 -p 3000",
    "build": "astro build --root apps/marketing",
    "start": "node apps/marketing/dist/server/entry.mjs",
    "preview:marketing": "astro preview --root apps/marketing --host 0.0.0.0 -p 3000",
    "dev:vite": "vp dev -c apps/app/vite.config.ts",
    "build:vite": "vp build -c apps/app/vite.config.ts",
    "preview:vite": "vp preview -c apps/app/vite.config.ts",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "check:complexity": "node scripts/check-frontend-complexity.mjs",
    "check:duplicates": "node scripts/check-jscpd.mjs",
    "report:duplicates:tests": "node scripts/check-jscpd.mjs --tests",
    "check:policy": "node scripts/check-design-system.mjs && node scripts/check-frontend-architecture.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:dead-code": "knip",
    "quality:fix": "node ../scripts/quality.mjs --mode fix",
    "quality:check": "node ../scripts/quality.mjs --mode check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "driver.js": "^1.8.0",
    "lucide-react": "^1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "catalog:",
    "jscpd": "5.2.1",
    "jsdom": "^30.0.1",
    "knip": "6.35.1",
    "msw": "^2.15.0",
    "oxc-parser": "^0.150.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "samsung >= 23",
    "not dead"
  ]
}
