{
  "name": "citeladder-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "scripts": {
    "dev:docs": "node scripts/prepare-docs-assets.mjs && astro dev --root apps/docs",
    "build:docs": "node scripts/prepare-docs-assets.mjs && astro build --root apps/docs",
    "preview:docs": "wrangler dev -c apps/docs/wrangler.jsonc --local --ip 127.0.0.1 --port 4322",
    "deploy:docs": "wrangler deploy -c apps/docs/wrangler.jsonc",
    "test:docs": "pnpm build:docs && playwright test --config playwright.docs.config.ts",
    "dev": "node scripts/dev-marketing-worker.mjs",
    "build": "astro build --root apps/marketing",
    "start": "node scripts/dev-marketing-worker.mjs",
    "preview:marketing": "astro preview --root apps/marketing --host 0.0.0.0 -p 3000",
    "build:marketing": "pnpm build && node scripts/check-marketing-worker-output.mjs",
    "dev:marketing-worker": "node scripts/dev-marketing-worker.mjs",
    "types:marketing-worker": "wrangler types -c apps/marketing/wrangler.jsonc --no-include-runtime apps/marketing/worker-configuration.d.ts && node scripts/scope-worker-types.mjs marketing && vp fmt --write apps/marketing/worker-configuration.d.ts",
    "deploy:marketing": "node scripts/check-marketing-worker-target.mjs && wrangler deploy -c apps/marketing/dist/server/wrangler.json",
    "dev:vite": "vp dev -c apps/app/vite.config.ts",
    "build:vite": "vp build -c apps/app/vite.config.ts",
    "build:app": "pnpm build:vite && node scripts/check-app-worker-output.mjs",
    "fonts:pull": "node scripts/pull-licensed-fonts.mjs",
    "dev:app-worker": "wrangler dev -c apps/app/wrangler.jsonc --local",
    "types:app-worker": "wrangler types -c apps/app/wrangler.jsonc --no-include-runtime apps/app/worker-configuration.d.ts && node scripts/scope-worker-types.mjs && vp fmt --write apps/app/worker-configuration.d.ts",
    "deploy:app": "wrangler deploy -c apps/app/wrangler.jsonc",
    "deploy:api-host": "wrangler deploy -c apps/api-host/wrangler.jsonc",
    "preview:vite": "vp preview -c apps/app/vite.config.ts",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "gen": "pnpm --filter @citeladder/api public-api:reference && pnpm --filter @citeladder/api mcp:reference && vp fmt apps/docs/src/data/public-api.json apps/docs/src/data/mcp-tools.json",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:api": "pnpm --filter @citeladder/api test:local",
    "test:workers": "playwright test --config playwright.workers.config.ts",
    "check:complexity": "node scripts/check-frontend-complexity.mjs",
    "check:duplicates": "node scripts/check-jscpd.mjs",
    "report:duplicates:tests": "node scripts/check-jscpd.mjs --tests",
    "check:policy": "node scripts/check-design-system.mjs && node scripts/check-frontend-architecture.mjs",
    "check:contract": "pnpm --filter @citeladder/api check:routes",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:dead-code": "knip",
    "quality:fix": "node ../scripts/quality.mjs --mode fix",
    "quality:check": "node ../scripts/quality.mjs --mode check",
    "gate": "node ../scripts/quality.mjs --mode fix --scope changed --builds affected"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "^7.1.0",
    "@citeladder/contracts": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.3",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.33.0",
    "robots-parser": "3.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "jscpd": "5.4.1",
    "jsdom": "^30.1.3",
    "knip": "6.41.0",
    "msw": "^2.15.0",
    "oxc-parser": "^0.154.0",
    "postcss": "^8.5.30",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=26"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "samsung >= 23",
    "not dead"
  ]
}
