---
---

<style is:global>
  :root {
    --code-copy-min: 88px;
  }
  .cl-code {
    margin: 0;
    overflow: hidden;
    background: var(--color-well);
    border-radius: var(--radius-control);
  }
  .cl-code-bar {
    display: flex;
    align-items: center;
    gap: var(--site-space-3);
    height: var(--spacing-control-md);
    padding: 0 var(--site-space-1) 0 var(--site-space-4);
    border-bottom: var(--site-rule) solid var(--color-rule);
  }
  .cl-code-lang {
    color: var(--text-color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: var(--text-eyebrow--line-height);
    font-weight: var(--weight-regular);
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
  }
  .cl-code-status {
    margin-left: auto;
    color: var(--text-color-ink-2);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
  }
  .cl-code-status[data-failed] {
    color: var(--color-negative);
  }
  .cl-code-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--site-space-1);
    min-width: var(--code-copy-min);
    height: var(--spacing-control-sm);
    padding: 0 var(--site-space-2);
    border: 0;
    border-radius: var(--radius-inner);
    background: transparent;
    color: var(--text-color-ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: var(--weight-medium);
    transition:
      background-color var(--transition-duration-fast) var(--ease-standard),
      color var(--transition-duration-fast) var(--ease-standard);
  }
  @media (hover: hover) and (pointer: fine) {
    .cl-code-copy:hover {
      background: var(--color-panel);
      color: var(--text-color-ink);
    }
  }
  @media (pointer: coarse) {
    .cl-code-bar,
    .cl-code-copy {
      height: var(--site-target);
    }
  }
  .cl-code-copy .cl-code-icon-check,
  .cl-code-copy[data-copied] .cl-code-icon-copy {
    display: none;
  }
  .cl-code-copy[data-copied] .cl-code-icon-check {
    display: block;
  }
  .cl-code-pre {
    margin: 0;
    padding: var(--site-space-4) var(--site-space-5);
    overflow-x: auto;
    color: var(--text-color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: var(--text-code--line-height);
    tab-size: 2;
  }
  .cl-code-pre code {
    font-family: inherit;
  }
  .cl-code-muted {
    color: var(--text-color-ink-2);
  }
  @media print {
    .cl-code-status,
    .cl-code-copy {
      display: none;
    }
    .cl-code-pre {
      overflow: visible;
      white-space: pre-wrap;
    }
  }
</style>

<script>
  import { installCodeCopy } from './code-copy';
  installCodeCopy();
</script>
