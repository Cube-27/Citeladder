---
import CodeBlock from './CodeBlock.astro';
import './prose.css';

interface Props {
  variant?: 'article' | 'docs';
  as?: 'div' | 'article' | 'section';
  label?: string;
}
const { variant = 'article', as: Tag = 'div', label } = Astro.props;
---

<Tag
  class:list={['cl-prose', { 'cl-prose--docs': variant === 'docs' }]}
  aria-label={Tag === 'div' ? undefined : label}
>
  <slot />
</Tag>
<CodeBlock />
