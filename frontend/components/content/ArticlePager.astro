---
import { ChevronLeft, ChevronRight } from '@/lib/icons';

type Link = { title: string; href: string };
interface Props {
  previous?: Link;
  next?: Link;
  label?: string;
}
const { previous, next, label = 'Adjacent articles' } = Astro.props;
---

<nav class="cl-pager" aria-label={label}>
  {
    previous && (
      <a class="cl-pager-link" href={previous.href} rel="prev">
        <span class="cl-pager-dir">
          <ChevronLeft className="size-4" aria-hidden />
          Previous
        </span>
        <span class="cl-pager-title">{previous.title}</span>
      </a>
    )
  }
  {
    next && (
      <a class="cl-pager-link cl-pager-link--next" href={next.href} rel="next">
        <span class="cl-pager-dir">
          Next
          <ChevronRight className="size-4" aria-hidden />
        </span>
        <span class="cl-pager-title">{next.title}</span>
      </a>
    )
  }
</nav>

<style>
  .cl-pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 48px;
    max-width: var(--container-prose);
    border-top: 1px solid var(--color-rule);
  }
  .cl-pager-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 24px 0;
    text-decoration: none;
  }
  .cl-pager-dir :global(svg) {
    transition: transform var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-pager-link:hover .cl-pager-dir :global(svg) {
    transform: translateX(-4px);
  }
  .cl-pager-link--next:hover .cl-pager-dir :global(svg) {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-pager-link:hover .cl-pager-dir :global(svg) {
      transform: none;
    }
  }
  .cl-pager-link--next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }
  .cl-pager-dir {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-pager-title {
    color: var(--text-color-ink);
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    font-weight: 500;
    text-wrap: balance;
  }
  .cl-pager-link:hover .cl-pager-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 767px) {
    .cl-pager {
      grid-template-columns: minmax(0, 1fr);
    }
    .cl-pager-link--next {
      grid-column: auto;
    }
    .cl-pager-link + .cl-pager-link {
      border-top: 1px solid var(--color-rule);
    }
  }
</style>
