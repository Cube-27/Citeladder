---
import { ChevronDown } from '@/lib/icons';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<details class="cl-jump" data-jump>
  <summary class="cl-jump-summary focus-ring">
    <span class="cl-jump-label">{label}</span>
    <ChevronDown className="cl-jump-caret size-4" aria-hidden />
  </summary>
  <div class="cl-jump-panel">
    <slot />
  </div>
</details>

<style>
  :root {
    --jump-menu-min: 280px;
    --jump-menu-max-height: 480px;
  }
  .cl-jump {
    position: relative;
    min-width: 0;
  }
  .cl-jump-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--site-space-3);
    height: var(--spacing-control-lg);
    padding: 0 var(--site-space-4);
    background: var(--color-panel);
    border: var(--site-rule) solid var(--color-control-line);
    border-radius: var(--radius-control);
    color: var(--text-color-ink);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: var(--weight-medium);
    list-style: none;
    transition: background-color var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-jump-summary::-webkit-details-marker {
    display: none;
  }
  .cl-jump-summary:hover {
    background: var(--color-well);
  }
  .cl-jump-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cl-jump :global(.cl-jump-caret) {
    color: var(--text-color-ink-2);
    transition: transform var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-jump[open] :global(.cl-jump-caret) {
    transform: rotate(180deg);
  }
  .cl-jump-panel {
    position: absolute;
    z-index: var(--z-index-sticky);
    top: calc(100% + var(--site-space-2));
    left: 0;
    width: max(100%, var(--jump-menu-min));
    max-width: calc(100vw - var(--site-space-10));
    max-height: min(60vh, var(--jump-menu-max-height));
    overflow: auto;
    padding: var(--site-space-3) var(--site-space-3) var(--site-space-3) var(--site-space-2);
    background: var(--color-panel);
    border: var(--site-rule) solid var(--color-rule);
    border-radius: var(--site-radius-inner, var(--radius-card));
    opacity: 0;
    translate: 0 var(--cl-jump-shift, calc(-1 * var(--site-space-1)));
    transition:
      opacity var(--transition-duration-close) var(--ease-standard),
      translate var(--transition-duration-close) var(--ease-standard);
  }
  .cl-jump::details-content {
    transition: content-visibility var(--transition-duration-close) allow-discrete;
  }
  .cl-jump[open]::details-content {
    transition-duration: var(--transition-duration-open);
  }
  .cl-jump[open] .cl-jump-panel {
    opacity: 1;
    translate: 0;
    transition-duration: var(--transition-duration-open);
    transition-timing-function: var(--ease-standard);
    @starting-style {
      opacity: 0;
      translate: 0 var(--cl-jump-shift, calc(-1 * var(--site-space-1)));
    }
  }
  .cl-jump + .cl-jump .cl-jump-panel {
    right: 0;
    left: auto;
  }
  .cl-jump-panel :global(.cl-toc > .cl-kicker) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-jump :global(.cl-jump-caret) {
      transition: none;
    }
    .cl-jump {
      --cl-jump-shift: 0;
    }
  }
</style>

<script>
  for (const jump of document.querySelectorAll<HTMLDetailsElement>('[data-jump]')) {
    jump.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('.cl-jump-panel a'))
        jump.open = false;
    });
    document.addEventListener('pointerdown', (event) => {
      if (jump.open && event.target instanceof Node && !jump.contains(event.target))
        jump.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !jump.open) return;
      jump.open = false;
      jump.querySelector('summary')?.focus();
    });
  }
</script>
