---
import { Tag } from '@/components/ui/tag';

type ArticleMeta =Readonly<{
  text: string;
  dateTime?: string;
  prefix?: string;
}>;

interface Props {
  title: string;
  eyebrow?: string;
  tags?: readonly string[];
  author?: Readonly<{ name: string; role?: string }>;
  meta?: readonly ArticleMeta[];
}
const { title, eyebrow, tags = [], author, meta = [] } = Astro.props;
const initials = author?.name
  .split(/\s+/)
  .filter(Boolean)
  .map((word) => word.charAt(0))
  .filter((_, index, letters) => index === 0 || index === letters.length - 1)
  .join('')
  .toUpperCase();
---

<header class="cl-ahead">
  <slot name="crumbs" />
  {eyebrow && <p class="text-kicker text-ink-2">{eyebrow}</p>}
  {
    tags.length > 0 && (
      <ul class="cl-ahead-tags" aria-label="Topics">
        {tags.slice(0, 3).map((tag) => (
          <li>
            <Tag>{tag}</Tag>
          </li>
        ))}
      </ul>
    )
  }
  <h1 class="cl-ahead-title">{title}</h1>
  {Astro.slots.has('default') && <p class="cl-ahead-lead"><slot /></p>}
  {
    (author || meta.length > 0) && (
      <div class="cl-ahead-byline">
        {author && (
          <div class="cl-byline">
            <span class="cl-ahead-avatar" aria-hidden="true">
              {initials}
            </span>
            <p>
              <span class="cl-byline-name">{author.name}</span>
              {author.role && <span class="cl-byline-role">{author.role}</span>}
            </p>
          </div>
        )}
        {meta.length > 0 && (
          <p class="cl-ahead-meta">
            {meta.map((item, index) => (
              <span>
                {index > 0 && <span aria-hidden="true">·</span>}
                {item.prefix && `${item.prefix} `}
                {item.dateTime ? <time datetime={item.dateTime}>{item.text}</time> : item.text}
              </span>
            ))}
          </p>
        )}
      </div>
    )
  }
  <slot name="note" />
</header>

<style>
  .cl-ahead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: var(--container-prose);
  }
  .cl-ahead :global(.cl-crumbs) {
    margin-bottom: 12px;
  }
  .cl-ahead-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cl-ahead-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-site-title, var(--text-display-lg));
    line-height: var(--text-site-title--line-height, var(--text-display-lg--line-height));
    letter-spacing: -0.01em;
    font-weight: 400;
    color: var(--text-color-ink);
    text-wrap: balance;
  }
  .cl-ahead-lead {
    margin: 0;
    color: var(--text-color-ink-2);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  :global([data-marketing-surface]) .cl-ahead-lead {
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
  }
  .cl-ahead-lead :global(a) {
    color: var(--text-color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-control-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .cl-ahead-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    width: 100%;
    margin-top: 4px;
  }
  .cl-byline {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cl-byline p {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .cl-ahead-avatar {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--color-mark-ink);
    color: var(--text-color-on-ink);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    font-weight: 500;
  }
  .cl-byline-name {
    color: var(--text-color-ink);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 400;
  }
  .cl-byline-role {
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-ahead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-ahead-meta > span {
    display: inline-flex;
    gap: 8px;
  }
  @media (max-width: 767px) {
    .cl-ahead-title {
      font-size: var(--text-site-title, var(--text-display-md));
      line-height: var(--text-site-title--line-height, var(--text-display-md--line-height));
    }
    .cl-ahead-lead {
      font-size: var(--text-body-lg);
      line-height: var(--text-body-lg--line-height);
    }
  }
</style>
