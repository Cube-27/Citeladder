---
import JumpMenu from './JumpMenu.astro';
import Toc, { type TocItem } from './Toc.astro';

type DocNavItem =Readonly<{ label: string; href: string; current?: boolean }>;

interface Props {
  toc: readonly TocItem[];
  nav?: readonly DocNavItem[];
  navLabel?: string;
  navSummary?: string;
}
const { toc, nav, navLabel = 'Pages', navSummary = navLabel } = Astro.props;
const hasToc = toc.length > 0;
const hasBar = hasToc || nav !== undefined;
---

<div class:list={['cl-doc', { 'cl-doc--toc': hasToc }]}>
  <aside class="cl-doc-rail">
    {
      nav ? (
        <nav aria-label={navLabel}>
          <ul class="cl-doc-list">
            {nav.map((item) => (
              <li>
                <a
                  class:list={['cl-doc-link focus-ring', { 'is-active': item.current }]}
                  href={item.href}
                  aria-current={item.current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <slot name="rail" />
      )
    }
  </aside>
  <main id="main" class="cl-doc-main" tabindex="-1">
    <slot name="header" />
    {
      hasBar && (
        <div class:list={['cl-doc-bar', { 'cl-doc-bar--nav': nav, 'cl-doc-bar--toc': hasToc }]}>
          {nav && (
            <div class="cl-doc-bar-nav">
              <JumpMenu label={navSummary}>
                <ul class="cl-doc-list">
                  {nav.map((item) => (
                    <li>
                      <a
                        class:list={['cl-doc-link focus-ring', { 'is-active': item.current }]}
                        href={item.href}
                        aria-current={item.current ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </JumpMenu>
            </div>
          )}
          {hasToc && (
            <div class="cl-doc-bar-toc">
              <JumpMenu label="On this page">
                <Toc items={toc} />
              </JumpMenu>
            </div>
          )}
        </div>
      )
    }
    <slot />
  </main>
  {
    hasToc && (
      <aside class="cl-doc-toc" data-toc-scroll>
        <Toc items={toc} />
        <slot name="toc-end" />
      </aside>
    )
  }
</div>

<style is:global>
  .cl-doc {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .cl-doc--toc {
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr) 232px;
  }
  .cl-doc-rail,
  .cl-doc-toc {
    position: sticky;
    top: calc(var(--nav-height) + 40px);
  }
  .cl-doc-rail {
    max-height: calc(100vh - var(--nav-height) - 64px);
    margin: 0 -4px;
    padding: 0 4px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-rule) transparent;
  }
  .cl-doc-toc {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-height: calc(100vh - var(--nav-height) - 64px);
    margin: 0 -4px;
    padding: 0 4px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-rule) transparent;
  }
  .cl-doc-main {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-width: 0;
  }
  .cl-doc-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cl-doc-link {
    display: flex;
    align-items: center;
    min-height: var(--control-md);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    text-decoration: none;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }
  .cl-doc-link:hover,
  .cl-doc-link.is-active {
    background: var(--color-well);
    color: var(--text-color-ink);
  }
  .cl-doc-link.is-active {
    font-weight: 500;
  }
  .cl-doc-bar {
    display: none;
    gap: 12px;
    max-width: var(--container-prose);
  }
  .cl-doc-bar-nav {
    display: none;
  }
  @media (max-width: 1199px) {
    .cl-doc,
    .cl-doc--toc {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
    .cl-doc-toc {
      display: none;
    }
    .cl-doc-bar--toc {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cl-doc-bar-toc {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 899px) {
    .cl-doc,
    .cl-doc--toc {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .cl-doc-rail {
      display: none;
    }
    .cl-doc-bar--nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cl-doc-bar-nav {
      display: block;
    }
    .cl-doc-bar--nav .cl-doc-bar-toc {
      grid-column: auto;
    }
  }
  @media (max-width: 639px) {
    .cl-doc-bar {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media print {
    .cl-doc,
    .cl-doc--toc {
      display: block;
    }
    .cl-doc-rail,
    .cl-doc-toc,
    .cl-doc-bar {
      display: none;
    }
  }
</style>
