---
export type TocItem = Readonly<{ id: string; label: string; level: number }>;

interface Props {
  items: readonly TocItem[];
  title?: string;
}
const { items, title = 'On this page' } = Astro.props;
const unbroken = (label: string) =>
  label.replace(/(?<=\p{L}|\p{N})-(?=\p{L}|\p{N})/gu, '\u2060-\u2060');
---

<nav class="cl-toc" aria-label={title}>
  <p class="cl-kicker">{title}</p>
  <ol class="cl-toc-list">
    {
      items.map((item) => (
        <li>
          <a
            class:list={['cl-toc-link focus-ring-inset', { 'cl-toc-link--sub': item.level === 3 }]}
            href={`#${item.id}`}
          >
            {unbroken(item.label)}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .cl-toc {
    display: flex;
    flex-direction: column;
    gap: var(--site-space-3);
  }
  .cl-toc-list {
    padding: 0;
    list-style: none;
    border-left: var(--site-rule) solid var(--color-rule);
  }
  .cl-toc-link {
    position: relative;
    display: block;
    padding: var(--site-space-1) var(--site-space-4);
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    text-decoration: none;
    transition: color var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-toc-link--sub {
    padding-left: var(--site-space-8);
  }
  .cl-toc-link[aria-current='location'] {
    color: var(--text-color-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .cl-toc-link:hover {
      color: var(--text-color-ink);
    }
  }  .cl-toc-link[aria-current='location']::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-1 * var(--site-rule));
    width: var(--site-space-0_5);
    background: var(--color-mark-ink);
  }
</style>

<script>
  import { mountTocSpy } from './toc-spy';
  mountTocSpy();
</script>
