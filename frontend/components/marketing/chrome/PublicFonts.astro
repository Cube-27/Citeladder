<!-- Discover the faces at first paint instead of after the stylesheet
    loads. Switzer and Sentient are not in this repository: `pnpm fonts:pull`
    copies them into public/fonts from the private Cube27 font repo, and
    delivery does the same. A build without them renders in the fallbacks
    below. -->
<link
  rel="preload"
  href="/fonts/Switzer-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/Sentient-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<style is:inline>
  /* `font-display: fallback`: a ~100ms block period, then a ~3s window in
     which the font may still swap in, then a permanent commit to the
     fallback.

     Not `optional`: it commits after the block period alone and will NOT
     swap afterwards even when the font arrives moments later. A hard
     reload (Ctrl+Shift+R) bypasses the cache, so the file has to come
     off the network inside ~100ms and usually loses — the typeface then
     never renders, however long you wait.

     Not `swap` either, whose swap period is unbounded: on a bad
     connection it re-lays out the page whenever the font finally lands,
     long after the reader started reading. `fallback` bounds that to ~3s
     — enough for a preloaded, same-origin file on any connection that
     was going to succeed at all. */
  /* 500 is the design ceiling: a heavier request, including the browser's
     own bold for strong, b and th, clamps to it, and `font-synthesis-weight:
     none` below stops a faux bold on top. */
  @font-face {
    font-family: 'Switzer Variable';
    src: url('/fonts/Switzer-Variable.woff2') format('woff2');
    font-weight: 300 500;
    font-style: normal;
    font-display: fallback;
  }

  @font-face {
    font-family: 'Sentient Variable';
    src: url('/fonts/Sentient-Variable.woff2') format('woff2');
    font-weight: 300 500;
    font-style: normal;
    font-display: fallback;
  }

  /* Match Arial's x-height to Switzer's (0.531em vs 0.519em). Vertical
     overrides use Switzer's 980/-250/90 hhea metrics (1000 UPM), divided
     by size-adjust. */
  @font-face {
    font-family: 'Switzer Fallback';
    src: local('Arial');
    font-weight: 100 500;
    size-adjust: 102.31%;
    ascent-override: 95.79%;
    descent-override: 24.44%;
    line-gap-override: 8.80%;
  }

  /* Match Georgia's x-height to Sentient's (0.504em vs 0.481em). Vertical
     overrides use Sentient's 960/-320/80 hhea metrics (1000 UPM), divided
     by size-adjust. */
  @font-face {
    font-family: 'Sentient Fallback';
    src: local('Georgia');
    font-weight: 100 500;
    size-adjust: 104.78%;
    ascent-override: 91.62%;
    descent-override: 30.54%;
    line-gap-override: 7.63%;
  }

  :root {
    font-synthesis-weight: none;
    /* Switzer carries body, UI and data; Sentient carries display headings. */
    --font-text: 'Switzer Variable', 'Switzer Fallback', Arial;
    --font-heading: 'Sentient Variable', 'Sentient Fallback', Georgia;
  }
</style>
