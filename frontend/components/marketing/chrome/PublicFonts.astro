<!-- Discover the faces at first paint instead of after the stylesheet
    loads. Geist and Outfit are not in this repository: `pnpm fonts:pull`
    copies them into public/fonts from the private Cube27 font repo, and
    delivery does the same. A build without them renders in the fallbacks
    below. -->
<link
  rel="preload"
  href="/fonts/Geist-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/Outfit-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<style is:inline>
  /* `font-display: fallback`: a ~100ms block period, then a ~3s window in
     which the font may still swap in, then a permanent commit to the
     fallback.

     Not `optional`: it commits after the block period alone and will NOT
     swap afterwards even when the font arrives moments later. A hard
     reload (Ctrl+Shift+R) bypasses the cache, so the file has to come
     off the network inside ~100ms and usually loses — the typeface then
     never renders, however long you wait.

     Not `swap` either, whose swap period is unbounded: on a bad
     connection it re-lays out the page whenever the font finally lands,
     long after the reader started reading. `fallback` bounds that to ~3s
     — enough for a preloaded, same-origin file on any connection that
     was going to succeed at all. */
  /* 500 is the display ceiling and 600 the text one, kept for the card and
     feature title role alone (strong, b and th are set to 500 in globals.css):
     a heavier request clamps to the ceiling, and `font-synthesis-weight:
     none` below stops a faux bold on top. */
  @font-face {
    font-family: 'Geist Variable';
    src: url('/fonts/Geist-Variable.woff2') format('woff2');
    font-weight: 300 600;
    font-style: normal;
    font-display: fallback;
  }

  @font-face {
    font-family: 'Outfit Variable';
    src: url('/fonts/Outfit-Variable.woff2') format('woff2');
    font-weight: 300 500;
    font-style: normal;
    font-display: fallback;
  }

  /* Match Arial's x-height to Geist's (0.530em vs 0.519em). Vertical
     overrides use Geist's 1005/-295/0 hhea metrics (1000 UPM), divided by
     size-adjust. */
  @font-face {
    font-family: 'Geist Fallback';
    src: local('Arial');
    font-weight: 100 600;
    size-adjust: 102.12%;
    ascent-override: 98.41%;
    descent-override: 28.89%;
    line-gap-override: 0%;
  }

  /* Match Arial's x-height to Outfit's (0.460em vs 0.519em). Vertical
     overrides use Outfit's 1000/-260/0 hhea metrics (1000 UPM), divided by
     size-adjust. */
  @font-face {
    font-family: 'Outfit Fallback';
    src: local('Arial');
    font-weight: 100 500;
    size-adjust: 88.63%;
    ascent-override: 112.83%;
    descent-override: 29.33%;
    line-gap-override: 0%;
  }

  :root {
    font-synthesis-weight: none;
    /* Geist carries body, UI and data (its tabular figures line up columns);
       Outfit carries display headings. */
    --font-text: 'Geist Variable', 'Geist Fallback', Arial;
    --font-heading: 'Outfit Variable', 'Outfit Fallback', Arial;
  }
</style>
