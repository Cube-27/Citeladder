---
// The brand faces' preloads and @font-face rules, written from
// lib/config/brand-fonts.json. The files are not in this repository:
// `pnpm fonts:pull` copies them into public/fonts from the private Cube27 font
// repo, and delivery does the same. A build without them renders in the
// metric-matched fallbacks. The mono face is not preloaded here: few public
// pages set code or data, and it loads only where one does.
import { brandFontHead } from '@/lib/fonts/brand-fonts';
---

<Fragment set:html={brandFontHead('public')} />
