<!-- Discover the face at first paint instead of after the stylesheet
    loads. Geist is not in this repository: `pnpm fonts:pull` copies it into
    public/fonts from the private Cube27 font repo, and delivery does the
    same. A build without it renders in the fallback below. -->
<link
  rel="preload"
  href="/fonts/Geist-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<style is:inline>
  /* `font-display: fallback`: a ~100ms block period, then a ~3s window in
     which the font may still swap in, then a permanent commit to the
     fallback.

     Not `optional`: it commits after the block period alone and will NOT
     swap afterwards even when the font arrives moments later. A hard
     reload (Ctrl+Shift+R) bypasses the cache, so the file has to come
     off the network inside ~100ms and usually loses — the typeface then
     never renders, however long you wait.

     Not `swap` either, whose swap period is unbounded: on a bad
     connection it re-lays out the page whenever the font finally lands,
     long after the reader started reading. `fallback` bounds that to ~3s
     — enough for a preloaded, same-origin file on any connection that
     was going to succeed at all. */
  /* 500 is the design ceiling: a heavier request, including the browser's
     own bold for strong, b and th, clamps to it, and `font-synthesis-weight:
     none` below stops a faux bold on top. */
  @font-face {
    font-family: 'Geist Variable';
    src: url('/fonts/Geist-Variable.woff2') format('woff2');
    font-weight: 300 500;
    font-style: normal;
    font-display: fallback;
  }

  /* Match Arial's x-height to Geist's (0.530em vs 0.519em). Vertical
     overrides use Geist's 1005/-295/0 hhea metrics (1000 UPM), divided by
     size-adjust. */
  @font-face {
    font-family: 'Geist Fallback';
    src: local('Arial');
    font-weight: 100 500;
    size-adjust: 102.12%;
    ascent-override: 98.41%;
    descent-override: 28.89%;
    line-gap-override: 0%;
  }

  :root {
    font-synthesis-weight: none;
    /* One face for text, product headings and public display type. */
    --font-text: 'Geist Variable', 'Geist Fallback', Arial;
  }
</style>
