---
/**
 * SourcesList — the numbered sources at the end of a guide or post, as one
 * disclosure: the `title` with the count beside it, then optional
 * notes (the `notes` slot) and one SourceRow per source, the whole list
 * between two `line` hairlines, so open or closed it ends on one rule. Up to six sources start open; a longer list starts closed so it
 * never runs on under the article. Each row is `#source-n`, the target
 * of an InlineCitation: following one opens the list (the browser reveals a
 * closed `details` for its fragment) and the row takes `surface-sunken`.
 */
import { Plus } from 'lucide-react';

interface Props {
  title?: string;
  /** How many sources the list holds. */
  count: number;
}
const { title = 'Sources', count } = Astro.props;
---

<section class="cl-sources" aria-labelledby="article-sources">
  <details class="cl-sources-details" open={count <= 6}>
    <summary class="cl-sources-summary focus-ring">
      <h2 id="article-sources" class="cl-sources-title">{title}</h2>
      <span class="cl-sources-count">{count}</span>
      <Plus aria-hidden className="cl-sources-icon size-5" />
    </summary>
    {Astro.slots.has('notes') && <div class="cl-sources-notes"><slot name="notes" /></div>}
    <ol class="cl-sources-list">
      <slot />
    </ol>
  </details>
</section>

<style is:global>
  .cl-sources {
    max-width: var(--container-prose);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .cl-sources-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
  }
  .cl-sources-summary::-webkit-details-marker {
    display: none;
  }
  .cl-sources-title {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 500;
  }
  .cl-sources-count {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-data--line-height);
  }
  .cl-sources-icon {
    margin-left: auto;
    color: var(--color-ink-secondary);
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .cl-sources-details[open] .cl-sources-icon {
    color: var(--color-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .cl-sources-summary:hover .cl-sources-icon {
      color: var(--color-ink);
    }
  }
  .cl-sources-details[open] .cl-sources-icon {
    transform: rotate(45deg);
  }
  .cl-sources-notes {
    margin: 0 0 16px;
    color: var(--color-ink-secondary);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-sources-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }
  .cl-source {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: calc(var(--nav-height) + 32px);
  }
  /* The list's own bottom rule closes the last row. */
  .cl-source:last-child {
    border-bottom: 0;
  }
  .cl-source:target {
    background: var(--color-surface-sunken);
  }
  .cl-source-n {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-body-sm--line-height);
    text-align: right;
  }
  /* A source reads in one ink, its link marked by an underline. */
  .cl-source-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
  }
  .cl-source-body p {
    margin: 0;
  }
  .cl-source-body a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-line-control);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    border-radius: var(--radius-xs);
  }
  @media (hover: hover) and (pointer: fine) {
    .cl-source-body a:hover {
      text-decoration-color: currentColor;
    }
  }
  .cl-source-meta {
    margin: 0;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-data--line-height);
    overflow-wrap: anywhere;
  }
</style>
