---
import JumpMenu from '@/components/content/JumpMenu.astro';
import Toc, { type TocItem } from '@/components/content/Toc.astro';
import './reading.css';

interface Props {
  toc?: readonly TocItem[];
  tocTitle?: string;
}
const { toc = [], tocTitle = 'On this page' } = Astro.props;
const hasToc = toc.length > 0;
const hasEnd = Astro.slots.has('end');
---

<div class:list={['cl-cpage-article', hasToc ? 'cl-cpage-article--toc' : 'cl-cpage-article--centred']}>
  <div class="cl-container">
    <div class="cl-cpage-article-grid">
      <div class="cl-cpage-article-head"><slot name="header" /></div>
      {
        hasToc && (
          <>
            <div class="cl-cpage-article-toc" data-toc-scroll>
              <Toc items={toc} title={tocTitle} />
            </div>
            <div class="cl-cpage-article-jump">
              <JumpMenu label={tocTitle}>
                <Toc items={toc} title={tocTitle} />
              </JumpMenu>
            </div>
          </>
        )
      }
      <div class="cl-cpage-article-body"><slot /></div>
      {
        hasEnd && (
          <div class="cl-cpage-article-end">
            <slot name="end" />
          </div>
        )
      }
    </div>
  </div>
</div>

<style is:global>
  .cl-cpage-article {
    --cpage-article-width: 640px;
    padding-top: 64px;
  }
  .cl-cpage-article-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--cpage-article-width));
    justify-content: center;
    column-gap: 48px;
    container-type: inline-size;
  }
  .cl-cpage-article-head,
  .cl-cpage-article-body,
  .cl-cpage-article-end {
    min-width: 0;
  }
  .cl-cpage-article-head {
    grid-row: 1;
    padding-bottom: 48px;
  }
  .cl-cpage-article-toc {
    display: none;
  }
  .cl-cpage-article-body > .cl-prose {
    max-width: none;
  }
  .cl-cpage-article-body > .cl-prose > :first-child {
    margin-top: 0;
  }
  .cl-cpage-article--toc .cl-cpage-article-grid {
    justify-content: start;
  }
  .cl-cpage-article-end {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: 64px;
  }
  .cl-cpage-article--toc .cl-cpage-article-jump {
    grid-row: 2;
    height: var(--control-lg);
    margin-bottom: 32px;
  }
  .cl-cpage-article--toc .cl-cpage-article-body {
    grid-row: 3;
  }
  .cl-cpage-article--toc .cl-cpage-article-end {
    grid-row: 4;
  }
  @media (min-width: 1280px) {
    .cl-cpage-article--toc .cl-cpage-article-grid {
      --cpage-toc-width: 280px;
      grid-template-columns:
        var(--cpage-toc-width) minmax(0, var(--cpage-article-width))
        minmax(0, 1fr);
      justify-content: start;
    }
    .cl-cpage-article--toc :is(.cl-cpage-article-body, .cl-cpage-article-end) {
      grid-column: 2;
    }
    .cl-cpage-article--toc .cl-cpage-article-head {
      grid-column: 2 / -1;
    }
    .cl-cpage-article--toc .cl-cpage-article-head .cl-ahead {
      max-width: none;
    }
    .cl-cpage-article--toc .cl-cpage-article-head :is(.cl-ahead-title, .cl-ahead-lead, .cl-ahead-byline, .cl-crumbs) {
      max-width: var(--cpage-article-width);
    }
    .cl-site .cl-cpage-article-toc .cl-toc-link {
      color: var(--color-ink-2);
      text-wrap: pretty;
    }
    .cl-site .cl-cpage-article-toc .cl-toc-link[aria-current='location'] {
      color: var(--color-ink);
    }
    @media (hover: hover) and (pointer: fine) {
      .cl-site .cl-cpage-article-toc .cl-toc-link:hover {
        color: var(--color-ink);
      }
    }
    .cl-site .cl-cpage-article-toc .cl-toc-link {
      line-height: var(--text-body-sm--line-height);
    }
    .cl-cpage-article-toc {
      display: flex;
      flex-direction: column;
      position: sticky;
      top: calc(var(--nav-height) + 40px);
      grid-column: 1;
      grid-row: 2 / span 2;
      align-self: start;
      max-height: calc(100dvh - var(--nav-height) - 80px);
    }
    .cl-site .cl-cpage-article-toc .cl-toc {
      min-height: 0;
    }
    .cl-site .cl-cpage-article-toc .cl-toc-list {
      min-height: 0;
      padding-left: 1px;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-left: 0;
      background:
        linear-gradient(var(--color-rule), var(--color-rule)) left / 1px 100% no-repeat,
        linear-gradient(var(--site-page) 40%, transparent) top / 100% 32px no-repeat local,
        linear-gradient(transparent, var(--site-page) 60%) bottom / 100% 32px no-repeat local,
        linear-gradient(color-mix(in oklch, var(--color-ink) 14%, transparent), transparent) top /
          100% 16px no-repeat scroll,
        linear-gradient(transparent, color-mix(in oklch, var(--color-ink) 14%, transparent)) bottom /
          100% 16px no-repeat scroll;
      scrollbar-width: thin;
      scrollbar-color: var(--color-rule-strong) transparent;
    }
    .cl-cpage-article--toc .cl-cpage-article-jump {
      display: none;
    }
    .cl-cpage-article--toc .cl-cpage-article-body {
      grid-row: 2;
    }
    .cl-cpage-article--toc .cl-cpage-article-end {
      grid-row: 3;
    }
  }
  @media (max-width: 767px) {
    .cl-cpage-article {
      padding-top: 48px;
    }
    .cl-cpage-article-head {
      padding-bottom: 40px;
    }
    .cl-cpage-article-grid {
      column-gap: 0;
    }
    .cl-cpage-article-end {
      gap: 40px;
      padding-top: 48px;
    }
  }

  .cl-cpage-article [data-callout-tone] {
    gap: 16px;
    padding: 20px 24px;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-cpage-article [data-callout-tone] > span:first-child {
    height: var(--text-body--line-height);
  }
  @media (max-width: 767px) {
    .cl-cpage-article [data-callout-tone] {
      padding: 16px 20px;
    }
  }
</style>
