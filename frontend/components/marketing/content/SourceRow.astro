---
/**
 * SourceRow — one numbered source in a SourcesList: the mono number, the
 * domain's initial on `ink` (the Citation pill's favicon fallback), the
 * source itself (the default slot: publisher, linked title and any note) and
 * a mono line with the domain.
 */
interface Props {
  n: number;
  /** The source's address, for its domain line and initial. */
  href?: string;
}
const { n, href } = Astro.props;
// A site-relative source is one of CiteLadder's own pages.
function domainOf(address: string | undefined) {
  if (!address) return undefined;
  if (!/^https?:\/\//.test(address)) return 'citeladder.com';
  return new URL(address).hostname.replace(/^www\./, '');
}
const domain = domainOf(href);
---

<li id={`source-${n}`} class="cl-source">
  <span class="cl-source-n">{n}</span>
  <span class="cl-source-fav" aria-hidden="true">{domain?.charAt(0)}</span>
  <div class="cl-source-body">
    <slot />
    {domain && <p class="cl-source-meta">{domain}</p>}
  </div>
</li>
