---
import { ArrowRight } from '@/lib/icons';

type ContentIndexItem =Readonly<{
  title: string;
  href: string;
  body?: string;
  meta?: string;
  eyebrow?: string;
}>;

type ContentIndexGroup =Readonly<{
  id?: string;
  title?: string;
  description?: string;
  count?: string;
  items: readonly ContentIndexItem[];
}>;

interface Props {
  groups: readonly ContentIndexGroup[];
  as?: 'h2' | 'h3';
}
const { groups, as: Heading = 'h2' } = Astro.props;
---

<div class="cl-cpage-index">
  {
    groups.map((group) => (
      <section
        id={group.id}
        class:list={['cl-cpage-index-group', { 'cl-cpage-index-group--untitled': !group.title }]}
        aria-label={group.title}
      >
        {group.title && (
          <div class="cl-cpage-index-head">
            <Heading class="cl-cpage-index-title">{group.title}</Heading>
            {group.description && <p class="cl-cpage-index-desc">{group.description}</p>}
            {group.count && <p class="cl-cpage-index-count">{group.count}</p>}
          </div>
        )}
        <ul class="cl-cpage-index-list">
          {group.items.map((item) => (
            <li>
              <a href={item.href} class="cl-cpage-index-link focus-ring">
                {item.eyebrow && <span class="type-eyebrow">{item.eyebrow}</span>}
                <span class="cl-cpage-index-name">{item.title}</span>
                {item.body && <span class="cl-cpage-index-body">{item.body}</span>}
                {item.meta && (
                  <span class="cl-cpage-index-meta">
                    {item.meta.split(' · ').map((part, index) => (
                      <>
                        {index > 0 && ' · '}
                        <span class="cl-cpage-index-part">{part}</span>
                      </>
                    ))}
                  </span>
                )}
                <span class="cl-cpage-index-arrow" aria-hidden="true">
                  <ArrowRight className="size-5" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style is:global>
  .cl-cpage-index {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .cl-cpage-index-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .cl-cpage-index-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: var(--container-prose);
  }
  .cl-cpage-index-title {
    margin: 0;
    color: var(--text-color-ink);
    font-family: var(--font-display);
    font-size: var(--text-site-section, var(--text-display-md));
    line-height: var(--text-site-section--line-height, var(--text-display-md--line-height));
    font-weight: 400;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .cl-cpage-index-desc {
    margin: 0;
    color: var(--text-color-ink-2);
    font-size: var(--text-site-body);
    line-height: var(--text-site-body--line-height);
  }
  .cl-cpage-index-count {
    margin: 4px 0 0;
    color: var(--text-color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-data--line-height);
  }
  .cl-cpage-index-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
    list-style: none;
  }
  .cl-cpage-index-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20px;
    align-items: start;
    gap: 8px 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-rule);
    color: var(--text-color-ink);
    text-decoration: none;
  }
  .cl-cpage-index-link > :not(.cl-cpage-index-arrow) {
    grid-column: 1;
    max-width: var(--container-prose);
  }
  .cl-cpage-index-name {
    color: var(--text-color-ink);
    font-size: var(--text-heading-lg);
    line-height: var(--text-heading-lg--line-height);
    font-weight: 500;
    letter-spacing: var(--text-heading-lg--letter-spacing);
    text-wrap: pretty;
  }
  @media (hover: hover) and (pointer: fine) {
    .cl-cpage-index-link:hover .cl-cpage-index-name {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
    }
    .cl-cpage-index-link:hover .cl-cpage-index-arrow {
      color: var(--text-color-ink);
    }
  }
  .cl-cpage-index-body {
    display: -webkit-box;
    max-width: 640px;
    overflow: hidden;
    color: var(--text-color-ink-2);
    font-size: var(--text-site-body);
    line-height: var(--text-site-body--line-height);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .cl-cpage-index-meta {
    margin-top: 4px;
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-cpage-index-part {
    white-space: nowrap;
  }
  .cl-cpage-index-arrow {
    display: inline-flex;
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: center;
    color: var(--text-color-ink-2);
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .cl-cpage-index-group:has(+ .cl-cpage-index-group--untitled) .cl-cpage-index-list > li:last-child > .cl-cpage-index-link {
    border-bottom: 0;
  }
  @media (min-width: 1024px) {
    .cl-cpage-index-link:has(.cl-cpage-index-meta) {
      grid-template-columns: 320px minmax(0, 1fr) 20px;
    }
    .cl-cpage-index-link:has(.cl-cpage-index-meta) > :not(.cl-cpage-index-arrow) {
      grid-column: 2;
    }
    .cl-cpage-index-link:has(.cl-cpage-index-meta) > .cl-cpage-index-meta {
      grid-row: 1 / span 3;
      grid-column: 1;
      margin-top: 0;
      padding-top: 2px;
    }
    .cl-cpage-index-link:has(.cl-cpage-index-meta) > .cl-cpage-index-arrow {
      grid-column: 3;
    }
  }
  @media (max-width: 1023px) {
    .cl-cpage-index {
      gap: 48px;
    }
  }
  @media (max-width: 767px) {
    .cl-cpage-index-link {
      column-gap: 16px;
      padding: 20px 0;
    }
  }
</style>
