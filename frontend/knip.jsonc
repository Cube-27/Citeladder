{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Keep caching off initially: `check:dead-code` deliberately omits --cache
  // while the two frontend runtimes are being validated together.
  "workspaces": {
    ".": {
      "paths": {
        // Knip strips :workers from Cloudflare's runtime module specifier.
        // Resolve it to its existing declaration rather than an npm dependency.
        "cloudflare": ["./apps/marketing/src/cloudflare-workers.d.ts"],
      },
      "entry": [
        // Astro entrypoints own the public-site runtime graph; the Vite app is
        // entered explicitly because knip's vite plugin does not discover the
        // nested apps/app/vite.config.ts on its own. The vite config covers
        // server-proxy.ts; main.tsx covers the HTML-driven runtime graph
        // including runtime.css.
        "apps/marketing/astro.config.mjs",
        "apps/marketing/src/middleware.ts",
        "apps/marketing/src/pages/**/*.{astro,ts}",
        "apps/docs/astro.config.mjs",
        "apps/docs/src/pages/**/*.{astro,ts}",
        "apps/app/vite.config.ts",
        "apps/app/src/main.tsx",
        "apps/app/worker.ts",
      ],
      "project": [
        "apps/app/**/*.{ts,tsx}",
        "apps/marketing/**/*.{astro,ts,tsx}",
        "apps/docs/**/*.{astro,ts,tsx}",
        "components/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}",
        "scripts/**/*.{js,mjs,ts,mts}",
        "**/*.css",
      ],
    },
    // The API contracts shared by the browser app and the TypeScript service.
    // Its exports are its public surface, so an export no consumer imports is
    // still reported as dead rather than excused as a package entry.
    "packages/contracts": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
    },
    "packages/mcp-app": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "vite.config.ts"],
    },
    // The TypeScript API service (docs/architecture.md). Its generated inputs
    // are consumed wholesale, so unused generated table types are expected.
    "services/api": {
      // Native development seed orchestration invokes this CLI entrypoint directly.
      "entry": ["src/cli/seed-audit.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignore": ["src/generated/**"],
    },
  },
  "ignoreDependencies": [
    // Resolved through a computed path in check-jscpd.mjs, which static analysis cannot follow.
    "jscpd",
  ],
}
