{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Keep caching off initially: `check:dead-code` deliberately omits --cache
  // while the two frontend runtimes are being validated together.
  "entry": [
    // Astro entrypoints own the public-site runtime graph; the Vite app is
    // entered explicitly because knip's vite/vitest plugins only auto-activate
    // on `vite`/`vitest` dependencies, which Vite+ has bundled away. The vite
    // config covers server-proxy.ts; main.tsx covers the HTML-driven runtime
    // graph including runtime.css.
    "apps/marketing/astro.config.mjs",
    "apps/marketing/src/middleware.ts",
    "apps/marketing/src/pages/**/*.{astro,ts}",
    "apps/app/vite.config.ts",
    "apps/app/src/main.tsx",
    // Invoked explicitly as the real-stack content-integration Playwright entry point.
    "e2e/content-integration.config.ts",
    // Type declaration for the imported check-frontend-complexity.mjs policy module.
    "scripts/check-frontend-complexity.d.mts",
    // Type declaration for the imported check-jscpd.mjs policy module.
    "scripts/check-jscpd.d.mts",
    // Type declaration for the imported design-system-source-checks.mjs policy module.
    "scripts/design-system-source-checks.d.mts",
  ],
  "project": [
    "apps/app/**/*.{ts,tsx}",
    "apps/marketing/**/*.{astro,ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts,mts}",
    "**/*.css",
  ],
  "ignoreDependencies": [
    // Resolved through a computed path in check-jscpd.mjs, which static analysis cannot follow.
    "jscpd",
    // Loaded at runtime by Vite+'s bundled Vitest as the coverage provider; never imported statically.
    "@vitest/coverage-v8",
  ],
  "ignoreBinaries": [
    // External Python package manager used by the real-stack helper, not an npm dependency.
    "uv",
  ],
}
