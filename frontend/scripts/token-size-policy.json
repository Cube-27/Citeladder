{
  "limit_tokens": 6000,
  "bytes_per_token": 4,
  "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".css"],
  "ignore": [
    { "glob": "**/test/**", "reason": "tests and their helpers; max_test_loc covers them" },
    { "glob": "**/__tests__/**", "reason": "tests" },
    { "glob": "**/*.test.*", "reason": "tests" },
    { "glob": "**/*.spec.*", "reason": "tests" },
    { "glob": "frontend/e2e/**", "reason": "browser tests" },
    { "glob": "**/fixtures/**", "reason": "test fixtures" },
    { "glob": "**/*-fixtures.*", "reason": "test fixtures" },
    { "glob": "**/generated/**", "reason": "codegen (kysely-codegen), checked by db:types:check" },
    { "glob": "**/db-schema.ts", "reason": "codegen database types" },
    { "glob": "**/*.gen.ts", "reason": "codegen" },
    { "glob": "**/worker-configuration.d.ts", "reason": "generated by wrangler types" },
    {
      "glob": "frontend/apps/docs/public/templates/**",
      "reason": "generated by the API export scripts (\"Do not edit\" header)"
    },
    { "glob": "**/migrations/**", "reason": "migrations are append-only history" },
    { "glob": "frontend/lib/marketing-content/**", "reason": "marketing content data" },
    { "glob": "frontend/services/api/src/config/**", "reason": "API config and policy data" },
    { "glob": "frontend/lib/config/**", "reason": "frontend config owner" },
    {
      "glob": "frontend/apps/app/src/globals.css",
      "reason": "design tokens and the shared rules, ordered by cascade tier: an area (tables, shell) spans several tiers, so an order-keeping split gives tier files, not area files, and the design-system checks read it as the one token owner (owner, 2026-11-19: split only if it helps maintenance)"
    },
    { "glob": "frontend/services/api/src/mcp/tools.ts", "reason": "MCP read-tool registry" },
    { "glob": "frontend/services/api/src/mcp/write-tools.ts", "reason": "MCP write-tool registry" }
  ],
  "baseline": {
    "frontend/services/api/src/entitlements/ledger.ts": 6005,
    "frontend/services/api/src/routes/integrations.ts": 6376,
    "frontend/services/api/src/workers/integration-worker.ts": 6007,
    "frontend/services/api/src/workspaces/account-manager.ts": 6580
  }
}
