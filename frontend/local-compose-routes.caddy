# Local Compose only. Browser port 3000 combines both frontend containers for
# clean-clone smoke; production routing belongs to the two Workers.
# /register is a browser route; dynamic MCP registration is /mcp/register.
# Route families the TypeScript API service owns (route-ownership manifest in
# packages/contracts). Declared first, with the longest first pattern.
@ts_api path /api/v1/audits /api/v1/audits/* /api/v1/provider-catalog /api/v1/provider-connections /api/v1/provider-connections/* /api/v1/executions/* /api/v1/projects/*/ai-referrals /api/v1/projects/*/visibility /api/v1/projects/*/visibility/* /api/v1/projects/*/visibility/sources/* /api/v1/projects/*/performance /api/v1/projects/*/performance/table /api/v1/projects/*/performance/range /api/v1/projects/*/performance/range/* /api/v1/projects/*/demand/* /api/v1/projects/*/demand/query-evidence/summary /api/v1/projects/*/opportunities /api/v1/projects/*/opportunities/* /api/v1/opportunities/* /api/v1/projects/*/actions /api/v1/actions/* /api/v1/projects/*/search-intelligence /api/v1/projects/*/search-intelligence/reviews /api/v1/projects/*/search-intelligence/preferences /api/v1/projects/*/search-intelligence/runs /api/v1/projects/*/search-intelligence/runs/* /api/v1/projects/*/search-intelligence/runs/*/confirm /api/v1/projects/*/search-intelligence/runs/*/cancel /api/v1/projects/*/search-intelligence/datasets/*/rows /api/v1/projects/*/search-intelligence/content-handoff /api/v1/projects/*/search-intelligence/citation-matches /api/v1/projects/*/commerce/catalog /api/v1/projects/*/commerce/catalog/import /api/v1/projects/*/commerce/competitors /api/v1/projects/*/commerce/competitors/discoveries /api/v1/projects/*/commerce/competitors/*-*-*-*-* /api/v1/projects/*/commerce/buyer-prompts/generate /api/v1/projects/*/commerce/buyer-prompts/manual /api/v1/projects/*/commerce/buyer-prompts /api/v1/projects/*/commerce/buyer-prompts/*-*-*-*-* /api/v1/projects/*/commerce/ai-shelf /api/v1/projects/*/brand-profile /api/v1/projects/*/business-map /api/v1/projects/*/competitor-suggestions /api/v1/projects/*/competitor-suggestions/*/accept /api/v1/projects/*/logo /api/v1/projects/*/topics /api/v1/topics/* /api/v1/prompt-sets /api/v1/prompt-sets/*-*-*-*-* /api/v1/prompt-sets/*/generate /api/v1/prompt-sets/*/prompts /api/v1/prompt-sets/*/prompts/bulk-status /api/v1/prompt-sets/*/import /api/v1/prompt-sets/*/candidates /api/v1/prompt-sets/*/candidates/review /api/v1/prompts/* /api/v1/projects/*/competitors/*/logo /api/v1/projects/*/site-health/internal-links /api/v1/projects/*/site-health/internal-links/* /api/v1/projects/*/site-health/internal-links/analyses/*/cancel /api/v1/projects /api/v1/projects/*-*-*-*-* /api/v1/projects/*/logos/refresh /api/v1/projects/*/command-center /api/v1/brand-discovery-catalog /api/v1/brand-discoveries /api/v1/brand-discoveries/* /api/v1/auth/* /api/v1/workspaces /api/v1/workspaces/invitations/accept /api/v1/workspaces/*/members /api/v1/workspaces/*/members/*-*-*-*-* /api/v1/workspaces/*/members/leave /api/v1/workspaces/*/ownership /api/v1/workspaces/*/invitations /api/v1/workspaces/*/invitations/*-*-*-*-* /api/v1/workspaces/*/invitations/*/resend /api/v1/workspaces/*/policies /api/v1/workspaces/*/product-tour /api/v1/mcp/connections /api/v1/mcp/connections/* /api/v1/workspaces/*/mcp/connections /api/v1/workspaces/*/mcp/connections/* /mcp /mcp/* /authorize /token /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp /api/v1/billing/invoices /api/v1/billing/invoices/*/pdf /api/v1/projects/*/reports/executive.pdf /api/v1/projects/*/audit-schedules /api/v1/projects/*/audit-schedules/*
reverse_proxy @ts_api {$API_SERVICE_ORIGIN:127.0.0.1:8100}

@ts_integrations path /api/v1/integrations /api/v1/integrations/* /api/v1/projects/*/performance/sync
reverse_proxy @ts_integrations {$API_SERVICE_ORIGIN:127.0.0.1:8100}

@ts_billing path /api/v1/billing/catalog /api/v1/billing/entitlement /api/v1/billing/usage /api/v1/billing/early-access /api/v1/billing/early-access/claim /api/v1/billing/card-trial/quote /api/v1/billing/subscriptions /api/v1/billing/subscription /api/v1/billing/subscription/change /api/v1/billing/addons /api/v1/billing/topups /api/v1/billing/activations/* /api/v1/billing/activations/*/checkout /api/v1/billing/activations/*/verify /api/v1/billing/webhooks/* /api/v1/workspaces/*/entitlements
reverse_proxy @ts_billing {$API_SERVICE_ORIGIN:127.0.0.1:8100}

@backend path /api /api/*
reverse_proxy @backend {$BACKEND_ORIGIN:127.0.0.1:8000}

@vite_assets path /app-assets/*
reverse_proxy @vite_assets {$VITE_ORIGIN:127.0.0.1:3001}

@astro_assets path /_astro/*
reverse_proxy @astro_assets {$MARKETING_ORIGIN:127.0.0.1:3000}

# Exact application paths and bounded dynamic routes retain Vite ownership.
# Unknown descendants fall through to Astro and return a real 404.
@vite_exact path /login /login/ /register /register/ /projects /projects/ /onboarding /onboarding/ /site /site/ /issues /issues/ /demand /demand/ /search-intelligence /search-intelligence/ /performance /performance/ /opportunities /opportunities/ /agent /agent/ /agent/actions /agent/actions/ /agent/skills /agent/skills/ /agent/context /agent/context/ /visibility /visibility/ /runs /runs/ /prompts /prompts/ /products /products/ /ai-referrals /ai-referrals/ /settings /settings/ /invitations/accept /invitations/accept/
reverse_proxy @vite_exact {$VITE_ORIGIN:127.0.0.1:3001} {
  header_down Cache-Control "no-store"
}
@vite_dynamic path_regexp vite_dynamic ^/(?:runs/[^/]+|site/crawls/[^/]+/pages/[^/]+|agent/(?:chats|actions)/[^/]+)/?$
reverse_proxy @vite_dynamic {$VITE_ORIGIN:127.0.0.1:3001} {
  header_down Cache-Control "no-store"
}

reverse_proxy {$MARKETING_ORIGIN:127.0.0.1:3000}
