{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["astro/client", "vite/client"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "apps/app/**/*.ts",
    "apps/app/**/*.tsx",
    "apps/marketing/**/*.ts",
    "apps/marketing/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
