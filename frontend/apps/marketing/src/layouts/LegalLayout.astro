---
import ArticleHeader from '@/components/content/ArticleHeader.astro';
import DocLayout from '@/components/content/DocLayout.astro';
import Prose from '@/components/content/Prose.astro';
import '@/components/marketing/content/reading.css';
import { Breadcrumbs } from '@/components/marketing/chrome/breadcrumbs';
import { Linkify } from '@/components/marketing/primitives/linkify';
import { PageSection } from '@/components/marketing/sections/page-section';
import type { LegalDocument } from '@/lib/marketing-content/legal';
import { FOOTER_LEGAL_LINKS } from '@/lib/marketing-content/legal-documents';
import { formatSiteDate } from '@/lib/marketing-content/site-date';
import MarketingLayout from './MarketingLayout.astro';

interface Props {
  document: LegalDocument;
}
const { document } = Astro.props;

const { updated, path } = document;
const updatedLabel = formatSiteDate(updated);

const clauses = document.sections.map((section, index) => ({
  ...section,
  number: index + 1,
  heading: `${index + 1}. ${section.title}`,
}));
---

<MarketingLayout title={document.metaTitle} description={document.description} canonical={path}>
  <PageSection label={document.title} spacing="compact">
    <DocLayout
      nav={FOOTER_LEGAL_LINKS.map((link) => ({ ...link, current: link.href === path }))}
      navLabel="Policies"
      navSummary="All policies"
      toc={clauses.map((clause) => ({ id: clause.id, label: clause.heading, level: 2 }))}
    >
      <ArticleHeader
        slot="header"
        title={document.title}
        meta={[{ prefix: 'Last updated', text: updatedLabel, dateTime: updated }]}
      >
        <Breadcrumbs
          slot="crumbs"
          items={[{ label: 'Home', href: '/' }, { label: document.title }]}
        />
        {document.description}
      </ArticleHeader>
      <Prose as="article" label={document.title}>
        {
          clauses.map((clause) => (
            <>
              <h2 id={clause.id}>{clause.heading}</h2>
              {clause.paragraphs?.map((paragraph, index) => (
                <p>
                  <strong>{`${clause.number}.${index + 1}`}</strong> <Linkify text={paragraph} />
                </p>
              ))}
              {clause.bullets && clause.bullets.length > 0 && (
                <ul>
                  {clause.bullets.map((item) => (
                    <li>
                      <Linkify text={item} />
                    </li>
                  ))}
                </ul>
              )}
              {clause.table && (
                <div class="cl-prose-table">
                  <table>
                    <caption class="sr-only">{clause.table.caption}</caption>
                    <thead>
                      <tr>
                        {clause.table.headings.map((heading) => (
                          <th scope="col">{heading}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {clause.table.rows.map(([header, ...cells]) => (
                        <tr>
                          <th scope="row">{header}</th>
                          {cells.map((cell) => (
                            <td>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {clause.note && <p class="cl-legal-note">{clause.note}</p>}
            </>
          ))
        }
      </Prose>
    </DocLayout>
  </PageSection>
</MarketingLayout>

<style>
  .cl-legal-note {
    padding: 16px 20px;
    border-radius: var(--site-radius-inner);
    background: var(--color-surface-sunken);
  }
</style>
