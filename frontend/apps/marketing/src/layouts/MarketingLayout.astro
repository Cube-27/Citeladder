---
// First, so the tokens and utilities precede every component sheet (each ships
// next to its component and loads only on pages that render it).
import '@/apps/marketing/src/marketing.css';
import '@/apps/marketing/src/site-base.css';
import '@/apps/marketing/src/site-backdrop.css';
import GoogleAnalytics from '@/components/analytics/GoogleAnalytics.astro';
import CookieBanner from '@/components/marketing/chrome/CookieBanner.astro';
import SpeculationRules from '@/components/content/SpeculationRules.astro';
import PublicFonts from '@/components/marketing/chrome/PublicFonts.astro';
import SiteNav from '@/components/marketing/chrome/SiteNav.astro';
import { SiteFooter } from '@/components/marketing/chrome/site-footer';
import {
  organizationJsonLd,
  serializeJsonLd,
  softwareApplicationJsonLd,
  websiteJsonLd,
  type JsonLdObject,
} from '@/lib/seo/json-ld';
import {
  absoluteUrl,
  DEFAULT_SOCIAL_IMAGE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
} from '@/lib/seo/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: readonly string[];
  openGraphType?: 'article' | 'website';
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: readonly string[];
  twitterCard?: 'summary' | 'summary_large_image';
  robots?: string;
  jsonLd?: readonly JsonLdObject[];
}

const {
  title = `${SITE_NAME} · ${SITE_TAGLINE}`,
  description = SITE_DESCRIPTION,
  canonical,
  keywords = [],
  openGraphType = 'website',
  image,
  imageAlt = '',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  twitterCard,
  robots,
  jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical ? (absoluteUrl(canonical) ?? canonical) : undefined;
// Social cards carry the site name separately (og:site_name), so drop it from the title.
const socialTitle = [` · ${SITE_NAME}`, ` | ${SITE_NAME}`].reduce(
  (value, suffix) => (value.endsWith(suffix) ? value.slice(0, -suffix.length) : value),
  title,
);
// A page image without its own alt text is described by the page title.
const socialImage = image ? { path: image, alt: imageAlt || socialTitle } : DEFAULT_SOCIAL_IMAGE;
const imageUrl = absoluteUrl(socialImage.path) ?? undefined;
const resolvedTwitterCard = twitterCard ?? (imageUrl ? 'summary_large_image' : 'summary');
const gaMeasurementId = process.env.NEXT_PUBLIC_GA_MEASUREMENT_ID;
const sharedJsonLd = [organizationJsonLd(), websiteJsonLd(), softwareApplicationJsonLd()].filter(
  (data): data is JsonLdObject => data !== null,
);
// `data-marketing-surface` on <html> keys the marketing-only display sizes
// and secondary button (globals.css); docs carries `data-public-surface`
// alone.
---

<!doctype html>
<html lang="en" data-public-surface data-marketing-surface>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- The shared light/dark/system choice (lib/theme/theme.ts), before first paint. -->
    <script is:inline src="/theme-preference.js"></script>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="application-name" content={SITE_NAME} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <PublicFonts />
    <SpeculationRules />
    <title>{title}</title>
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content={SITE_NAME} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1080" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content={socialImage.alt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={resolvedTwitterCard} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {robots && <meta name="robots" content={robots} />}
    {sharedJsonLd.map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body class="cl-site relative isolate min-h-dvh">
    {gaMeasurementId && <GoogleAnalytics />}
    <a href="#main" class="skip-link">Skip to main content</a>
    <SiteNav path={Astro.url.pathname} />
    {/* Clip, not hide: a wide product frame never scrolls the page sideways, and sticky asides still stick. */}
    <div class="cl-site-main relative z-1 overflow-x-clip">
      <div class="cl-site-backdrop" aria-hidden="true"><div></div></div>
      <slot />
    </div>
    <SiteFooter />
    <CookieBanner />
  </body>
</html>
