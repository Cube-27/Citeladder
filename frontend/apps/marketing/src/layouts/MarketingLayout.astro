---
import { GoogleAnalytics } from '@/components/analytics/google-analytics';
import { CookieBanner } from '@/components/marketing/chrome/cookie-banner';
import { MarketingFooter } from '@/components/marketing/chrome/footer';
import { MarketingNavIsland } from '../components/MarketingNavIsland';
import { ReturningVisitorHint } from '@/components/marketing/chrome/returning-visitor-hint';
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd, type JsonLdObject } from '@/lib/seo/json-ld';
import { absoluteUrl, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '@/lib/seo/site';
import '@/apps/marketing/src/marketing.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: readonly string[];
  openGraphType?: 'article' | 'website';
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: readonly string[];
  twitterCard?: 'summary' | 'summary_large_image';
  robots?: string;
  jsonLd?: readonly JsonLdObject[];
}

const {
  title = `${SITE_NAME} · ${SITE_TAGLINE}`,
  description = SITE_DESCRIPTION,
  canonical,
  keywords = [],
  openGraphType = 'website',
  image,
  imageAlt = '',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  twitterCard,
  robots,
  jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical ? (absoluteUrl(canonical) ?? canonical) : undefined;
const imageUrl = image ? absoluteUrl(image) ?? undefined : undefined;
const socialTitle = title.endsWith(` · ${SITE_NAME}`)
  ? title.slice(0, -` · ${SITE_NAME}`.length)
  : title;
const resolvedTwitterCard = twitterCard ?? (imageUrl ? 'summary_large_image' : 'summary');
const gaMeasurementId = process.env.NEXT_PUBLIC_GA_MEASUREMENT_ID;
const sharedJsonLd = [organizationJsonLd(), websiteJsonLd(), softwareApplicationJsonLd()].filter(
  (data): data is JsonLdObject => data !== null,
);
const serializeJsonLd = (data: JsonLdObject) => JSON.stringify(data).replace(/</g, '\u003c');
---

<!doctype html>
<html lang="en" data-public-surface>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <script is:inline src="/accent-theme-init.js"></script>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="application-name" content={SITE_NAME} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/citeladder-favicon.ico" sizes="any" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="preload"
      href="/fonts/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <style is:inline>
      @font-face {
        font-family: 'Geist';
        src: url('/fonts/Geist-Variable.woff2') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        /* `fallback`: a ~100ms block period, then a ~3s window in which the
           font may still swap in, then a permanent commit to the fallback.

           Not `optional`, which was the bug. `optional` commits after the
           block period alone and will NOT swap afterwards even when the font
           arrives moments later. That is fine from the HTTP cache, but a hard
           reload (Ctrl+Shift+R) bypasses the cache by definition, so the 29KB
           file has to come off the network inside ~100ms and usually loses —
           Geist then did not render at all, however long you waited.

           Not `swap` either, whose swap period is unbounded: on a bad
           connection it will re-lay out the page whenever the font finally
           lands, which may be ten seconds in, long after the reader started
           reading. `fallback` bounds that to ~3s — comfortably enough for a
           preloaded, same-origin 29KB file on any connection that was going
           to succeed at all, while capping how late a shift can arrive.

           A shift IS possible, and the fallback below only narrows it rather
           than eliminating it — see the note there. That trade is deliberate:
           a bounded, small reflow beats a page that never gets the typeface. */
        font-display: fallback;
      }

      /* The fallback, approximately matched to Geist's metrics.
         The vertical overrides are exact: `ascent`/`descent`/`line-gap` are
         fractions of the em, so they hold for whichever face resolves and
         line boxes keep their height either way.

         `size-adjust` is the approximate one, and deliberately so. It is a
         SINGLE scale factor, but `src` resolves to a different face per
         platform — Segoe UI on Windows, Helvetica Neue on macOS, Arial
         otherwise — and those do not share advance widths, so one number
         cannot be exact for all three. On a platform with none of them the
         `@font-face` does not resolve at all and the chain falls through to
         the unadjusted `sans-serif` at the end of `--font-sans`.
         So: this narrows the reflow when the real font swaps in, it does not
         remove it. `font-display: fallback` above is what bounds how late
         that reflow can happen. */
      @font-face {
        font-family: 'Geist Fallback';
        src: local('Segoe UI'), local('Helvetica Neue'), local('Arial');
        size-adjust: 102%;
        ascent-override: 93%;
        descent-override: 24%;
        line-gap-override: 0%;
      }

      :root {
        --font-geist: 'Geist', 'Geist Fallback';
      }
    </style>
    <title>{title}</title>
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content={SITE_NAME} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1080" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={resolvedTwitterCard} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {robots && <meta name="robots" content={robots} />}
    {sharedJsonLd.map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body class="bg-background text-foreground relative isolate min-h-dvh">
    {gaMeasurementId && <GoogleAnalytics measurementId={gaMeasurementId} client:load />}
    <ReturningVisitorHint />
    <a href="#main" class="skip-link">Skip to main content</a>
    <MarketingNavIsland client:load />
    <div class="relative z-1 pt-[var(--marketing-nav-offset)]"><slot /></div>
    <div class="relative z-1"><MarketingFooter /></div>
    <CookieBanner client:load />
  </body>
</html>
