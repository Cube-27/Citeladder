---
import { GoogleAnalytics } from '@/components/analytics/google-analytics';
import { CookieBanner } from '@/components/marketing/chrome/cookie-banner';
import { MarketingFooter } from '@/components/marketing/chrome/footer';
import { MarketingNavIsland } from '../components/MarketingNavIsland';
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd, type JsonLdObject } from '@/lib/seo/json-ld';
import { absoluteUrl, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '@/lib/seo/site';
import '@/apps/marketing/src/marketing.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: readonly string[];
  openGraphType?: 'article' | 'website';
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: readonly string[];
  twitterCard?: 'summary' | 'summary_large_image';
  robots?: string;
  jsonLd?: readonly JsonLdObject[];
}

const {
  title = `${SITE_NAME} · ${SITE_TAGLINE}`,
  description = SITE_DESCRIPTION,
  canonical,
  keywords = [],
  openGraphType = 'website',
  image,
  imageAlt = '',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  twitterCard,
  robots,
  jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical ? (absoluteUrl(canonical) ?? canonical) : undefined;
const imageUrl = image ? absoluteUrl(image) ?? undefined : undefined;
const socialTitle = title.endsWith(` · ${SITE_NAME}`)
  ? title.slice(0, -` · ${SITE_NAME}`.length)
  : title;
const resolvedTwitterCard = twitterCard ?? (imageUrl ? 'summary_large_image' : 'summary');
const gaMeasurementId = process.env.NEXT_PUBLIC_GA_MEASUREMENT_ID;
const sharedJsonLd = [organizationJsonLd(), websiteJsonLd(), softwareApplicationJsonLd()].filter(
  (data): data is JsonLdObject => data !== null,
);
const serializeJsonLd = (data: JsonLdObject) => JSON.stringify(data).replace(/</g, '\u003c');
---

<!doctype html>
<html lang="en" data-public-surface>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="application-name" content={SITE_NAME} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/citeladder-favicon.ico" sizes="any" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Discover the fonts at first paint instead of after the stylesheet
        loads. Inter (text) and General Sans (headings) are not in this
        repository: `pnpm fonts:pull` copies them into public/fonts from the
        private Cube27 font repo, and delivery does the same. A build without
        them renders in the matched fallbacks below. -->
    <link
      rel="preload"
      href="/fonts/GeneralSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <style is:inline>
      /* `font-display: fallback`: a ~100ms block period, then a ~3s window in
         which the font may still swap in, then a permanent commit to the
         fallback.

         Not `optional`: it commits after the block period alone and will NOT
         swap afterwards even when the font arrives moments later. A hard
         reload (Ctrl+Shift+R) bypasses the cache, so the file has to come
         off the network inside ~100ms and usually loses — the typeface then
         never renders, however long you wait.

         Not `swap` either, whose swap period is unbounded: on a bad
         connection it re-lays out the page whenever the font finally lands,
         long after the reader started reading. `fallback` bounds that to ~3s
         — enough for a preloaded, same-origin file on any connection that
         was going to succeed at all. */
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Variable.woff2') format('woff2');
        /* 600 is the design ceiling: a heavier request clamps to it. */
        font-weight: 200 600;
        font-style: normal;
        font-display: fallback;
      }

      @font-face {
        font-family: 'Inter';
        src: url('/fonts/InterVariable.woff2') format('woff2');
        font-weight: 100 600;
        font-style: normal;
        font-display: fallback;
      }

      /* Fallbacks matched to each face's metrics, so the swap moves as little
         as possible. The vertical overrides are exact (the face's hhea
         ascent/descent/line gap divided by size-adjust), so line boxes keep
         their height whichever face renders.

         `size-adjust` is approximate, and deliberately so: it is one scale
         factor, but `src` resolves to Segoe UI on Windows, Helvetica Neue on
         macOS and Arial elsewhere, which do not share advance widths. It is
         the ratio of average text advance at weight 400. On a platform with
         none of them the chain falls through to the unadjusted system
         stack at the end of the theme tokens. */
      @font-face {
        font-family: 'General Sans Fallback';
        src: local('Segoe UI'), local('Helvetica Neue'), local('Arial');
        size-adjust: 103%;
        ascent-override: 98%;
        descent-override: 23%;
        line-gap-override: 10%;
      }

      @font-face {
        font-family: 'Inter Fallback';
        src: local('Segoe UI'), local('Helvetica Neue'), local('Arial');
        size-adjust: 107%;
        ascent-override: 91%;
        descent-override: 23%;
        line-gap-override: 0%;
      }

      :root {
        --font-text: 'Inter', 'Inter Fallback';
        --font-heading: 'General Sans', 'General Sans Fallback';
      }
    </style>
    <title>{title}</title>
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content={SITE_NAME} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1080" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={resolvedTwitterCard} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {robots && <meta name="robots" content={robots} />}
    {sharedJsonLd.map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body class="bg-background text-foreground relative isolate min-h-dvh">
    {gaMeasurementId && <GoogleAnalytics measurementId={gaMeasurementId} client:load />}
    <a href="#main" class="skip-link">Skip to main content</a>
    <MarketingNavIsland client:load />
    <div class="relative z-1 pt-[var(--marketing-nav-offset)]"><slot /></div>
    <div class="relative z-1"><MarketingFooter /></div>
    <CookieBanner client:load />
  </body>
</html>
