---
import type { ResearchArticle as ResearchArticleData } from '../research-articles';
import ResearchArticle from '../components/ResearchArticle.astro';
import { breadcrumbJsonLd, researchArticleJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from './MarketingLayout.astro';

interface Props { article: ResearchArticleData }
const { article } = Astro.props;
const meta = article.frontmatter;
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/blog' },
  { name: meta.title, path: meta.slug },
]);
// No person author or publication date is supplied, so the Article claims
// neither: the organization authors it and the visible review date is its only date.
const jsonLd = [researchArticleJsonLd(meta), breadcrumb].filter((data) => data !== null);
---

<MarketingLayout title={`${meta.meta_title} · CiteLadder`} description={meta.meta_description} canonical={meta.slug} image={meta.image}
  keywords={[meta.primary_keyword, ...meta.secondary_keywords]} jsonLd={jsonLd}>
  <main id="main">
    <ResearchArticle article={article}>
      <slot name="contents" slot="contents" />
      <slot name="supplement" />
    </ResearchArticle>
    <slot />
  </main>
</MarketingLayout>
