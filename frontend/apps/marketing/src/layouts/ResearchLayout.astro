---
import ArticleHeader from '@/components/content/ArticleHeader.astro';
import Prose from '@/components/content/Prose.astro';
import '@/components/marketing/content/reading.css';
import AuthorCard from '@/components/marketing/content/AuthorCard.astro';
import { Breadcrumbs } from '@/components/marketing/chrome/breadcrumbs';
import ContentArticle from '@/components/marketing/content/ContentArticle.astro';
import { headingId } from '@/components/marketing/content/heading-id';
import {
  InlineMarkdown,
  MarkdownFaq,
  ProseMarkdown,
  researchHeadings,
} from '@/components/marketing/content/prose-markdown';
import SourceRow from '@/components/marketing/content/SourceRow.astro';
import SourcesList from '@/components/marketing/content/SourcesList.astro';
import { RelatedCards } from '@/components/marketing/sections/cards';
import { PageSection } from '@/components/marketing/sections/page-section';
import { formatSiteDate } from '@/lib/marketing-content/site-date';
import { platformLabel } from '@/lib/marketing-content/nav';
import { breadcrumbJsonLd, faqPageJsonLd, researchArticleJsonLd } from '@/lib/seo/json-ld';
import type { ResearchArticle } from '../research-articles';
import {
  moreGuides,
  researchAuthor,
  researchFaqs,
  researchParent,
  researchParts,
} from '../research-articles';
import MarketingLayout from './MarketingLayout.astro';

interface Props {
  article: ResearchArticle;
}
const { article } = Astro.props;
const meta = article.frontmatter;
const product = meta.product;
const parent = researchParent(meta.slug);
const parts = researchParts(article.markdown);
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: parent.label, path: parent.href },
  { name: meta.title, path: meta.slug },
]);
const faqs = researchFaqs(article.markdown);
const author = researchAuthor(article);
const jsonLd = [
  researchArticleJsonLd(meta, author),
  breadcrumb,
  faqs.length > 0 ? faqPageJsonLd(faqs) : null,
].filter((data) => data !== null);
const toc = [
  ...researchHeadings(parts.body),
  ...(parts.faq ? [{ id: headingId(parts.faq.title), label: parts.faq.title, level: 2 }] : []),
  ...researchHeadings(parts.after),
  ...(product ? [{ id: headingId(product.heading), label: product.heading, level: 2 }] : []),
];
const more = moreGuides(article);
---

<MarketingLayout
  title={`${meta.meta_title} · CiteLadder`}
  description={meta.meta_description}
  canonical={meta.slug}
  image={meta.image}
  keywords={[meta.primary_keyword, ...meta.secondary_keywords]}
  jsonLd={jsonLd}
>
  <main id="main">
    <ContentArticle toc={toc}>
      <ArticleHeader
        slot="header"
        title={meta.title}
        author={author ? { name: author.name, role: author.role } : undefined}
        meta={[
          {
            prefix: 'Research reviewed',
            text: formatSiteDate(meta.reviewed_at),
            dateTime: meta.reviewed_at,
          },
        ]}
      >
        <Breadcrumbs
          slot="crumbs"
          items={[
            { label: 'Home', href: '/' },
            { label: parent.label, href: parent.href },
            { label: meta.title },
          ]}
        />
        {meta.meta_description}
      </ArticleHeader>
      <Prose as="article" label="Guide content">
        <ProseMarkdown markdown={parts.body} />
        {
          parts.faq && (
            <>
              <h2 id={headingId(parts.faq.title)}>{parts.faq.title}</h2>
              <MarkdownFaq items={parts.faq.items} />
            </>
          )
        }
        {parts.after && <ProseMarkdown markdown={parts.after} />}
        {
          product && (
            <>
              <h2 id={headingId(product.heading)}>{product.heading}</h2>
              <p>{product.body}</p>
              <p>
                <a href={product.href}>Explore {platformLabel(product.href)}</a>
              </p>
            </>
          )
        }
      </Prose>
      {
        parts.sources && (
          <SourcesList slot="end" title={parts.sources.title} count={parts.sources.items.length}>
            {parts.sources.notes.length > 0 && (
              <Fragment slot="notes">
                {parts.sources.notes.map((note) => (
                  <p>
                    <InlineMarkdown markdown={note} />
                  </p>
                ))}
              </Fragment>
            )}
            {parts.sources.items.map((source) => (
              <SourceRow n={source.n} href={source.href}>
                <p>
                  <InlineMarkdown markdown={source.markdown} />
                </p>
              </SourceRow>
            ))}
          </SourcesList>
        )
      }
      {
        author && (
          <AuthorCard
            slot="end"
            name={author.name}
            role={author.role}
            links={[{ label: 'LinkedIn', href: author.linkedin }]}
          />
        )
      }
    </ContentArticle>
    {
      more.length > 0 && (
        <PageSection title="More guides" layout="aside" spacing="compact">
          <RelatedCards
            items={more.map((guide) => ({
              href: guide.frontmatter.slug,
              title: guide.frontmatter.title,
              body: guide.frontmatter.meta_description,
            }))}
          />
        </PageSection>
      )
    }
  </main>
</MarketingLayout>
