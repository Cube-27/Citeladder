---
import ArticleHeader from '@/components/content/ArticleHeader.astro';
import ArticlePager from '@/components/content/ArticlePager.astro';
import Prose from '@/components/content/Prose.astro';
import '@/components/marketing/content/reading.css';
import { Breadcrumbs } from '@/components/marketing/chrome/breadcrumbs';
import ContentArticle from '@/components/marketing/content/ContentArticle.astro';
import { formatSiteDate } from '@/lib/marketing-content/site-date';
import { PAGES, type PageRecord } from '@/lib/marketing-content/pages';
import MarketingLayout from './MarketingLayout.astro';

const REFERENCES = [
  { title: 'AI Instructions', href: PAGES.aiInstructions.path },
  { title: 'Entity Map', href: PAGES.entityMap.path },
] as const;

interface Props {
  title: (typeof REFERENCES)[number]['title'];
  page: PageRecord;
  lead: string;
  sections: readonly Readonly<{ id: string; title: string }>[];
}
const { title, page, lead, sections } = Astro.props;
const index = REFERENCES.findIndex((reference) => reference.title === title);
---

<MarketingLayout title={page.metaTitle} description={page.description} canonical={page.path}>
  <main id="main">
    <ContentArticle toc={sections.map((section) => ({ id: section.id, label: section.title, level: 2 }))}>
      <ArticleHeader
        slot="header"
        title={title}
        meta={[
          {
            prefix: 'Last updated',
            text: formatSiteDate(page.updated),
            dateTime: page.updated,
          },
        ]}
      >
        <Breadcrumbs slot="crumbs" items={[{ label: 'Home', href: '/' }, { label: title }]} />
        {lead}
      </ArticleHeader>
      <Prose as="article" label={title}>
        <slot />
      </Prose>
      <ArticlePager
        slot="end"
        previous={index > 0 ? REFERENCES[index - 1] : undefined}
        next={REFERENCES[index + 1]}
        label="Company references"
      />
    </ContentArticle>
  </main>
</MarketingLayout>

<style is:global>
  .cl-ref-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }
  .cl-ref-sources-label {
    color: var(--color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: var(--text-eyebrow--line-height);
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
  }
</style>
