---
import type { GetStaticPaths } from 'astro';
import { CONTACT_PAGE } from '@/lib/marketing-content/legal-billing';
import { LEGAL_DOCUMENTS } from '@/lib/marketing-content/legal-documents';
import LegalLayout from '../layouts/LegalLayout.astro';
import ResearchLayout from '../layouts/ResearchLayout.astro';
import { RESEARCH_ARTICLES } from '../research-articles';

export const getStaticPaths = (() => {
  const rootSlug = (path: string) => /^\/([^/]+)$/.exec(path)?.[1];
  return [
    ...LEGAL_DOCUMENTS.filter((document) => document !== CONTACT_PAGE).map((document) => ({
      params: { slug: rootSlug(document.path) },
      props: { kind: 'legal' as const, document },
    })),
    ...RESEARCH_ARTICLES.filter((article) => rootSlug(article.frontmatter.slug)).map(
      (article) => ({
        params: { slug: rootSlug(article.frontmatter.slug) },
        props: { kind: 'guide' as const, article },
      }),
    ),
  ];
}) satisfies GetStaticPaths;

const route = Astro.props;
---

{route.kind === 'legal' ? <LegalLayout document={route.document} /> : <ResearchLayout article={route.article} />}
