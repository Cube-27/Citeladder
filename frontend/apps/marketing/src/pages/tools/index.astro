---
/**
 * The free tools index (the WebToolsIndex template): the hero, the tools in
 * their groups as a ContentIndex, what the tools cannot tell you, and the
 * closing band toward Site Health.
 */
import Prose from '@/components/content/Prose.astro';
import '@/components/marketing/content/reading.css';
import ContentIndex from '@/components/marketing/content/ContentIndex.astro';
import { SiteHealthCta, ToolFacts, toolGroups } from '@/components/marketing/content/tool-notes';
import { ButtonLink } from '@/components/marketing/primitives/button';
import { PageHero } from '@/components/marketing/sections/heroes';
import { PageSection } from '@/components/marketing/sections/page-section';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Free website and AI crawler tools | CiteLadder"
  description="Six free browser-based tools for crawler rules, robots.txt, indexing directives, structured data, sitemap comparison and social previews. No signup required."
  canonical="/tools"
>
  <main id="main">
    <PageHero
      title="Free tools for crawler rules and page markup"
      lead="Test robots.txt rules, inspect indexing directives and build cleaner markup. All six tools run in your browser on the input you supply."
    >
      <ButtonLink slot="actions" href="/tools/ai-crawler-checker">
        Test your rules
      </ButtonLink>
    </PageHero>
    <PageSection title="Pick the task in front of you" lead="Paste text, enter details or choose a local file.">
      <ContentIndex groups={toolGroups()} as="h3" />
    </PageSection>
    <PageSection title="What these tools can and cannot check" layout="aside">
      <Prose>
        <ToolFacts />
      </Prose>
    </PageSection>
    <SiteHealthCta />
  </main>
</MarketingLayout>
