---
import type { GetStaticPaths } from 'astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { PageHero } from '@/components/marketing/primitives/page-hero';
import { Section } from '@/components/marketing/primitives/section';
import { FREE_TOOLS } from '@/lib/marketing-content/tools';
import { ToolNotes } from '@/components/marketing/tools/tools-index';
import { CrawlerChecker, RobotsGenerator } from '@/components/marketing/tools/robots-tools';
import { MetaChecker, StructuredDataBuilder } from '@/components/marketing/tools/markup-tools';
import { SitemapComparison } from '@/components/marketing/tools/sitemap-tool';
import { SocialPreview } from '@/components/marketing/tools/social-tool';
import catalog from '@/services/api/src/config/crawlers.json';

export const getStaticPaths = (() =>
  FREE_TOOLS.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }))) satisfies GetStaticPaths;

const { tool } = Astro.props;
// Project only the public catalog fields; no server configuration enters the browser.
const bots = catalog.bots.map((bot) => ({ label: bot.label, purpose: bot.purpose, tokens: bot.robots_tokens }));
---
<MarketingLayout title={`Free ${tool.title} | CiteLadder`} description={tool.description} canonical={`/tools/${tool.slug}`}>
  <main id="main">
    <PageHero title={tool.title} lead={tool.description} breadcrumb={[{ label: 'Free tools', href: '/tools' }, { label: tool.title }]}>
      <p class="cp-privacy">Your input is processed in this browser. Text and files are not uploaded or saved by this tool. Use up to 200,000 characters per text area.</p>
    </PageHero>
    <Section tone="soft" rhythm="tight" aria-label={tool.title}>
      <noscript><p class="website-body">Enable JavaScript to run this browser-based tool. No account is required.</p></noscript>
      {tool.slug === 'ai-crawler-checker' && <CrawlerChecker bots={bots} client:load />}
      {tool.slug === 'robots-txt-generator' && <RobotsGenerator bots={bots} client:load />}
      {tool.slug === 'meta-directive-checker' && <MetaChecker client:load />}
      {tool.slug === 'structured-data-builder' && <StructuredDataBuilder client:load />}
      {tool.slug === 'sitemap-comparison' && <SitemapComparison client:load />}
      {tool.slug === 'social-preview' && <SocialPreview client:load />}
    </Section>
    <ToolNotes slug={tool.slug} />
  </main>
</MarketingLayout>
