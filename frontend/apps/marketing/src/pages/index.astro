---
import { LandingPage } from '@/components/marketing/landing/landing-page';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import './landing.css';

const description =
  'AI visibility, citation analysis, site readiness and content intelligence in one connected workspace.';
---

<MarketingLayout
  title="AI search intelligence | CiteLadder"
  description={description}
  canonical="/"
>
  <main id="main">
    <LandingPage client:load />
  </main>
</MarketingLayout>
