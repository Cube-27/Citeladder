---
import { LandingPage } from '@/components/marketing/landing/landing-page';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import './landing.css';

const description =
  "Track AI visibility and citations, investigate website and search evidence, and prepare better content with CiteLadder's connected intelligence platform.";
---

<MarketingLayout
  title="AI Visibility & Search Intelligence Software | CiteLadder"
  description={description}
  canonical="/"
>
  <main id="main">
    <LandingPage client:load />
  </main>
</MarketingLayout>
