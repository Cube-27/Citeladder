---
import { LandingPage } from '@/components/marketing/landing/landing-page';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import './landing.css';

const description =
  "Track how ChatGPT, Gemini, Claude and Google AI Overviews mention and cite your brand, check your site and search data, and plan fixes with CiteLadder.";
---

<MarketingLayout
  title="AI visibility and search intelligence software | CiteLadder"
  description={description}
  canonical="/"
>
  <main id="main">
    <LandingPage client:load />
  </main>
</MarketingLayout>
