---
import { LandingPage } from '@/components/marketing/landing/landing-page';
import { HeroTour } from '@/components/marketing/landing/landing-tour';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import './landing.css';

const description =
  "Track how ChatGPT, Gemini, Claude and Google AI Overviews mention and cite your brand, check your site and search data, and plan fixes with CiteLadder.";
---

<MarketingLayout
  title="AI visibility and search intelligence software | CiteLadder"
  description={description}
  canonical="/"
>
  <main id="main">
    {/* Only the product tour hydrates; the rest of the page is static HTML. */}
    <LandingPage>
      <HeroTour slot="tour" client:load />
    </LandingPage>
  </main>
</MarketingLayout>
