---
import { LandingPage } from '@/components/marketing/landing/landing-page';
import { PAGES } from '@/lib/marketing-content/pages';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const page = PAGES.home;
---

<MarketingLayout title={page.metaTitle} description={page.description} canonical={page.path}>
  <main id="main">
    <LandingPage />
  </main>
</MarketingLayout>

<script>
  import { mountHeroVideo } from '@/components/marketing/landing/hero-video-mount';
  import { mountCardRail } from '@/components/marketing/sections/card-rail';

  document.querySelectorAll<HTMLElement>('[data-card-rail]').forEach(mountCardRail);
  document.querySelectorAll<HTMLElement>('[data-hero-video]').forEach(mountHeroVideo);
</script>
