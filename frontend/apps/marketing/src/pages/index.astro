---
import { LandingPage } from '@/components/marketing/landing/landing-page';
import { FAQS } from '@/components/marketing/landing/landing-data';
import { faqPageJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import './landing.css';

const description =
  'Track brand mentions, citations and competitor presence in AI answers. Connect visibility insights with source analysis and site health in CiteLadder.';
---

<MarketingLayout
  title="AI Visibility Software for Brands and Teams | CiteLadder"
  description={description}
  canonical="/"
  jsonLd={[faqPageJsonLd([{ heading: 'Homepage FAQ', items: FAQS.map(([q, a]) => ({ q, a })) }])]}
>
  <main id="main">
    <LandingPage client:load />
  </main>
</MarketingLayout>
