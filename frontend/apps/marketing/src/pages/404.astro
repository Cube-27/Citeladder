---
import { ButtonLink } from '@/components/marketing/primitives/button';
import { RelatedCards } from '@/components/marketing/sections/cards';
import { PageHero } from '@/components/marketing/sections/heroes';
import { PageSection } from '@/components/marketing/sections/page-section';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { NOT_FOUND_LINKS } from '../not-found';

// Home and Contact lead as buttons; the rest are the suggested pages.
const suggested = NOT_FOUND_LINKS.filter((link) => link.href !== '/' && link.href !== '/contact').map(
  (link) => ({ href: link.href, title: link.label, linkLabel: 'Open' }),
);
---

<MarketingLayout
  title="Page not found · CiteLadder"
  description="This CiteLadder page does not exist. Find the platform overview, pricing, documentation or contact details instead."
  robots="noindex"
>
  <main id="main">
    <PageHero
      eyebrow="404"
      title="We couldn't find that page"
      lead="It may have moved, or the link may be wrong. Try one of these pages instead."
      actions={
        <>
          <ButtonLink href="/" size="marketing">
            Home
          </ButtonLink>
          <ButtonLink href="/contact" variant="soft" size="marketing">
            Contact
          </ButtonLink>
        </>
      }
    />
    <PageSection spacing="compact" label="Suggested pages">
      <RelatedCards items={suggested} />
    </PageSection>
  </main>
</MarketingLayout>
