---
import { ContentCta } from '@/components/marketing/content/content-cta';
import ContentIndex from '@/components/marketing/content/ContentIndex.astro';
import { FeaturedPost, postMeta } from '@/components/marketing/content/featured-post';
import { RelatedCards } from '@/components/marketing/sections/cards';
import { PageHero } from '@/components/marketing/sections/heroes';
import { PageSection } from '@/components/marketing/sections/page-section';
import { BLOG_EMPTY_STATE, BLOG_START_PATHS, POSTS } from '@/lib/marketing-content/blog';
import { newestFirst, toBlogPostSummary } from '@/lib/marketing-content/blog-index';
import { formatSiteDate } from '@/lib/marketing-content/site-date';
import { blogIndexJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { STUDY_INDEXES } from '@/lib/marketing-content/studies/indexes';
import { RESEARCH_ARTICLES } from '../../research-articles';
import { studyGroups } from '../../study-index';

const research = STUDY_INDEXES.research;
const STUDY_SECTIONS = Object.values(STUDY_INDEXES).filter((index) => index.path !== research.path);

const description =
  'Learn how to measure AI visibility, investigate citations and audit website readiness. Practical guides with clear definitions, examples and limitations.';
const summaries = POSTS.map(toBlogPostSummary);
const jsonLd = blogIndexJsonLd({
  posts: summaries,
  guides: RESEARCH_ARTICLES.map(({ frontmatter }) => ({ title: frontmatter.title, path: frontmatter.slug })),
});
const [featured, ...rest] = newestFirst(POSTS);
---

<MarketingLayout
  title="AI visibility guides and citation tracking resources | CiteLadder"
  description={description}
  canonical="/blog"
  keywords={['AEO', 'answer-engine optimization', 'AI visibility', 'content evidence']}
  jsonLd={jsonLd ? [jsonLd] : []}
>
  <main id="main">
    <PageHero
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
      title="Practical guides to AI visibility"
      lead="How to build a baseline, trace the sources behind an answer and check that your website can be read. Start with the question your team is asking."
    />

    {
      featured ? (
        <>
          <PageSection label="Featured article" labelHeading spacing="compact">
            <FeaturedPost post={featured} />
          </PageSection>
          {rest.length > 0 && (
            <PageSection label="Blog articles">
              <ContentIndex
                groups={[
                  {
                    items: rest.map((post) => ({
                      title: post.title,
                      href: `/blog/${post.slug}`,
                      body: post.excerpt,
                      meta: postMeta(post),
                    })),
                  },
                ]}
              />
            </PageSection>
          )}
        </>
      ) : (
        <PageSection title={BLOG_EMPTY_STATE.heading} lead={BLOG_EMPTY_STATE.body} />
      )
    }

    <PageSection
      title="Start with the question you have"
      lead="Three guides cover the questions most teams ask first."
      spacing="compact"
    >
      <RelatedCards
        items={BLOG_START_PATHS.map((path) => ({
          href: `/blog/${path.slug}`,
          title: path.heading,
          body: path.body,
          linkLabel: path.label,
        }))}
      />
    </PageSection>

    {
      RESEARCH_ARTICLES.length > 0 && (
        <PageSection label="Research guides" spacing="compact">
          <ContentIndex
            groups={[
              {
                id: 'research-guides',
                title: 'Research guides',
                description:
                  'Long-form references on measuring AI visibility and tracking citations, each with its sources.',
                items: RESEARCH_ARTICLES.map(({ frontmatter }) => ({
                  title: frontmatter.title,
                  href: frontmatter.slug,
                  body: frontmatter.meta_description,
                  meta: `Reviewed ${formatSiteDate(frontmatter.reviewed_at)}`,
                })),
              },
            ]}
          />
        </PageSection>
      )
    }

    <PageSection label={research.heroTitle} spacing="compact">
      <ContentIndex
        groups={[
          ...studyGroups(research, `${research.path}/`),
          {
            id: 'study-sections',
            title: research.title,
            description: research.lead,
            items: STUDY_SECTIONS.map((index) => ({
              title: index.title,
              href: index.path,
              body: index.description,
            })),
          },
        ]}
      />
    </PageSection>

    <ContentCta
      title="Put the method into practice"
      lead="See how CiteLadder brings answer observations, source analysis and website findings into one workflow."
      secondary={{ href: '/compare', label: 'Compare AI visibility tools' }}
    />
  </main>
</MarketingLayout>
