---
import { BlogIndex } from '@/components/marketing/pages/blog';
import { POSTS } from '@/lib/marketing-content/blog';
import { toBlogPostSummary } from '@/lib/marketing-content/blog-index';
import { blogIndexJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { RESEARCH_ARTICLES } from '../../research-articles';

const description =
  'Learn how to measure AI visibility, investigate citations and audit website readiness. Practical guides with clear definitions, examples and limitations.';
const jsonLd = blogIndexJsonLd(POSTS.map(toBlogPostSummary));
---

<MarketingLayout
  title="AI Visibility Guides and Citation Tracking Resources | CiteLadder"
  description={description}
  canonical="/blog"
  keywords={['AEO', 'answer-engine optimization', 'AI visibility', 'content evidence']}
  jsonLd={jsonLd ? [jsonLd] : []}
>
  <main id="main">
    <BlogIndex client:visible researchGuides={RESEARCH_ARTICLES.map(({ frontmatter }) => ({ title: frontmatter.title, href: frontmatter.slug, description: frontmatter.meta_description }))} />
  </main>
</MarketingLayout>
