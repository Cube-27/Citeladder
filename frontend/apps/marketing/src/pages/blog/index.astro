---
import { BlogIndexExplorer } from '@/components/marketing/blog/blog-index-explorer';
import { BlogIndex } from '@/components/marketing/pages/blog';
import { POSTS } from '@/lib/marketing-content/blog';
import { toBlogPostSummary } from '@/lib/marketing-content/blog-index';
import { blogIndexJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { RESEARCH_ARTICLES } from '../../research-articles';

const description =
  'Learn how to measure AI visibility, investigate citations and audit website readiness. Practical guides with clear definitions, examples and limitations.';
const summaries = POSTS.map(toBlogPostSummary);
const jsonLd = blogIndexJsonLd({
  posts: summaries,
  guides: RESEARCH_ARTICLES.map(({ frontmatter }) => ({ title: frontmatter.title, path: frontmatter.slug })),
});
---

<MarketingLayout
  title="AI visibility guides and citation tracking resources | CiteLadder"
  description={description}
  canonical="/blog"
  keywords={['AEO', 'answer-engine optimization', 'AI visibility', 'content evidence']}
  jsonLd={jsonLd ? [jsonLd] : []}
>
  <main id="main">
    {/* Only the filter and sort list hydrates, with post summaries rather than full posts. */}
    <BlogIndex researchGuides={RESEARCH_ARTICLES.map(({ frontmatter }) => ({ title: frontmatter.title, href: frontmatter.slug, description: frontmatter.meta_description }))}>
      <BlogIndexExplorer slot="explorer" posts={summaries} client:visible />
    </BlogIndex>
  </main>
</MarketingLayout>
