---
import type { GetStaticPaths } from 'astro';
import { BlogPostView } from '@/components/marketing/pages/blog';
import { POSTS } from '@/lib/marketing-content/blog';
import { breadcrumbJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ResearchLayout from '../../layouts/ResearchLayout.astro';
import { RESEARCH_ARTICLES } from '../../research-articles';

export const getStaticPaths = (() => [
  ...POSTS.map((post) => ({ params: { slug: post.slug }, props: { kind: 'post' as const, post } })),
  ...RESEARCH_ARTICLES.filter((article) => article.frontmatter.slug.startsWith('/blog/')).map(
    (article) => ({
      params: { slug: article.frontmatter.slug.slice('/blog/'.length) },
      props: { kind: 'guide' as const, article },
    }),
  ),
]) satisfies GetStaticPaths;

const route = Astro.props;
const breadcrumb =
  route.kind === 'post'
    ? breadcrumbJsonLd([
        { name: 'Home', path: '/' },
        { name: 'Blog', path: '/blog' },
        { name: route.post.title, path: `/blog/${route.post.slug}` },
      ])
    : null;
---

{route.kind === 'guide' ? <ResearchLayout article={route.article} /> : <MarketingLayout
  title={route.post.seoTitle.endsWith(' | CiteLadder') ? route.post.seoTitle : `${route.post.seoTitle} · CiteLadder`}
  description={route.post.seoDescription}
  canonical={`/blog/${route.post.slug}`}
  keywords={[...route.post.tags, 'AI visibility', 'AEO']}
  openGraphType="article"
  image={route.post.image}
  publishedTime={route.post.date}
  modifiedTime={route.post.dateModified ?? route.post.date}
  author={route.post.author}
  tags={route.post.tags}
  twitterCard={route.post.image ? 'summary_large_image' : undefined}
  jsonLd={breadcrumb ? [breadcrumb] : []}
>
  <main id="main">
    <BlogPostView post={route.post} />
  </main>
</MarketingLayout>}
