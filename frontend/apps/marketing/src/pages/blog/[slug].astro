---
import type { GetStaticPaths } from 'astro';
import ArticleHeader from '@/components/content/ArticleHeader.astro';
import ArticlePager from '@/components/content/ArticlePager.astro';
import Prose from '@/components/content/Prose.astro';
import '@/components/marketing/content/reading.css';
import { Breadcrumbs } from '@/components/marketing/chrome/breadcrumbs';
import AuthorCard from '@/components/marketing/content/AuthorCard.astro';
import ContentArticle from '@/components/marketing/content/ContentArticle.astro';
import { headingId } from '@/components/marketing/content/heading-id';
import { PostBody } from '@/components/marketing/content/post-blocks';
import SourceRow from '@/components/marketing/content/SourceRow.astro';
import SourcesList from '@/components/marketing/content/SourcesList.astro';
import { ContentCta } from '@/components/marketing/content/content-cta';
import { RelatedCards } from '@/components/marketing/sections/cards';
import { PageSection } from '@/components/marketing/sections/page-section';
import { POSTS, type BlogPost } from '@/lib/marketing-content/blog';
import { formatSiteDate } from '@/lib/marketing-content/site-date';
import { blogPostingJsonLd, breadcrumbJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ResearchLayout from '../../layouts/ResearchLayout.astro';
import { RESEARCH_ARTICLES } from '../../research-articles';

export const getStaticPaths = (() => [
  ...POSTS.map((post) => ({ params: { slug: post.slug }, props: { kind: 'post' as const, post } })),
  ...RESEARCH_ARTICLES.filter((article) => article.frontmatter.slug.startsWith('/blog/')).map(
    (article) => ({
      params: { slug: article.frontmatter.slug.slice('/blog/'.length) },
      props: { kind: 'guide' as const, article },
    }),
  ),
]) satisfies GetStaticPaths;

const route = Astro.props;

function postView(post: BlogPost) {
  const updated = post.dateModified && post.dateModified !== post.date ? post.dateModified : null;
  const index = POSTS.findIndex((candidate) => candidate.slug === post.slug);
  const link = (candidate: BlogPost | undefined) =>
    candidate && { title: candidate.title, href: `/blog/${candidate.slug}` };
  return {
    breadcrumb: breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: post.title, path: `/blog/${post.slug}` },
    ]),
    posting: { ...blogPostingJsonLd(post), articleSection: post.tags, keywords: post.tags },
    meta: [
      ...(post.date
        ? [{ prefix: 'Published', text: formatSiteDate(post.date), dateTime: post.date }]
        : []),
      ...(updated ? [{ prefix: 'Updated', text: formatSiteDate(updated), dateTime: updated }] : []),
      ...(post.readTime ? [{ text: post.readTime }] : []),
    ],
    related: post.relatedSlugs
      .map((slug) => POSTS.find((candidate) => candidate.slug === slug))
      .filter((candidate): candidate is BlogPost => candidate !== undefined),
    previous: link(index > 0 ? POSTS[index - 1] : undefined),
    next: link(index >= 0 ? POSTS[index + 1] : undefined),
    toc: post.body.flatMap((block) =>
      block.type === 'heading' ? [{ id: headingId(block.text), label: block.text, level: 2 }] : [],
    ),
  };
}
const view = route.kind === 'post' ? postView(route.post) : null;
---

{
  route.kind === 'guide' ? (
    <ResearchLayout article={route.article} />
  ) : (
    view && (
      <MarketingLayout
        title={
          route.post.seoTitle.endsWith(' | CiteLadder')
            ? route.post.seoTitle
            : `${route.post.seoTitle} · CiteLadder`
        }
        description={route.post.seoDescription}
        canonical={`/blog/${route.post.slug}`}
        keywords={[...route.post.tags, 'AI visibility', 'AEO']}
        openGraphType="article"
        image={route.post.image}
        publishedTime={route.post.date}
        modifiedTime={route.post.dateModified ?? route.post.date}
        author={route.post.author}
        tags={route.post.tags}
        twitterCard={route.post.image ? 'summary_large_image' : undefined}
        jsonLd={[view.posting, ...(view.breadcrumb ? [view.breadcrumb] : [])]}
      >
        <main id="main">
          <ContentArticle toc={view.toc}>
            <ArticleHeader
              slot="header"
              title={route.post.title}
              tags={route.post.tags}
              author={
                route.post.author
                  ? { name: route.post.author, role: route.post.authorRole }
                  : undefined
              }
              meta={view.meta}
            >
              <Breadcrumbs
                slot="crumbs"
                items={[
                  { label: 'Home', href: '/' },
                  { label: 'Blog', href: '/blog' },
                  { label: route.post.title },
                ]}
              />
              {route.post.excerpt}
              {route.post.editorialNote && (
                <p slot="note" class="cl-ahead-note">
                  {route.post.editorialNote}
                </p>
              )}
            </ArticleHeader>
            <Prose as="article" label="Post content">
              <PostBody blocks={route.post.body} sources={route.post.sources} />
            </Prose>
            <Fragment slot="end">
              {route.post.sources.length > 0 && (
                <SourcesList count={route.post.sources.length}>
                  {route.post.sources.map((source, index) => (
                    <SourceRow n={index + 1} href={source.url}>
                      <p>
                        <a href={source.url} target="_blank" rel="noreferrer">
                          {source.title}
                        </a>
                        {`, ${source.publisher}`}
                        {source.publishedDate ? ` (${formatSiteDate(source.publishedDate)})` : null}
                      </p>
                    </SourceRow>
                  ))}
                </SourcesList>
              )}
              {route.post.author && (
                <AuthorCard
                  name={route.post.author}
                  role={route.post.authorRole}
                  links={route.post.authorUrl ? [{ label: 'LinkedIn', href: route.post.authorUrl }] : []}
                />
              )}
              {(view.previous || view.next) && (
                <ArticlePager
                  previous={view.previous}
                  next={view.next}
                  label="Previous and next articles"
                />
              )}
            </Fragment>
          </ContentArticle>
          {view.related.length > 0 && (
            <PageSection title="Related reading" spacing="compact">
              <RelatedCards
                items={view.related.map((post) => ({
                  href: `/blog/${post.slug}`,
                  eyebrow: post.tags[0],
                  title: post.title,
                  body: post.excerpt,
                }))}
              />
            </PageSection>
          )}
          <ContentCta
            title={route.post.closing?.heading ?? 'Make AI visibility measurable'}
            lead={route.post.closing?.body ?? 'Measure AI visibility with evidence your team can inspect.'}
            secondary={route.post.closing?.secondary ?? { href: '/blog', label: 'Blog' }}
          />
        </main>
      </MarketingLayout>
    )
  )
}

<style>
  .cl-ahead-note {
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
  }
</style>
