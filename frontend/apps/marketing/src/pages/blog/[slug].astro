---
import type { GetStaticPaths } from 'astro';
import { BlogPostView } from '@/components/marketing/pages/blog';
import { POSTS } from '@/lib/marketing-content/blog';
import { breadcrumbJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ResearchLayout from '../../layouts/ResearchLayout.astro';
import { RESEARCH_ARTICLES } from '../../research-articles';

export const getStaticPaths = (() => [
  ...POSTS.map((post) => ({ params: { slug: post.slug }, props: { post, article: undefined } })),
  ...RESEARCH_ARTICLES.filter((article) => article.frontmatter.slug.startsWith('/blog/')).map(
    (article) => ({
      params: { slug: article.frontmatter.slug.slice('/blog/'.length) },
      props: { post: undefined, article },
    }),
  ),
]) satisfies GetStaticPaths;

const { post, article } = Astro.props;
const breadcrumb = post
  ? breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: post.title, path: `/blog/${post.slug}` },
    ])
  : null;
---

{article ? <ResearchLayout article={article} /> : post && <MarketingLayout
  title={post.seoTitle.endsWith(' | CiteLadder') ? post.seoTitle : `${post.seoTitle} · CiteLadder`}
  description={post.seoDescription}
  canonical={`/blog/${post.slug}`}
  keywords={[...post.tags, 'AI visibility', 'AEO']}
  openGraphType="article"
  image={post.image}
  publishedTime={post.date}
  modifiedTime={post.dateModified ?? post.date}
  author={post.author}
  tags={post.tags}
  twitterCard={post.image ? 'summary_large_image' : undefined}
  jsonLd={breadcrumb ? [breadcrumb] : []}
>
  <main id="main">
    <BlogPostView post={post} />
  </main>
</MarketingLayout>}
