---
import { PricingCta, PricingFaq } from '@/components/marketing/pages/pricing';
import { PublicPricingCatalog } from '@/components/marketing/pricing/public-pricing-catalog';
import { PageHero } from '@/components/marketing/primitives/page-hero';
import { Section, SectionHeader } from '@/components/marketing/primitives/section';
import { selfServeCheckoutComingSoon } from '@/lib/billing/catalog';
import { displayCountry, publicCatalog } from '../public-catalog';
import { workerApexEnv } from '../worker-env';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const env = workerApexEnv();
const catalog = await publicCatalog(env, displayCountry(Astro.request.headers));
const checkoutClosed = catalog !== null && selfServeCheckoutComingSoon(catalog);
const description = checkoutClosed
  ? 'CiteLadder plans, trial limits and access options for AI visibility tracking. Paid self-serve checkout is not currently open.'
  : 'Explore CiteLadder plans, provider-key usage and early-access options. Review published limits and confirm availability before choosing a plan.';
const initialByok = Astro.url.searchParams.get('byok') !== '0';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<MarketingLayout
  title="AI visibility software pricing | CiteLadder"
  description={description}
  canonical="/pricing"
>
  <main id="main" class="w-full max-w-full min-w-0 overflow-x-clip">
    <PageHero
      title="No markup on model calls made with your keys."
      lead="When you use your own provider keys, model calls bill to your provider accounts at provider rates. CiteLadder charges for the workspace, the analysis and the evidence behind every recommendation."
      centered
    />
    {catalog ? (
      <PublicPricingCatalog catalog={catalog} appOrigin={env.PUBLIC_APP_ORIGIN} initialByok={initialByok} client:load />
    ) : (
      <Section rhythm="tight" className="pt-0" aria-label="Plans">
        <SectionHeader
          title="Plans are temporarily unavailable."
          lead="Please try again shortly. No price is shown while the public catalog is unavailable."
          size="h3"
          align="center"
        />
      </Section>
    )}
    <PricingFaq />
    <PricingCta />
  </main>
</MarketingLayout>
