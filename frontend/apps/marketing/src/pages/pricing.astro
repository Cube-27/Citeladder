---
import { PricingCta } from '@/components/marketing/pages/pricing';
import { PricingComingSoonStrip } from '@/components/marketing/pricing/pricing-coming-soon-strip';
import { PublicPricingCatalog } from '@/components/marketing/pricing/public-pricing-catalog';
import { PageHero } from '@/components/marketing/primitives/page-hero';
import { TrustStrip } from '@/components/marketing/primitives/trust-strip';
import { publicCatalog } from '../public-catalog';
import { workerApexEnv } from '../worker-env';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const description =
  'Self-serve CiteLadder plans plus Enterprise. You pay for the workspace and the evidence. Model usage bills to your own provider keys, never marked up.';
const env = workerApexEnv();
const catalog = await publicCatalog(env);
const initialByok = Astro.url.searchParams.get('byok') !== '0';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<MarketingLayout
  title="CiteLadder pricing for AI visibility · CiteLadder"
  description={description}
  canonical="/pricing"
>
  <main id="main" class="w-full max-w-full min-w-0 overflow-x-clip">
    <PageHero
      eyebrow="Pricing"
      title="Pay for the intelligence."
      accent="Not the API markup."
      lead="Model calls run on your own provider keys. Usage bills straight to your accounts at provider rates. CiteLadder charges for the workspace, the intelligence, and the evidence behind every recommendation."
      centered
    >
      <TrustStrip className="mt-8 justify-center" />
    </PageHero>
    <PricingComingSoonStrip />
    {catalog ? (
      <PublicPricingCatalog catalog={catalog} appOrigin={env.PUBLIC_APP_ORIGIN} initialByok={initialByok} client:load />
    ) : (
      <section aria-label="Plans" class="mx-auto max-w-5xl p-8">
        <h2 class="website-section-heading">Plans are temporarily unavailable.</h2>
        <p class="website-body text-muted">Please try again shortly. No price is shown while the public catalog is unavailable.</p>
      </section>
    )}
    <PricingCta />
  </main>
</MarketingLayout>
