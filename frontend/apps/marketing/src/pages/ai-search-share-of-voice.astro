---
import { CommercialEntryPage } from '@/components/marketing/pages/commercial';
import { ProductModule } from '@/components/marketing/pages/platform';
import { SHARE_OF_VOICE_PAGE } from '@/lib/marketing-content/commercial-pages';
import { breadcrumbJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'AI share of voice', path: '/ai-search-share-of-voice' },
]);
---

<MarketingLayout
  title="AI search share of voice tracking | CiteLadder"
  description="Compare your brand with competitors across a consistent set of AI prompts. See the recorded answers behind each visibility change."
  canonical="/ai-search-share-of-voice"
  jsonLd={breadcrumb ? [breadcrumb] : []}
>
  <main id="main">
    <CommercialEntryPage page={SHARE_OF_VOICE_PAGE}>
      <ProductModule path="/platform/ai-visibility" heading="Compare brand presence with the answer in view">
        Use CiteLadder AI Visibility to review your selected prompt portfolio, compare recorded brand observations and inspect the responses behind a change. Keep the competitor set, collection conditions and successful-answer coverage visible.
      </ProductModule>
    </CommercialEntryPage>
  </main>
</MarketingLayout>
