---
import { CommercialEntryPage } from '@/components/marketing/content/commercial-page';
import { SHARE_OF_VOICE_PAGE } from '@/lib/marketing-content/commercial-pages';
import { PAGES } from '@/lib/marketing-content/pages';
import { breadcrumbJsonLd, faqPageJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const page = PAGES.shareOfVoice;
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'AI share of voice', path: page.path },
]);
---

<MarketingLayout
  title={page.metaTitle}
  description={page.description}
  canonical={page.path}
  jsonLd={[...(breadcrumb ? [breadcrumb] : []), faqPageJsonLd(SHARE_OF_VOICE_PAGE.faqs)]}
>
  <main id="main">
    <CommercialEntryPage
      page={SHARE_OF_VOICE_PAGE}
      product={{
        heading: 'Compare brand presence with the answer in view',
        body: 'Use CiteLadder AI Visibility to review your selected prompt portfolio, compare recorded brand observations and inspect the responses behind a change. Keep the competitor set, collection conditions and successful-answer coverage visible.',
        href: '/platform/ai-visibility',
      }}
    />
  </main>
</MarketingLayout>
