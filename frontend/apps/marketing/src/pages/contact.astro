---
import { ContactPage } from '@/components/marketing/pages/contact';
import MarketingLayout from '../layouts/MarketingLayout.astro';

// Only this page loads the Turnstile widget and its challenge frame.
Astro.csp.insertScriptResource('https://challenges.cloudflare.com');
Astro.csp.insertDirective('frame-src https://challenges.cloudflare.com');
---

<MarketingLayout
  title="Contact CiteLadder"
  description="Get in touch with CiteLadder for product questions, demos, partnerships, or help evaluating AI search visibility for your business."
  canonical="/contact"
>
  <ContactPage client:load />
</MarketingLayout>
