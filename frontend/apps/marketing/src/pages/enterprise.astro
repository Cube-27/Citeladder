---
import {
  EnterpriseContactCta,
  EnterpriseDataFlow,
  EnterpriseEvidence,
  EnterpriseFit,
  EnterpriseGovernance,
  EnterpriseHero,
  EnterpriseLimits,
} from '@/components/marketing/pages/enterprise';
import { absoluteUrl } from '@/lib/seo/site';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const description =
  'Enterprise AEO platform with auditable scoring: every result traces to a stored answer, the scoring code is public under AGPL-3.0, keys are yours and evidence stays in your workspace.';
const enterpriseUrl = absoluteUrl('/enterprise');
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'CiteLadder Enterprise',
  serviceType: 'AI visibility measurement',
  description,
  ...(enterpriseUrl ? { url: enterpriseUrl } : {}),
  provider: { '@type': 'Organization', name: 'CiteLadder' },
};
---

<MarketingLayout
  title="Enterprise AEO platform with auditable scoring | CiteLadder"
  description={description}
  canonical="/enterprise"
  jsonLd={[serviceJsonLd]}
>
  <main id="main">
    <EnterpriseHero />
    <EnterpriseEvidence />
    <EnterpriseGovernance />
    <EnterpriseDataFlow />
    <EnterpriseFit />
    <EnterpriseLimits />
    <EnterpriseContactCta />
  </main>
</MarketingLayout>
