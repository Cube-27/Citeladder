---
import { EnterprisePage } from '@/components/marketing/pages/enterprise';
import { PAGES } from '@/lib/marketing-content/pages';
import { absoluteUrl } from '@/lib/seo/site';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const page = PAGES.enterprise;
const description = page.description;
const enterpriseUrl = absoluteUrl(page.path);
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'CiteLadder Enterprise',
  serviceType: 'AI visibility measurement',
  description,
  ...(enterpriseUrl ? { url: enterpriseUrl } : {}),
  provider: { '@type': 'Organization', name: 'CiteLadder' },
};
---

<MarketingLayout
  title={page.metaTitle}
  description={description}
  canonical={page.path}
  jsonLd={[serviceJsonLd]}
>
  <main id="main">
    <EnterprisePage />
  </main>
</MarketingLayout>
