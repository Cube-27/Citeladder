---
/**
 * The FAQ (the WebFaq template): ContentArticle with a Toc titled Topics,
 * the ArticleHeader, each group's heading and FaqList in Prose, then the
 * closing band.
 */
import ArticleHeader from '@/components/content/ArticleHeader.astro';
import Prose from '@/components/content/Prose.astro';
import { Breadcrumbs } from '@/components/marketing/chrome/breadcrumbs';
import ContentArticle from '@/components/marketing/content/ContentArticle.astro';
import { ContentCta } from '@/components/marketing/content/content-cta';
import { FAQ_TOPICS, FaqGroups } from '@/components/marketing/content/faq-groups';
import { FAQ_GROUPS } from '@/lib/marketing-content/faq';
import { faqPageJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const description =
  'Understand how CiteLadder tracks AI visibility, what mentions and citations mean, and how to interpret observed results alongside your other analytics.';
---

<MarketingLayout
  title="AI visibility and citation tracking FAQ | CiteLadder"
  description={description}
  canonical="/faq"
  jsonLd={[faqPageJsonLd(FAQ_GROUPS.flatMap((group) => group.items))]}
>
  <main id="main">
    <ContentArticle toc={FAQ_TOPICS} tocTitle="Topics">
      <ArticleHeader slot="header" title="Frequently asked questions">
        <Breadcrumbs slot="crumbs" items={[{ label: 'Home', href: '/' }, { label: 'Frequently asked questions' }]} />
        Short answers on AEO, AI visibility, evidence, security and billing, written by the product team at Cube27.
      </ArticleHeader>
      <Prose as="article" label="Frequently asked questions">
        <FaqGroups />
      </Prose>
    </ContentArticle>
    <ContentCta
      title="Still have a question?"
      lead="Ask us directly, or see the product on your own category."
      secondary={{ href: '/pricing', label: 'See pricing' }}
    />
  </main>
</MarketingLayout>
