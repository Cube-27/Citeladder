---
import { FaqGroups } from '@/components/marketing/pages/faq';
import { PageHero } from '@/components/marketing/primitives/page-hero';
import { FAQ_GROUPS } from '@/lib/marketing-content/faq';
import { faqPageJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const description =
  'Understand how CiteLadder tracks AI visibility, what mentions and citations mean, and how to interpret observed results alongside your other analytics.';
---

<MarketingLayout
  title="AI Visibility and Citation Tracking FAQ | CiteLadder"
  description={description}
  canonical="/faq"
  jsonLd={[faqPageJsonLd(FAQ_GROUPS)]}
>
  <main id="main">
    <PageHero
      eyebrow="FAQ"
      title="Frequently asked"
      accent="questions."
      lead="Short answers on AEO, AI visibility, evidence, security, and billing. Written by the product team at Cube27."
    />
    <FaqGroups />
  </main>
</MarketingLayout>
