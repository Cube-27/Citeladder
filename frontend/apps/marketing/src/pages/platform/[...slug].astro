---
import type { GetStaticPaths } from 'astro';
import { PlatformPageContent } from '@/components/marketing/pages/platform';
import { PLATFORM_PAGES } from '@/lib/marketing-content/platform-pages';
import { PUBLISHED_PLATFORM } from '@/lib/marketing-content/nav';
import { breadcrumbJsonLd, faqPageJsonLd, platformWebPageJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';

// Only published destinations are built; held capability pages have no file and 404.
export const getStaticPaths = (() =>
  PUBLISHED_PLATFORM.flatMap((item) => {
    const page = PLATFORM_PAGES.find((candidate) => candidate.path === item.href);
    if (!page) return [];
    const slug = page.path === '/platform' ? undefined : page.path.slice('/platform/'.length);
    return [{ params: { slug }, props: { page, label: item.title } }];
  })) satisfies GetStaticPaths;

const { page, label } = Astro.props;
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Platform overview', path: '/platform' },
  ...(page.path === '/platform' ? [] : [{ name: label, path: page.path }]),
]);
const webPage = platformWebPageJsonLd(page);
// Mirrors the FAQ the page renders, from the same reviewed copy.
const faq = faqPageJsonLd([{ heading: label, items: page.faqs }]);
---
<MarketingLayout title={page.title} description={page.description} canonical={page.path} jsonLd={[...(breadcrumb ? [breadcrumb] : []), ...(webPage ? [webPage] : []), faq]}>
  <main id="main">
    {/* The MCP page's connect strip copies and opens menus, so that page hydrates. */}
    {page.cta === 'mcp' ? <PlatformPageContent page={page} client:load /> : <PlatformPageContent page={page} />}
  </main>
</MarketingLayout>
