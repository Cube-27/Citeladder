---
import { SolutionSegments, SolutionsCta, SolutionsHero } from '@/components/marketing/pages/solutions';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const title = 'AI Visibility Workflows for Marketing Teams | CiteLadder';
const description =
  'Explore AI visibility workflows for agencies, in-house teams and ecommerce brands. Connect tracked answers, cited sources and website investigations.';
---

<MarketingLayout title={title} description={description} canonical="/solutions">
  <main id="main">
    <SolutionsHero />
    <SolutionSegments client:load />
    <SolutionsCta />
  </main>
</MarketingLayout>
