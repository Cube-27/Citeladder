---
import { SolutionSegments, SolutionsCta, SolutionsHero } from '@/components/marketing/pages/solutions';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const title = 'AI visibility for agencies, in-house teams, and ecommerce · CiteLadder';
const description =
  'How agencies, in-house marketers, founders, ecommerce, and PR teams use AI visibility evidence they can re-check, not screenshots.';
---

<MarketingLayout title={title} description={description} canonical="/solutions">
  <main id="main">
    <SolutionsHero />
    <SolutionSegments />
    <SolutionsCta />
  </main>
</MarketingLayout>
