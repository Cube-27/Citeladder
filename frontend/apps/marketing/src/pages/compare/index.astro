---
import { CompareIndex } from '@/components/marketing/pages/compare';
import { COMPETITORS } from '@/lib/marketing-content/compare';
import { compareIndexJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';

const description =
  'Compare CiteLadder with Profound, Otterly AI, Scrunch and Peec AI. Review product focus, evaluation questions and current first-party sources.';
const jsonLd = compareIndexJsonLd(COMPETITORS);
---

<MarketingLayout
  title="Compare AI Visibility Software and Workflows | CiteLadder"
  description={description}
  canonical="/compare"
  jsonLd={jsonLd ? [jsonLd] : []}
>
  <main id="main">
    <CompareIndex />
  </main>
</MarketingLayout>
