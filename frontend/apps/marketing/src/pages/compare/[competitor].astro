---
import type { GetStaticPaths } from 'astro';
import { CompareDetailView } from '@/components/marketing/pages/compare-detail';
import { COMPETITORS } from '@/lib/marketing-content/compare';
import { breadcrumbJsonLd } from '@/lib/seo/json-ld';
import MarketingLayout from '../../layouts/MarketingLayout.astro';

export const getStaticPaths = (() =>
  COMPETITORS.map((competitor) => ({
    params: { competitor: competitor.slug },
    props: { competitor },
  }))) satisfies GetStaticPaths;

const { competitor } = Astro.props;
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare' },
  { name: `CiteLadder vs ${competitor.name}`, path: `/compare/${competitor.slug}` },
]);
---

<MarketingLayout
  title={competitor.metaTitle}
  description={competitor.metaDescription}
  canonical={`/compare/${competitor.slug}`}
  jsonLd={breadcrumb ? [breadcrumb] : []}
>
  <main id="main">
    <CompareDetailView competitor={competitor} />
  </main>
</MarketingLayout>
