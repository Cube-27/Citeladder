---
import { ArrowRight } from 'lucide-react';
import type { ResearchArticle } from '../research-articles';
import { RESEARCH_ARTICLES } from '../research-articles';
import { ResearchMarkdown, researchHeadings } from '@/components/marketing/blog/research-markdown';
import { Container } from '@/components/marketing/primitives/section';
import { formatBlogDate } from '@/lib/marketing-content/blog-index';

interface Props { article: ResearchArticle }
const { article } = Astro.props;
const { frontmatter } = article;
const headings = researchHeadings(article.markdown);
// The next guides in publication order, wrapping, so every guide ends with a way on.
const position = RESEARCH_ARTICLES.findIndex((candidate) => candidate.frontmatter.slug === frontmatter.slug);
const more = [1, 2]
  .map((step) => RESEARCH_ARTICLES[(position + step) % RESEARCH_ARTICLES.length])
  .filter((candidate) => candidate && candidate.frontmatter.slug !== frontmatter.slug);
---

<Container>
  <div class="cp-article">
    <header class="cp-article-head">
      <nav aria-label="Breadcrumb" class="cp-crumbs">
        <ol>
          <li><a href="/" class="focus-ring rounded-xs">Home</a></li>
          <li><a href="/blog" class="focus-ring rounded-xs">Guides</a></li>
        </ol>
      </nav>
      <h1 class="website-page-title website-article-title">{frontmatter.title}</h1>
      <p class="website-lead text-muted max-w-[62ch]">{frontmatter.meta_description}</p>
      <p class="cp-meta cp-byline">
        <span>Research reviewed <time datetime={frontmatter.reviewed_at}>{formatBlogDate(frontmatter.reviewed_at)}</time></span>
      </p>
    </header>
    <div class="cp-article-grid">
      <aside>
        <nav aria-label="On this page" class="cp-toc">
          <p class="website-label">On this page</p>
          <ol>
            {headings.map((heading) => <li><a class="focus-ring" href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
          <slot name="contents" />
        </nav>
      </aside>
      <article aria-label="Guide content" class="cp-prose">
        <ResearchMarkdown markdown={article.markdown} />
        <slot />
        {more.length > 0 && (
          <div class="cp-article-end">
            <section aria-labelledby="more-guides" class="grid gap-5">
              <h2 id="more-guides" class="website-feature-heading">More guides</h2>
              <ul class="grid gap-4 sm:grid-cols-2">
                {more.map((guide) => (
                  <li>
                    <a href={guide.frontmatter.slug} class="mk-related-card focus-ring">
                      <span class="cp-link-title pr-6">{guide.frontmatter.title}</span>
                      <span class="cp-link-desc line-clamp-3">{guide.frontmatter.meta_description}</span>
                      <ArrowRight aria-hidden="true" className="mk-related-arrow size-4" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        )}
      </article>
    </div>
  </div>
</Container>
