---
import type { ResearchArticle } from '../research-articles';
import { ResearchMarkdown, researchHeadings } from '@/components/marketing/blog/research-markdown';
import { Container } from '@/components/marketing/primitives/section';
import { formatBlogDate } from '@/lib/marketing-content/blog-index';

interface Props { article: ResearchArticle }
const { article } = Astro.props;
const { frontmatter } = article;
const headings = researchHeadings(article.markdown);
---

<header class="border-border-subtle border-b pt-16 pb-8 md:pb-10">
  <Container>
    <div class="mx-auto max-w-5xl text-center">
      <nav aria-label="Breadcrumb" class="website-label text-muted mb-5">
        <a href="/">Home</a> / <a href="/blog">Guides</a> / <span>{frontmatter.title}</span>
      </nav>
      <h1 class="website-page-title text-foreground mx-auto max-w-4xl text-balance">{frontmatter.title}</h1>
      <p class="website-label text-muted mt-5">
        Research reviewed <time datetime={frontmatter.reviewed_at}>{formatBlogDate(frontmatter.reviewed_at)}</time>
      </p>
    </div>
  </Container>
</header>
<Container>
  <div class="grid w-full gap-10 py-8 md:py-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-14">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <nav aria-label="On this page">
        <p class="website-eyebrow text-muted mb-3">Contents</p>
        <ol class="grid gap-2">
          {headings.map((heading) => <li><a class="text-muted hover:text-foreground text-sm" href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ol>
        <slot name="contents" />
      </nav>
    </aside>
    <article aria-label="Guide content" class="research-prose min-w-0">
      <ResearchMarkdown markdown={article.markdown} />
      <slot />
    </article>
  </div>
</Container>
