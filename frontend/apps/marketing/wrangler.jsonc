{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "citeladder-marketing",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "citeladder.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "secrets": { "required": ["ORIGIN_TOKEN"] },
  "vars": {
    "ORIGIN_UPSTREAM": "https://origin.citeladder.com",
    "PUBLIC_WEBSITE_HOST": "citeladder.com",
    "PUBLIC_APP_ORIGIN": "https://app.citeladder.com",
  },
}
