{
  admin off
  auto_https off
}

# Local Compose only. Production docs are the static-assets Worker in
# wrangler.jsonc; this serves the same built output at docs.localhost.
:4322 {
  encode zstd gzip

  handle /health {
    header Cache-Control "no-store"
    header Content-Type "application/json"
    respond `{"status":"ok"}` 200
  }

  handle {
    root * /srv
    # file_server redirects directory paths to their trailing slash, matching
    # the Worker's auto-trailing-slash handling.
    file_server
  }

  handle_errors {
    @missing expression {err.status_code} == 404
    handle @missing {
      root * /srv
      rewrite * /404.html
      file_server
    }
  }
}
