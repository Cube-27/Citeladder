---
import type { ApiOperation } from '../lib/api-reference';
import ApiMethod from './ApiMethod.astro';
import ParamTable from './ParamTable.astro';
import { LockKeyhole } from '@/lib/icons';
import Prose from '@/components/content/Prose.astro';
import TypeLabel from './TypeLabel.astro';

interface Props {
  operation: ApiOperation;
}
const { operation } = Astro.props;
const { request, response } = operation;
const segments = operation.path.split(/(\{[^}]+\})/).filter(Boolean);
const responseTitle = response.status ? `Response ${response.status}` : 'Response';
---

<div class="cl-docs-endpoint-text">
    <p class="cl-docs-endpoint-line">
      <ApiMethod method={operation.method} />
      <code class="cl-docs-endpoint-path">
        {
          segments.map((segment) =>
            segment.startsWith('{') ? <span class="cl-docs-endpoint-param">{segment}</span> : segment,
          )
        }
      </code>
    </p>
    {
      operation.scope && (
        <p class="cl-docs-endpoint-scope">
          <LockKeyhole className="my-0.5 size-4 shrink-0" aria-hidden />
          <span>
            Needs the <code>{operation.scope}</code> scope
          </span>
        </p>
      )
    }
    <Prose variant="docs"><p>{operation.description}</p></Prose>
    {
      operation.parameters.map((group) => (
        <ParamTable title={group.title} rows={group.rows} location={group.location} />
      ))
    }
    {
      request &&
        (request.rows.length > 0 ? (
          <ParamTable title="Request body" rows={request.rows} location="body" />
        ) : (
          <p class="cl-docs-endpoint-body">
            Request body: <TypeLabel parts={request.type} />
          </p>
        ))
    }
    {
      response.body && response.body.rows.length > 0 ? (
        <ParamTable title={responseTitle} rows={response.body.rows} />
      ) : (
        <p class="cl-docs-endpoint-body">
          {responseTitle}: {response.body ? <TypeLabel parts={response.body.type} /> : 'no body'}
        </p>
      )
    }
</div>

<style>
  .cl-docs-endpoint-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    max-width: var(--container-prose);
  }
  .cl-docs-endpoint-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    min-height: var(--control-lg);
    margin: 0;
    padding: 8px 12px;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-md);
  }
  .cl-docs-endpoint-path {
    color: var(--text-color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    overflow-wrap: anywhere;
  }
  .cl-docs-endpoint-param {
    color: var(--text-color-ink-2);
  }
  .cl-docs-endpoint-scope {
    display: flex;
    gap: 8px;
    margin: 0;
    color: var(--text-color-ink-2);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
  }
  .cl-docs-endpoint-body {
    color: var(--text-color-ink-2);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
  }
  .cl-docs-endpoint-body :global(code),
  .cl-docs-endpoint-scope :global(code) {
    color: var(--text-color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-data--line-height);
  }
  .cl-docs-endpoint-body :global(a) {
    color: var(--text-color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-control-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>
