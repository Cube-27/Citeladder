---
/**
 * ArticleHeader — the head of a docs page: the group it belongs to as an
 * eyebrow, the page's one h1 (`display-2xl`, 44/48; 36/42 from 768 to 1023px;
 * 30/36 below), the lead (`lead`, 20/30; 18/28 below 768px), and the updated
 * date in mono `ink-muted` between two `line` hairlines. Prose-wide.
 */
import { updatedLabel } from '../lib/structured-data';

interface Props {
  title: string;
  eyebrow?: string;
  /** ISO date of the last content change. */
  updated?: string;
}
const { title, eyebrow, updated } = Astro.props;
---

<header class="cl-ahead">
  {eyebrow && <p class="type-eyebrow">{eyebrow}</p>}
  <h1 class="cl-ahead-title">{title}</h1>
  <p class="cl-ahead-lead"><slot /></p>
  {
    updated && (
      <div class="cl-ahead-byline">
        <p class="cl-ahead-meta">
          Updated <time datetime={updated}>{updatedLabel(updated)}</time>
        </p>
      </div>
    )
  }
</header>

<style>
  .cl-ahead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: var(--container-prose);
  }
  .cl-ahead-title {
    font-family: var(--font-display);
    font-size: var(--text-display-2xl);
    line-height: var(--text-display-2xl--line-height);
    font-weight: 400;
    letter-spacing: var(--text-display-2xl--letter-spacing);
    color: var(--color-ink);
    text-wrap: balance;
  }
  .cl-ahead-lead {
    color: var(--color-ink-secondary);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .cl-ahead-lead :global(a) {
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .cl-ahead-byline {
    width: 100%;
    margin-top: 12px;
    padding: 20px 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .cl-ahead-meta {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-data--line-height);
  }
  @media (max-width: 1023px) {
    .cl-ahead-title {
      font-size: var(--text-display-xl);
      line-height: var(--text-display-xl--line-height);
    }
  }
  @media (max-width: 767px) {
    .cl-ahead-title {
      font-size: var(--text-display-md);
      line-height: var(--text-display-md--line-height);
    }
    .cl-ahead-lead {
      font-size: var(--text-body-lg);
      line-height: var(--text-body-lg--line-height);
    }
  }
</style>
