---
import type { ApiOperation } from '../lib/api-reference';
import { schemaHref, type ReferenceRow } from '../lib/json-schema';

interface Props {
  title: string;
  rows: readonly ReferenceRow[];
  location?: ApiOperation['parameters'][number]['location'] | 'body';
}
const { title, rows, location } = Astro.props;
const described = rows.some((row) => row.description || row.values.length || row.defaultValue);
---

<div class="cl-docs-params">
  <h4 class="cl-docs-sub">{title}</h4>
  <div class="cl-docs-params-frame">
    <table class:list={['cl-docs-params-table', { 'is-described': described }]}>
      <caption class="sr-only">{title}</caption>
      <thead>
        <tr>
          <th scope="col">Parameter</th>
          {described && <th scope="col">Description</th>}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td>
                <div class="cl-docs-param">
                  <code class="cl-docs-param-name">{row.name}</code>
                  <span class="cl-docs-param-meta">
                    <span class="cl-docs-param-tag">
                      {row.type.map((part) =>
                        part.schema ? <a href={schemaHref(part.schema)}>{part.text}</a> : part.text,
                      )}
                    </span>
                    {location && <span class="cl-docs-param-tag">{location}</span>}
                    {row.required && <span class="cl-docs-param-tag is-required">required</span>}
                  </span>
                </div>
              </td>
              {described && (
                <td>
                  <div class="cl-docs-param-desc">
                    {row.description && (
                      <span>
                        {row.description
                          .split('`')
                          .map((part, index) => (index % 2 ? <code>{part}</code> : part))}
                      </span>
                    )}
                    {row.values.length > 0 && (
                      <span class="cl-docs-param-values">
                        <span class="cl-docs-param-values-label">One of</span>
                        {row.values.map((value) => (
                          <code>{value}</code>
                        ))}
                      </span>
                    )}
                    {row.defaultValue && (
                      <span class="cl-docs-param-values">
                        <span class="cl-docs-param-values-label">Default</span>
                        <code>{row.defaultValue}</code>
                      </span>
                    )}
                  </div>
                </td>
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .cl-docs-params {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    max-width: var(--container-prose);
  }
  .cl-docs-sub {
    color: var(--color-ink);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 500;
  }
  .cl-docs-params-frame {
    overflow-x: auto;
  }
  .cl-docs-params-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    color: var(--color-ink);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
  }
  .cl-docs-params-table.is-described th:first-child {
    width: 40%;
  }
  th {
    height: var(--table-header-height);
    padding: 0 12px;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink-2);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
  }
  td {
    padding: 12px;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: top;
  }
  .cl-docs-param {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .cl-docs-param-name {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-data--line-height);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .cl-docs-param-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    overflow-wrap: anywhere;
  }
  .cl-docs-param-tag {
    padding: 0 4px;
    border-radius: var(--radius-xs);
    background: var(--color-well);
    color: var(--color-ink-2);
  }
  .cl-docs-param-tag.is-required {
    background: var(--color-negative-wash);
    color: var(--color-negative);
  }
  .cl-docs-param-meta a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-control-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .cl-docs-param-desc {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-ink-2);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
  }
  .cl-docs-param-values {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  .cl-docs-param-values-label {
    margin-right: 4px;
    color: var(--color-ink-2);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
  }
  .cl-docs-param-desc code {
    padding: 1px 4px;
    border-radius: var(--radius-xs);
    background: var(--color-well);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    overflow-wrap: anywhere;
  }
</style>
