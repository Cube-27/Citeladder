---
import { TOOL_REFERENCE_HEADING } from '../lib/content';
import { MCP_TOOLS } from '../lib/mcp-reference';
import McpToolRef from './McpToolRef.astro';
import Prose from '@/components/content/Prose.astro';
---

<section class="cl-docs-ref" aria-labelledby={TOOL_REFERENCE_HEADING.slug}>
  <Prose variant="docs">
    <h2 id={TOOL_REFERENCE_HEADING.slug}>{TOOL_REFERENCE_HEADING.text}</h2>
    <p>
      The reference below is generated from the backend catalog. Your connected client’s catalog
      determines which tools are available on its server. Every tool is read-only.
    </p>
  </Prose>
  {MCP_TOOLS.map((tool) => <McpToolRef tool={tool} />)}
</section>

<style>
  .cl-docs-ref {
    display: flex;
    flex-direction: column;
    gap: var(--site-space-10);
    min-width: 0;
  }
</style>
