---
import tools from '@/apps/docs/src/data/mcp-tools.json';
import { TOOL_REFERENCE_HEADING } from '../lib/content';
---
<section class="docs-tool-reference docs-prose website-body" aria-labelledby={TOOL_REFERENCE_HEADING.slug}>
  <h2 id={TOOL_REFERENCE_HEADING.slug}>{TOOL_REFERENCE_HEADING.text}</h2>
  <p>The reference below is generated from the backend catalog. Your connected client’s catalog determines which tools are available on its server. Tools marked “Changes” appear only for a connection approved with Allow changes, and each change needs your confirmation.</p>
  {tools.tools.map((tool) => <details>
    <summary><code>{tool.name}</code>{tool.access === 'write' ? <span class="website-label"> · Changes</span> : null}</summary>
    <p>{tool.description}</p>
    <p class="website-label">Parameters: {Object.keys(tool.input_schema.properties ?? {}).join(', ') || 'None'}</p>
  </details>)}
</section>
