---
/**
 * ApiMethod — an HTTP method as a mono Badge in its state tone: GET
 * `positive`, POST `info`, PUT and PATCH `warning`, DELETE `negative`, any
 * other `neutral`. Wide enough for DELETE, so the names after it line up.
 */
import { Badge, type BadgeTone } from '@/components/ui/badge';

interface Props {
  method: string;
}
const { method } = Astro.props;
const TONES: Partial<Record<string, BadgeTone>> = {
  GET: 'positive',
  POST: 'info',
  PUT: 'warning',
  PATCH: 'warning',
  DELETE: 'negative',
};
---

<Badge tone={TONES[method] ?? 'neutral'} className="min-w-14 justify-center font-mono text-eyebrow">
  {method}
</Badge>
