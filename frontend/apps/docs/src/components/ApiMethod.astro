---
import { Badge, type BadgeTone } from '@/components/ui/badge';

interface Props {
  method: string;
}
const { method } = Astro.props;
const TONES: Partial<Record<string, BadgeTone>> = {
  GET: 'positive',
  POST: 'info',
  PUT: 'warning',
  PATCH: 'warning',
  DELETE: 'negative',
};
---

<Badge tone={TONES[method] ?? 'neutral'} className="min-w-14 justify-center font-mono text-eyebrow">
  {method}
</Badge>
