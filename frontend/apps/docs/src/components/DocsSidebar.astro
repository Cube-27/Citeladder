---
import { ChevronDown } from '@/lib/icons';
import { API_GROUPS } from '../lib/api-reference';
import { API_GROUP, articles, groups } from '../lib/content';
import { API_ENDPOINTS_HREF } from '../lib/site-pages';
import ApiMethod from './ApiMethod.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href.replace(/\/$/, '') || '/') === path;
const inApi = path === '/api' || path.startsWith('/api/');

type Link = { title: string; href: string; method?: string };
type Section = { label: string; links: Link[]; open: boolean; eyebrow: boolean };

const articleLinks = (group: string): Link[] =>
  articles.filter((article) => article.group === group);
const sections: Section[] = inApi
  ? [
      { label: 'Overview', links: articleLinks(API_GROUP), open: true, eyebrow: true },
      ...API_GROUPS.map((group) => ({
        label: group.label,
        links: group.operations.map(({ summary, href, method }) => ({ title: summary, href, method })),
        open: group.operations.some((operation) => current(operation.href)),
        eyebrow: false,
      })),
    ]
  : groups.map((group) => ({
      label: group,
      links: articleLinks(group),
      open: true,
      eyebrow: true,
    }));
---

<nav aria-label={inApi ? 'API documentation' : 'Documentation'} class="cl-docs-side">
  {
    inApi && (
      <a
        class:list={['cl-docs-side-title type-eyebrow', { 'is-active': current(API_ENDPOINTS_HREF) }]}
        href={API_ENDPOINTS_HREF}
        aria-current={current(API_ENDPOINTS_HREF) ? 'page' : undefined}
      >
        All endpoints
      </a>
    )
  }
  {
    sections.map((section) => (
      <details class="cl-docs-side-group" open={section.open}>
        <summary class="cl-docs-side-head">
          <span class={section.eyebrow ? 'type-eyebrow text-ink' : 'cl-docs-side-label'}>
            {section.label}
          </span>
          <ChevronDown className="cl-docs-side-caret size-3.5" aria-hidden />
        </summary>
        <ul class="cl-doc-list">
          {section.links.map((link) => (
            <li>
              <a
                class:list={['cl-doc-link cl-docs-side-row', { 'is-active': current(link.href) }]}
                href={link.href}
                aria-current={current(link.href) ? 'page' : undefined}
              >
                {link.method && <ApiMethod method={link.method} />}
                <span class="cl-docs-side-text">{link.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</nav>

<style>
  .cl-docs-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }
  .cl-docs-side-group > .cl-doc-list {
    margin-top: 4px;
  }
  .cl-docs-side-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: var(--control-sm);
    padding: 0 12px;
    border-radius: var(--radius-sm);
    list-style: none;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }
  .cl-docs-side-head::-webkit-details-marker {
    display: none;
  }
  .cl-docs-side-head:hover {
    background: var(--color-well);
  }
  .cl-docs-side-caret {
    color: var(--text-color-ink-2);
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .cl-docs-side-group:not([open]) .cl-docs-side-caret {
    transform: rotate(-90deg);
  }
  .cl-docs-side-label {
    color: var(--text-color-ink-2);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 500;
  }
  .cl-docs-side-title {
    display: flex;
    align-items: center;
    height: var(--control-sm);
    padding: 0 12px;
    border-radius: var(--radius-sm);
    color: var(--text-color-ink);
    text-decoration: none;
  }
  .cl-docs-side-title:hover,
  .cl-docs-side-title.is-active {
    background: var(--color-well);
  }
  .cl-docs-side-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cl-docs-side-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-docs-side-caret {
      transition: none;
    }
  }
</style>
