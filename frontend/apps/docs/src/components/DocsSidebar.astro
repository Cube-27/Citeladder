---
/**
 * DocsSidebar — the docs rail: every guide under its group title. A group
 * collapses from its eyebrow head (a native disclosure, so it works before
 * any script and never moves the groups above it); the current page sits on
 * `surface-sunken` in `ink`, the rest in `ink-secondary`, on 36px rows.
 */
import { ChevronDown } from 'lucide-react';
import { articles, groups } from '../lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href.replace(/\/$/, '') || '/') === path;
---

<nav aria-label="Documentation" class="cl-docs-side">
  {
    groups.map((group) => (
      <details class="cl-docs-side-group" open>
        <summary class="cl-docs-side-head">
          <span class="type-eyebrow">{group}</span>
          <ChevronDown className="cl-docs-side-caret size-3.5" aria-hidden />
        </summary>
        <ul class="cl-doc-list">
          {articles
            .filter((article) => article.group === group)
            .map((article) => (
              <li>
                <a
                  class:list={['cl-doc-link', { 'is-active': current(article.href) }]}
                  href={article.href}
                  aria-current={current(article.href) ? 'page' : undefined}
                >
                  <span class="cl-docs-side-text">{article.title}</span>
                </a>
              </li>
            ))}
        </ul>
      </details>
    ))
  }
</nav>

<style>
  .cl-docs-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }
  /* A details box is block: the list's top margin is the group's 4px gap. */
  .cl-docs-side-group > .cl-doc-list {
    margin-top: 4px;
  }
  .cl-docs-side-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: var(--control-sm);
    padding: 0 12px;
    border-radius: var(--radius-sm);
    list-style: none;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }
  .cl-docs-side-head::-webkit-details-marker {
    display: none;
  }
  .cl-docs-side-head:hover {
    background: var(--color-surface-sunken);
  }
  .cl-docs-side-head:hover .type-eyebrow {
    color: var(--color-ink);
  }
  .cl-docs-side-caret {
    color: var(--color-ink-muted);
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .cl-docs-side-group:not([open]) .cl-docs-side-caret {
    transform: rotate(-90deg);
  }
  /* The rows ride on DocLayout's `cl-doc-list` and `cl-doc-link`. */
  .cl-docs-side-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-docs-side-caret {
      transition: none;
    }
  }
</style>
