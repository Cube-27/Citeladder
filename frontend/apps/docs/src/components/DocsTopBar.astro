---
import { buttonClasses } from '@/components/ui/button';
import { LogoMark } from '@/components/ui/logo-mark';
import { ThemeSwitch } from '@/components/ui/theme-switch';
import { BookOpen, Braces, History, ICONS, Menu, Plug, X } from '@/lib/icons';
import { appHref, websiteHref } from '@/lib/config/app-link';
import { DocsSearchDialog } from './DocsSearchDialog';
import DocsSidebar from './DocsSidebar.astro';

const path = Astro.url.pathname;
const website = websiteHref('/');
const sections = [
  {
    href: '/',
    label: 'Documentation',
    icon: BookOpen,
    selected: !/^\/(agent|mcp|api|changelog)(\/|$)/.test(path),
  },
  { href: '/agent/', label: 'Agent', icon: ICONS.agent, selected: path.startsWith('/agent') },
  { href: '/mcp/', label: 'MCP', icon: Plug, selected: path.startsWith('/mcp') },
  { href: '/api/', label: 'API', icon: Braces, selected: path === '/api' || path.startsWith('/api/') },
  { href: '/changelog/', label: 'Changelog', icon: History, selected: path.startsWith('/changelog') },
];
---

<header class="cl-docs-bar" data-docs-bar>
  <div class="cl-docs-bar-inner">
    <a class="cl-docs-bar-home" href="/" aria-label="CiteLadder documentation home">
      <LogoMark size={22} className="cl-docs-bar-logo" />
      <LogoMark size={22} wordmark={false} className="cl-docs-bar-mark" />
    </a>
    <div class="cl-docs-bar-search">
      <DocsSearchDialog client:idle />
    </div>
    <div class="cl-docs-bar-end">
      <a class="cl-docs-bar-site" href={website}>{new URL(website).host}</a>
      <ThemeSwitch client:idle />
      <a class={buttonClasses('primary', 'cl-docs-bar-app')} href={appHref('/')}>Open app</a>
      <button
        type="button"
        class={buttonClasses('quiet', 'cl-docs-bar-menu')}
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="docs-menu"
        data-docs-menu
      >
        <Menu className="cl-docs-bar-menu-open size-4" aria-hidden />
        <X className="cl-docs-bar-menu-close size-4" aria-hidden />
      </button>
    </div>
  </div>
  <nav class="cl-docs-bar-tabs" aria-label="Documentation sections">
    <ul class="cl-docs-bar-tab-list">
      {
        sections.map(({ href, label, icon: Icon, selected }) => (
          <li>
            <a
              class="cl-docs-bar-tab focus-ring-inset"
              href={href}
              aria-current={selected ? 'page' : undefined}
            >
              <Icon className="size-4 shrink-0" aria-hidden />
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="cl-docs-bar-sheet" id="docs-menu" hidden>
    <nav class="cl-docs-bar-sheet-tabs" aria-label="Documentation sections">
      <ul class="cl-doc-list">
        {
          sections.map(({ href, label, selected }) => (
            <li>
              <a
                class:list={['cl-doc-link focus-ring', { 'is-active': selected }]}
                href={href}
                aria-current={selected ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <DocsSidebar />
    <a class={buttonClasses('primary', 'w-full')} href={appHref('/')}>Open app</a>
  </div>
</header>

<style>
  :root {
    --docs-search-width: 360px;
    --docs-search-width-compact: 280px;
  }
  .cl-docs-bar {
    position: sticky;
    top: 0;
    z-index: var(--z-index-overlay);
    background: var(--color-site-page);
    box-shadow: inset 0 calc(-1 * var(--site-rule)) 0 var(--color-rule);
  }
  .cl-docs-bar-inner,
  .cl-docs-bar-tab-list {
    max-width: var(--container-app);
    margin: 0 auto;
  }
  .cl-docs-bar-inner {
    display: grid;
    padding: 0 var(--site-space-6);
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--site-space-6);
    height: var(--nav-height);
  }
  .cl-docs-bar-home {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    margin-left: calc(-1 * var(--site-space-1));
    padding: var(--site-space-1);
    border-radius: var(--radius-inner);
    color: var(--text-color-ink);
    text-decoration: none;
  }
  .cl-docs-bar-home :global(.cl-docs-bar-mark) {
    display: none;
  }
  .cl-docs-bar-search :global([data-docs-search-trigger='field']) {
    display: flex;
    width: var(--docs-search-width);
  }
  .cl-docs-bar-search :global([data-docs-search-trigger='icon']),
  .cl-docs-bar-end :global(.cl-docs-bar-menu) {
    display: none;
  }
  .cl-docs-bar-end {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--site-space-2);
  }
  .cl-docs-bar-site {
    display: inline-flex;
    align-items: center;
    height: var(--spacing-control-md);
    padding: 0 var(--site-space-3);
    border-radius: var(--radius-control);
    color: var(--text-color-ink-2);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-duration-fast) var(--ease-standard),
      color var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-docs-bar-site:hover {
    background: var(--color-well);
    color: var(--text-color-ink);
  }
  .cl-docs-bar-tabs {
    box-shadow: inset 0 var(--site-rule) 0 var(--color-rule);
  }
  .cl-docs-bar-tab-list {
    display: flex;
    gap: var(--site-space-1);
    padding: 0 var(--site-space-3);
    height: var(--docs-tabs-height);
    list-style: none;
  }
  .cl-docs-bar-tab-list li {
    display: flex;
  }
  .cl-docs-bar-tab {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: var(--site-space-2);
    padding: 0 var(--site-space-3);
    color: var(--text-color-ink-2);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-docs-bar-tab::before {
    position: absolute;
    inset: var(--site-space-2) 0;
    z-index: var(--z-index-behind);
    border-radius: var(--radius-inner);
    content: '';
    transition: background-color var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-docs-bar-tab::after {
    position: absolute;
    right: 0;
    bottom: calc(-1 * var(--site-rule));
    left: 0;
    height: var(--site-space-0_5);
    content: '';
  }
  .cl-docs-bar-tab:hover {
    color: var(--text-color-ink);
  }
  .cl-docs-bar-tab:not([aria-current='page']):hover::before {
    background: var(--color-well);
  }
  .cl-docs-bar-tab[aria-current='page'] {
    color: var(--text-color-ink);
  }
  .cl-docs-bar-tab[aria-current='page']::after {
    background: var(--color-accent);
  }
  .cl-docs-bar-menu :global(.cl-docs-bar-menu-close),
  .cl-docs-bar-menu[aria-expanded='true'] :global(.cl-docs-bar-menu-open) {
    display: none;
  }
  .cl-docs-bar-menu[aria-expanded='true'] :global(.cl-docs-bar-menu-close) {
    display: block;
  }
  .cl-docs-bar-sheet {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: var(--site-space-4);
    max-height: calc(100dvh - var(--nav-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--site-space-4) var(--site-space-5) var(--site-space-6);
    background: var(--color-site-page);
    border-top: var(--site-rule) solid var(--color-rule);
    box-shadow: var(--shadow-pop);
  }
  .cl-docs-bar-sheet[hidden] {
    display: none;
  }
  .cl-docs-bar-sheet-tabs {
    padding-bottom: var(--site-space-4);
    border-bottom: var(--site-rule) solid var(--color-rule);
  }
  @media (max-width: 1279px) {
    .cl-docs-bar-search :global([data-docs-search-trigger='field']) {
      width: var(--docs-search-width-compact);
    }
    .cl-docs-bar-site {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .cl-docs-bar-inner {
      display: flex;
      gap: var(--site-space-2);
      padding: 0 var(--site-space-5);
    }
    .cl-docs-bar-home {
      margin-right: auto;
    }
    .cl-docs-bar-tabs,
    .cl-docs-bar-search :global([data-docs-search-trigger='field']),
    .cl-docs-bar-end :global(.cl-docs-bar-app) {
      display: none;
    }
    .cl-docs-bar-search :global([data-docs-search-trigger='icon']),
    .cl-docs-bar-end :global(.cl-docs-bar-menu) {
      display: inline-flex;
    }
    .cl-docs-bar-end :global(.cl-docs-bar-menu) {
      width: var(--spacing-control-md);
      padding: 0;
    }
  }
  @media (max-width: 639px) {
    .cl-docs-bar-home :global(.cl-docs-bar-logo) {
      display: none;
    }
    .cl-docs-bar-home :global(.cl-docs-bar-mark) {
      display: inline-flex;
    }
  }
  @media (min-width: 900px) {
    .cl-docs-bar-sheet {
      display: none;
    }
  }
  @media print {
    .cl-docs-bar {
      display: none;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-docs-menu]');
  const sheet = document.getElementById('docs-menu');
  if (button && sheet) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      sheet.hidden = !open;
    };
    button.addEventListener('click', () => setOpen(sheet.hidden));
    sheet.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('pointerdown', (event) => {
      const target = event.target;
      if (sheet.hidden || !(target instanceof Node)) return;
      if (!sheet.contains(target) && !button.contains(target)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || sheet.hidden) return;
      setOpen(false);
      button.focus();
    });
  }
</script>
