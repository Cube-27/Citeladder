---
/**
 * ApiSidebar — the API section's rail: an Overview block of its guides, then
 * Endpoints as one collapsible group per resource. Each endpoint row is a
 * method pill and its summary; the current page sits on `surface-sunken`. The
 * group holding the current page starts open, the rest closed.
 */
import { ChevronDown } from 'lucide-react';
import { API_GROUPS } from '../lib/api-reference';
import { API_GROUP, articles } from '../lib/content';
import { API_ENDPOINTS_HREF } from '../lib/site-pages';
import ApiMethod from './ApiMethod.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href.replace(/\/$/, '') || '/') === path;
const overview = articles.filter((article) => article.group === API_GROUP);
---

<nav aria-label="API documentation" class="cl-docs-side">
  <details class="cl-docs-side-group" open>
    <summary class="cl-docs-side-head">
      <span class="type-eyebrow text-ink">Overview</span>
      <ChevronDown className="cl-docs-side-caret size-3.5" aria-hidden />
    </summary>
    <ul class="cl-doc-list">
      {
        overview.map((article) => (
          <li>
            <a
              class:list={['cl-doc-link', { 'is-active': current(article.href) }]}
              href={article.href}
              aria-current={current(article.href) ? 'page' : undefined}
            >
              <span class="cl-docs-side-text">{article.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </details>
  <div class="cl-docs-side-endpoints">
    <a
      class:list={['cl-docs-side-title type-eyebrow', { 'is-active': current(API_ENDPOINTS_HREF) }]}
      href={API_ENDPOINTS_HREF}
      aria-current={current(API_ENDPOINTS_HREF) ? 'page' : undefined}>Endpoints</a
    >
    {
      API_GROUPS.map((group) => (
        <details
          class="cl-docs-side-group"
          open={group.operations.some((operation) => current(operation.href))}
        >
          <summary class="cl-docs-side-head">
            <span class="cl-docs-side-label">{group.label}</span>
            <ChevronDown className="cl-docs-side-caret size-3.5" aria-hidden />
          </summary>
          <ul class="cl-doc-list">
            {group.operations.map((operation) => (
              <li>
                <a
                  class:list={['cl-doc-link cl-docs-side-op', { 'is-active': current(operation.href) }]}
                  href={operation.href}
                  aria-current={current(operation.href) ? 'page' : undefined}
                >
                  <ApiMethod method={operation.method} compact />
                  <span class="cl-docs-side-text">{operation.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</nav>

<style>
  .cl-docs-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }
  .cl-docs-side-endpoints {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cl-docs-side-title {
    display: flex;
    align-items: center;
    height: var(--control-sm);
    padding: 0 12px;
    margin-bottom: 4px;
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    text-decoration: none;
  }
  .cl-docs-side-title:hover,
  .cl-docs-side-title.is-active {
    background: var(--color-surface-sunken);
  }
  .cl-docs-side-group > .cl-doc-list {
    margin-top: 4px;
  }
  .cl-docs-side-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: var(--control-sm);
    padding: 0 12px;
    border-radius: var(--radius-sm);
    list-style: none;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }
  .cl-docs-side-head::-webkit-details-marker {
    display: none;
  }
  .cl-docs-side-head:hover {
    background: var(--color-surface-sunken);
  }
  .cl-docs-side-label {
    color: var(--color-ink-secondary);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 500;
  }
  .cl-docs-side-caret {
    color: var(--color-ink-muted);
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .cl-docs-side-group:not([open]) .cl-docs-side-caret {
    transform: rotate(-90deg);
  }
  .cl-docs-side-op {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cl-docs-side-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-docs-side-caret {
      transition: none;
    }
  }
</style>
