---
import { Badge } from '@/components/ui/badge';
import type { McpTool } from '../lib/mcp-reference';
import ParamTable from './ParamTable.astro';
import ReferenceBlock from './ReferenceBlock.astro';

interface Props {
  tool: McpTool;
}
const { tool } = Astro.props;
---

<ReferenceBlock id={tool.id}>
  <Fragment slot="head">
    <h3 class="cl-docs-op-title" id={`${tool.id}-title`}>{tool.title}</h3>
    <p class="cl-docs-op-line">
      <code class="cl-docs-op-code">{tool.name}</code>
      {
        tool.access === 'write' && (
          <Badge tone="warning" dot>
            Changes
          </Badge>
        )
      }
    </p>
    <p class="cl-docs-op-desc">{tool.description}</p>
  </Fragment>
  {
    tool.input.length > 0 ? (
      <ParamTable title="Input schema" rows={tool.input} />
    ) : (
      <p class="cl-docs-op-desc">Parameters: None</p>
    )
  }
</ReferenceBlock>
