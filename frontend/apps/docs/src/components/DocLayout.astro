---
/**
 * DocLayout — the docs columns: a `sidebar-width` (248) rail, the reading
 * column and a 200px "On this page" column, 48px apart, the rail and Toc
 * sticky under the top bar. Below 1200px the Toc leaves the grid for an
 * "On this page" jump menu above the article (a 48px summary whose panel
 * overlays the page, closed by default, so opening it moves nothing); below
 * 900px the rail leaves too, for the top bar's menu sheet.
 */
import { ChevronDown } from 'lucide-react';
import Toc from './Toc.astro';

interface Props {
  toc: readonly { id: string; label: string; level: number }[];
}
const { toc } = Astro.props;
const hasToc = toc.length > 0;
---

<div class:list={['cl-doc', { 'cl-doc--toc': hasToc }]}>
  <aside class="cl-doc-rail"><slot name="rail" /></aside>
  <main id="main" class="cl-doc-main" tabindex="-1">
    {
      hasToc && (
        <div class="cl-doc-bar">
          <details class="cl-jump" data-jump>
            <summary class="cl-jump-summary">
              <span class="cl-jump-label">On this page</span>
              <ChevronDown className="cl-jump-caret size-4" aria-hidden />
            </summary>
            <div class="cl-jump-panel">
              <Toc items={toc} />
            </div>
          </details>
        </div>
      )
    }
    <slot />
  </main>
  {
    hasToc && (
      <aside class="cl-doc-toc">
        <Toc items={toc} />
        <slot name="toc-end" />
      </aside>
    )
  }
</div>

<style>
  .cl-doc {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .cl-doc--toc {
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr) 200px;
  }
  .cl-doc-rail,
  .cl-doc-toc {
    position: sticky;
    top: calc(var(--nav-height) + 40px);
  }
  .cl-doc-rail {
    max-height: calc(100vh - var(--nav-height) - 64px);
    margin: 0 -4px;
    padding: 0 4px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }
  .cl-doc-toc {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .cl-doc-main {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-width: 0;
  }
  .cl-doc-bar {
    display: none;
  }
  .cl-jump {
    position: relative;
    min-width: 0;
  }
  .cl-jump-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: var(--control-lg);
    padding: 0 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    color: var(--color-ink);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 500;
    list-style: none;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }
  .cl-jump-summary::-webkit-details-marker {
    display: none;
  }
  .cl-jump-summary:hover {
    background: var(--color-surface-sunken);
  }
  .cl-jump-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cl-jump :global(.cl-jump-caret) {
    color: var(--color-ink-secondary);
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .cl-jump[open] :global(.cl-jump-caret) {
    transform: rotate(180deg);
  }
  .cl-jump-panel {
    position: absolute;
    z-index: var(--z-index-sticky);
    top: calc(100% + 8px);
    left: 0;
    width: max(100%, 280px);
    max-width: calc(100vw - 40px);
    max-height: min(60vh, 480px);
    overflow: auto;
    padding: 12px 12px 12px 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-pop);
  }
  .cl-jump-panel :global(.cl-toc > .type-eyebrow) {
    display: none;
  }
  @media (max-width: 1199px) {
    .cl-doc,
    .cl-doc--toc {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
    .cl-doc-toc {
      display: none;
    }
    .cl-doc-bar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: var(--container-prose);
    }
  }
  @media (max-width: 899px) {
    .cl-doc,
    .cl-doc--toc {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .cl-doc-rail {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .cl-doc-bar {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-jump :global(.cl-jump-caret) {
      transition: none;
    }
  }
  @media print {
    .cl-doc,
    .cl-doc--toc {
      display: block;
    }
    .cl-doc-rail,
    .cl-doc-toc,
    .cl-doc-bar {
      display: none;
    }
  }
</style>

<script>
  // A jump menu closes on a link, a click outside or Esc (focus back on its summary).
  for (const jump of document.querySelectorAll<HTMLDetailsElement>('[data-jump]')) {
    jump.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('.cl-jump-panel a'))
        jump.open = false;
    });
    document.addEventListener('pointerdown', (event) => {
      if (jump.open && event.target instanceof Node && !jump.contains(event.target))
        jump.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !jump.open) return;
      jump.open = false;
      jump.querySelector('summary')?.focus();
    });
  }
</script>
