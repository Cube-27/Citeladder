---
/** A schema type in mono, its named schemas linked to their entry on the API reference. */
import { schemaAnchor, type TypePart } from '../lib/json-schema';

const { parts } = Astro.props as { parts: readonly TypePart[] };
---

<code
  >{
    parts.map((part) =>
      part.schema ? <a href={`#${schemaAnchor(part.schema)}`}>{part.text}</a> : part.text,
    )
  }</code
>
