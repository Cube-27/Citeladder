---
import CodeBlock from '@/components/content/CodeBlock.astro';
import type { ApiOperation } from '../lib/api-reference';
import ApiCopyButton from './ApiCopyButton.astro';
import { buildSnippets } from '../lib/api-snippets';
import { highlightHtml } from '../lib/code-highlight';

interface Props {
  operation: ApiOperation;
}
const { operation } = Astro.props;
const snippets = buildSnippets(operation).map((snippet) => ({
  ...snippet,
  html: highlightHtml(snippet.code, snippet.language),
}));
const { status, body } = operation.response;
const responseExample =
  body?.example === null || body?.example === undefined
    ? null
    : highlightHtml(JSON.stringify(body.example, null, 2), 'json');
---

<CodeBlock />
<div class="cl-docs-examples">
  <figure class="cl-code" data-api-request>
    <figcaption class="cl-code-bar">
      <div class="cl-docs-code-tabs" role="tablist" aria-label="Request language">
        {
          snippets.map((snippet, index) => (
            <button
              type="button"
              role="tab"
              class="cl-docs-code-tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              id={`api-lang-${snippet.id}`}
              aria-controls="api-request-panel"
              data-api-lang={snippet.id}
              tabindex={index === 0 ? 0 : -1}
            >
              {snippet.label}
            </button>
          ))
        }
      </div>
      <ApiCopyButton />
    </figcaption>
    {snippets.map((snippet) => <template data-api-snippet={snippet.id} set:html={snippet.html} />)}
    <pre
      class="cl-code-pre"
      role="tabpanel"
      id="api-request-panel"
      aria-labelledby={`api-lang-${snippets[0]?.id}`}
      tabindex="0"><code set:html={snippets[0]?.html} /></pre>
  </figure>
  {
    responseExample && (
      <figure class="cl-code">
        <figcaption class="cl-code-bar">
          <span class="cl-docs-code-tab" data-on>
            {status}
          </span>
          <ApiCopyButton />
        </figcaption>
        <pre class="cl-code-pre" tabindex="0"><code set:html={responseExample} /></pre>
      </figure>
    )
  }
</div>

<style>
  .cl-docs-examples {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    min-height: 0;
  }
  .cl-docs-examples :global(.cl-code) {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .cl-docs-examples :global(.cl-code-bar) {
    flex-shrink: 0;
  }
  .cl-docs-examples :global(.cl-code-pre) {
    min-height: 0;
    max-height: 420px;
    overflow: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  @media (min-width: 1280px) {
    .cl-docs-examples :global(.cl-code-pre) {
      max-height: none;
      overscroll-behavior: contain;
    }
    .cl-docs-examples [data-api-request] {
      flex-shrink: 0;
    }
    .cl-docs-examples [data-api-request] :global(.cl-code-pre) {
      max-height: 40vh;
    }
  }
  .cl-docs-code-tabs {
    display: flex;
    align-self: stretch;
    gap: 4px;
  }
  .cl-docs-code-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--text-color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: var(--text-eyebrow--line-height);
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    transition: color var(--transition-duration-fast) var(--ease-standard);
  }
  button.cl-docs-code-tab {
    cursor: pointer;
  }
  .cl-docs-code-tab::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    content: '';
  }
  .cl-docs-code-tab:hover,
  .cl-docs-code-tab:is([aria-selected='true'], [data-on]) {
    color: var(--text-color-ink);
  }
  .cl-docs-code-tab:is([aria-selected='true'], [data-on])::after {
    background: var(--color-accent);
  }
  .cl-docs-examples :global(.cl-tok-key) {
    color: var(--color-info);
  }
  .cl-docs-examples :global(.cl-tok-string) {
    color: var(--color-positive);
  }
  .cl-docs-examples :global(.cl-tok-number) {
    color: var(--color-warning);
  }
  .cl-docs-examples :global(.cl-tok-literal) {
    color: var(--color-negative);
  }
  .cl-docs-examples :global(.cl-tok-keyword) {
    color: var(--text-color-accent-text);
  }
  .cl-docs-examples :global(.cl-tok-comment) {
    color: var(--text-color-ink-2);
  }
</style>

<script>
  const ARROW_STEPS = new Map([
    ['ArrowRight', 1],
    ['ArrowLeft', -1],
  ]);
  for (const root of document.querySelectorAll<HTMLElement>('[data-api-request]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-api-lang]')];
    const code = root.querySelector('pre code');
    const select = (selected: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === selected;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      }
      code?.parentElement?.setAttribute('aria-labelledby', selected.id);
      const sample = root.querySelector<HTMLTemplateElement>(
        `template[data-api-snippet="${selected.dataset.apiLang ?? ''}"]`,
      );
      if (code && sample) code.replaceChildren(sample.content.cloneNode(true));
    };
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const step = ARROW_STEPS.get(event.key) ?? 0;
        if (step === 0) return;
        const next = tabs[(index + step + tabs.length) % tabs.length];
        if (!next) return;
        select(next);
        next.focus();
      });
    }
  }
</script>
