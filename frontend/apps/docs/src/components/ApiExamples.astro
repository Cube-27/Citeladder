---
/**
 * ApiExamples — the endpoint page's right column: a request card whose bar
 * switches the language (cURL, JavaScript, Python) beside a Copy button, and
 * a response card whose bar names the status beside its own Copy button. Both
 * cards are CodeBlock markup, so the system's copy behaviour and look apply.
 */
import CodeBlock from '@/components/content/CodeBlock.astro';
import type { ApiOperation } from '../lib/api-reference';
import { buildSnippets } from '../lib/api-snippets';

interface Props {
  operation: ApiOperation;
}
const { operation } = Astro.props;
const snippets = buildSnippets(operation);
const { status, body } = operation.response;
const responseExample =
  body?.example === null || body?.example === undefined
    ? null
    : JSON.stringify(body.example, null, 2);

const COPY_ICON = {
  rect: { width: 14, height: 14, x: 8, y: 8, rx: 2, ry: 2 },
  path: 'M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2',
  check: 'M20 6 9 17l-5-5',
};
---

<CodeBlock />
<div class="cl-docs-examples" data-api-examples>
  <figure
    class="cl-code"
    data-api-request
    data-snippets={JSON.stringify(Object.fromEntries(snippets.map((s) => [s.id, s.code])))}
  >
    <figcaption class="cl-code-bar">
      <div class="cl-docs-lang-tabs" role="tablist" aria-label="Request language">
        {
          snippets.map((snippet, index) => (
            <button
              type="button"
              role="tab"
              class="cl-docs-lang-tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls="api-request-panel"
              data-api-lang={snippet.id}
              tabindex={index === 0 ? 0 : -1}
            >
              {snippet.label}
            </button>
          ))
        }
      </div>
      <output class="cl-code-status" data-code-copy-status></output>
      <button type="button" class="cl-code-copy" data-code-copy>
        <svg class="lucide cl-code-icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect {...COPY_ICON.rect}></rect><path d={COPY_ICON.path}></path></svg>
        <svg class="lucide cl-code-icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={COPY_ICON.check}></path></svg>
        Copy
      </button>
    </figcaption>
    <pre class="cl-code-pre" role="tabpanel" id="api-request-panel" tabindex="0"><code
        >{snippets[0]?.code}</code
      ></pre>
  </figure>
  {
    responseExample && (
      <figure class="cl-code">
        <figcaption class="cl-code-bar">
          <span class="cl-docs-status-tab">{status}</span>
          <output class="cl-code-status" data-code-copy-status />
          <button type="button" class="cl-code-copy" data-code-copy>
            <svg class="lucide cl-code-icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect {...COPY_ICON.rect}></rect><path d={COPY_ICON.path}></path></svg>
            <svg class="lucide cl-code-icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={COPY_ICON.check}></path></svg>
            Copy
          </button>
        </figcaption>
        <pre class="cl-code-pre" tabindex="0">
          <code>{responseExample}</code>
        </pre>
      </figure>
    )
  }
</div>

<style>
  .cl-docs-examples {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  /* The response body is long: it scrolls inside its card, not the page. */
  .cl-docs-examples :global(.cl-code-pre) {
    max-height: 420px;
  }
  .cl-docs-lang-tabs {
    display: flex;
    gap: 2px;
  }
  .cl-docs-lang-tab,
  .cl-docs-status-tab {
    display: inline-flex;
    align-items: center;
    height: var(--control-sm);
    padding: 0 8px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    line-height: var(--text-eyebrow--line-height);
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
  }
  .cl-docs-lang-tab {
    cursor: pointer;
  }
  .cl-docs-lang-tab:hover,
  .cl-docs-lang-tab[aria-selected='true'],
  .cl-docs-status-tab {
    background: var(--color-surface);
    color: var(--color-ink);
  }
</style>

<script>
  // The language tabs swap the one code element's text, so Copy reads what is shown.
  for (const root of document.querySelectorAll<HTMLElement>('[data-api-request]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-api-lang]')];
    const code = root.querySelector('code');
    const snippets: Record<string, string> = JSON.parse(root.dataset.snippets ?? '{}');
    const select = (selected: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === selected;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      }
      if (code) code.textContent = snippets[selected.dataset.apiLang ?? ''] ?? '';
    };
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (step === 0) return;
        const next = tabs[(index + step + tabs.length) % tabs.length];
        if (!next) return;
        select(next);
        next.focus();
      });
    }
  }
</script>
