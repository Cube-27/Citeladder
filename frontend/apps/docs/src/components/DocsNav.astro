---
import { articles, groups, type Group } from '../lib/content';
import { Rocket, ChartNoAxesCombined, Bot, Plug, History, type LucideIcon } from 'lucide-react';
const icons: Record<Group, LucideIcon> = { 'Start here': Rocket, 'Measure and understand': ChartNoAxesCombined, 'Improve with Agent': Bot, 'Connect with MCP': Plug, 'Updates': History };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav aria-label="Documentation" class="docs-nav">
  {groups.map((group) => { const Icon = icons[group]; return <section>
    <h2 class="website-label docs-nav-heading"><Icon className="size-4" aria-hidden />{group}</h2>
    <ul>{articles.filter((article) => article.group === group).map((article) =>
      <li><a href={article.href} aria-current={(article.href.replace(/\/$/, '') || '/') === path ? 'page' : undefined}>{article.title}</a></li>
    )}</ul>
  </section>; })}
</nav>
