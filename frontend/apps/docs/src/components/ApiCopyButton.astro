---
/**
 * ApiCopyButton — the status and Copy button of a CodeBlock bar, in the
 * markup `code-copy.ts` listens for (Tabler's copy and check glyphs at 16px).
 */
---

<output class="cl-code-status" data-code-copy-status></output>
<button type="button" class="cl-code-copy" data-code-copy>
  <svg
    class="tabler-icon cl-code-icon-copy"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
    ></path>
    <path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
    ></path>
  </svg>
  <svg
    class="tabler-icon cl-code-icon-check"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12l5 5l10 -10"></path>
  </svg>
  Copy
</button>
