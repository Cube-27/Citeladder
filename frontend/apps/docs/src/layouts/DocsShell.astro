---
import { websiteHref } from '@/lib/config/app-link';
import { docsHref } from '@/lib/config/docs';
import { brandFontHead } from '@/lib/fonts/brand-fonts';
import { serializeJsonLd } from '@/lib/seo/json-ld';
import { ArrowUpRight } from '@/lib/icons';
import ArticlePager from '@/components/content/ArticlePager.astro';
import DocLayout from '@/components/content/DocLayout.astro';
import SpeculationRules from '@/components/content/SpeculationRules.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsTopBar from '../components/DocsTopBar.astro';
import '../styles/tailwind.css';

type Link = { title: string; href: string };
interface Props {
  title: string;
  description: string;
  toc?: readonly { id: string; label: string; level: number }[];
  wide?: boolean;
  previous?: Link;
  next?: Link;
  noindex?: boolean;
  updated?: string;
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description,
  toc = [],
  wide = false,
  previous,
  next,
  noindex = false,
  updated,
  jsonLd,
} = Astro.props;
const hasAside = Astro.slots.has('aside');
const path = Astro.url.pathname;
const contact = websiteHref('/contact');
---

<!doctype html>
<html lang="en" data-public-surface>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme-preference.js"></script>
    <title>{title} · CiteLadder Docs</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={docsHref(path)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={`${title} · CiteLadder Docs`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={docsHref(path)} />
    {updated && <meta property="article:modified_time" content={updated} />}
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <Fragment set:html={brandFontHead('docs')} />
    <SpeculationRules />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="cl-docs-shell">
      <DocsTopBar />
      <div class="cl-docs-body">
        <DocLayout toc={wide ? [] : toc}>
          <DocsSidebar slot="rail" />
          <div class:list={['cl-docs-page', { 'cl-docs-page--aside': hasAside }]}>
            <div class="cl-docs-page-body"><slot /></div>
            {
              hasAside && (
                <aside class="cl-docs-page-aside" aria-label="Examples">
                  <slot name="aside" />
                </aside>
              )
            }
            <div class="cl-docs-page-end">
              {(previous || next) && <ArticlePager previous={previous} next={next} />}
              <footer class="cl-docs-footer">
                <span>© CiteLadder documentation</span>
                <a href={contact}>Get help</a>
                <a href={websiteHref('/privacy')}>Privacy</a>
              </footer>
            </div>
          </div>
          <a slot="toc-end" class="cl-docs-help" href={contact}>
            Need a hand? Get in touch <ArrowUpRight className="size-3" aria-hidden />
          </a>
        </DocLayout>
      </div>
    </div>
  </body>
</html>

<style>
  :root {
    --docs-aside-min: 360px;
    --docs-aside-max: 440px;
  }
  .cl-docs-shell {
    min-height: 100vh;
    background: var(--color-site-page);
    color: var(--text-color-ink);
  }
  .cl-docs-body {
    max-width: var(--container-app);
    margin: 0 auto;
    padding: var(--site-space-10) var(--site-space-6) 0;
  }
  .cl-docs-shell :global(:is(.cl-doc-rail, .cl-doc-toc)) {
    top: calc(var(--docs-bar-height) + var(--site-space-10));
    height: calc(100dvh - var(--docs-bar-height) - var(--site-space-10));
    max-height: none;
    padding-bottom: var(--site-space-6);
    overscroll-behavior: contain;
  }
  .cl-docs-shell :global(.cl-prose :is(h2, h3, h4)) {
    scroll-margin-top: calc(var(--docs-bar-height) + var(--site-space-8));
  }
  .cl-docs-page,
  .cl-docs-page-body,
  .cl-docs-page-end {
    display: flex;
    flex-direction: column;
    gap: var(--site-space-10);
    min-width: 0;
  }
  .cl-docs-page-end {
    padding-bottom: var(--site-space-24);
  }
  .cl-docs-page-aside {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  @media (min-width: 1280px) {
    .cl-docs-page--aside {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(var(--docs-aside-min), var(--docs-aside-max));
      grid-template-rows: auto 1fr;
      align-items: start;
      gap: var(--site-space-10) var(--site-space-12);
    }
    .cl-docs-page--aside > :not(.cl-docs-page-aside) {
      grid-column: 1;
    }
    .cl-docs-page-aside {
      grid-column: 2;
      grid-row: 1 / span 2;
      position: sticky;
      top: calc(var(--docs-bar-height) + var(--site-space-10));
      max-height: calc(100dvh - var(--docs-bar-height) - var(--site-space-16));
    }
  }
  .cl-docs-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-5);
    max-width: var(--container-prose);
    padding-top: var(--site-space-6);
    border-top: var(--site-rule) solid var(--color-rule);
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-docs-footer span {
    margin-right: auto;
  }
  .cl-docs-footer a,
  .cl-docs-help {
    color: var(--text-color-ink-2);
    text-decoration: none;
    transition: color var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-docs-footer a:hover,
  .cl-docs-help:hover {
    color: var(--text-color-ink);
  }
  .cl-docs-help {
    display: inline-flex;
    align-items: center;
    gap: var(--site-space-1);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  @media (max-width: 899px) {
    .cl-docs-body {
      padding: var(--site-space-8) var(--site-space-5) 0;
    }
    .cl-docs-page-end {
      padding-bottom: var(--site-space-16);
    }
  }
  @media print {
    .cl-docs-body {
      padding: 0;
    }
    .cl-docs-page-aside {
      position: static;
      max-height: none;
    }
    .cl-docs-footer,
    .cl-docs-shell :global(.cl-pager) {
      display: none;
    }
  }
</style>
