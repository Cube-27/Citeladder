---
import { websiteHref } from '@/lib/config/app-link';
import { docsHref } from '@/lib/config/docs';
import { API_GROUP, articleHeadings, articles } from '../lib/content';
import { docsArticleJsonLd, updatedLabel } from '../lib/structured-data';
import DocsShell from '../layouts/DocsShell.astro';
import ArticleHeader from '@/components/content/ArticleHeader.astro';
import Prose from '@/components/content/Prose.astro';
import ToolReference from '../components/ToolReference.astro';

export function getStaticPaths() {
  const neighbours = (article: (typeof articles)[number]) =>
    articles.filter((other) => (other.group === API_GROUP) === (article.group === API_GROUP));
  return articles.map((article) => {
    const siblings = neighbours(article);
    const index = siblings.indexOf(article);
    return {
      params: { slug: article.route === '' ? undefined : article.route },
      props: { article, previous: siblings[index - 1], next: siblings[index + 1] },
    };
  });
}

const { article, previous, next } = Astro.props;
const { Content } = article.entry;
const headings = await articleHeadings(article);
const jsonLd = docsArticleJsonLd({
  title: article.title,
  description: article.description,
  url: docsHref(article.href),
  updated: article.updated,
  websiteUrl: websiteHref('/'),
});
const toc = headings.map((heading) => ({
  id: heading.slug,
  label: heading.text.replace(/^\d+[.)]\s+/, ''),
  level: heading.depth,
}));
---

<DocsShell
  title={article.title}
  description={article.description}
  updated={article.updated}
  jsonLd={jsonLd}
  toc={toc}
  wide={article.toolReference}
  previous={previous && { title: previous.title, href: previous.href }}
  next={next && { title: next.title, href: next.href }}
>
  <ArticleHeader
    title={article.title}
    eyebrow={article.group}
    meta={article.updated
      ? [{ prefix: 'Updated', text: updatedLabel(article.updated), dateTime: article.updated }]
      : []}
  >
    {article.description}
  </ArticleHeader>
  <Prose variant="docs"><Content /></Prose>
  {article.toolReference && <ToolReference />}
</DocsShell>
