---
import { articleHeadings, articles } from '../lib/content';
import DocsLayout from '../layouts/DocsLayout.astro';
import ToolReference from '../components/ToolReference.astro';
import ApiReference from '../components/ApiReference.astro';
import { ArrowLeft, ArrowRight } from 'lucide-react';

export function getStaticPaths() {
  return articles.map((article, index) => ({
    params: { slug: article.slug === 'index' ? undefined : article.slug },
    props: { article, previous: articles[index - 1], next: articles[index + 1] },
  }));
}

const { article, previous, next } = Astro.props;
const { Content } = article.entry;
const headings = await articleHeadings(article);
---
<DocsLayout title={article.title} description={article.description} headings={headings.map((heading) => ({ ...heading, label: heading.text.replace(/^\d+[.)]\s+/, '') }))}>
  <article>
    <header class="docs-article-header">
      <p class="docs-article-group website-label">{article.group}</p>
      <h1 class="website-page-title docs-title">{article.title}</h1>
      <p class="website-lead">{article.description}</p>
    </header>
    <div class="docs-prose website-body"><Content /></div>
    {article.toolReference && <ToolReference />}
    {article.apiReference && <ApiReference />}
  </article>
  <nav class="docs-pagination" aria-label="Adjacent articles">
    {previous ? <a href={previous.href}><span class="website-label"><ArrowLeft className="size-3.5" aria-hidden />Previous</span><span class="docs-pagination-title">{previous.title}</span></a> : <span />}
    {next && <a href={next.href} class="docs-pagination-next"><span class="website-label">Next<ArrowRight className="size-3.5" aria-hidden /></span><span class="docs-pagination-title">{next.title}</span></a>}
  </nav>
</DocsLayout>
