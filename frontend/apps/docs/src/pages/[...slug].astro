---
import { websiteHref } from '@/lib/config/app-link';
import { docsHref } from '@/lib/config/docs';
import { articleHeadings, articles } from '../lib/content';
import { docsArticleJsonLd } from '../lib/structured-data';
import DocsShell from '../layouts/DocsShell.astro';
import ApiReference from '../components/ApiReference.astro';
import ArticleHeader from '../components/ArticleHeader.astro';
import Prose from '../components/Prose.astro';
import ToolReference from '../components/ToolReference.astro';

export function getStaticPaths() {
  return articles.map((article, index) => ({
    params: { slug: article.slug === 'index' ? undefined : article.slug },
    props: { article, previous: articles[index - 1], next: articles[index + 1] },
  }));
}

const { article, previous, next } = Astro.props;
const { Content } = article.entry;
const headings = await articleHeadings(article);
const jsonLd = docsArticleJsonLd({
  title: article.title,
  description: article.description,
  url: docsHref(article.href),
  updated: article.updated,
  websiteUrl: websiteHref('/'),
});
// The Toc drops a heading's step number ("2. Pick prompts"); its anchor keeps it.
const toc = headings.map((heading) => ({
  id: heading.slug,
  label: heading.text.replace(/^\d+[.)]\s+/, ''),
  level: heading.depth,
}));
---

<DocsShell
  title={article.title}
  description={article.description}
  updated={article.updated}
  jsonLd={jsonLd}
  toc={toc}
  wide={article.toolReference || article.apiReference}
  previous={previous && { title: previous.title, href: previous.href }}
  next={next && { title: next.title, href: next.href }}
>
  <ArticleHeader title={article.title} eyebrow={article.group} updated={article.updated}>
    {article.description}
  </ArticleHeader>
  <Prose><Content /></Prose>
  {article.toolReference && <ToolReference />}
  {article.apiReference && <ApiReference />}
</DocsShell>
