---
import ApiMethod from '../../../components/ApiMethod.astro';
import ApiPage from '../../../layouts/ApiPage.astro';
import { API_GROUPS } from '../../../lib/api-reference';
---

<ApiPage
  title="Endpoints"
  eyebrow="API"
  description="Every public API endpoint, grouped by resource."
>
  <div class="cl-docs-endpoints">
    {
      API_GROUPS.map((group) => (
        <section aria-labelledby={`resource-${group.id}`}>
          <h2 class="cl-docs-endpoints-title" id={`resource-${group.id}`}>
            {group.label}
          </h2>
          <ul class="cl-docs-endpoints-list">
            {group.operations.map((operation) => (
              <li>
                <a class="cl-docs-endpoints-row" href={operation.href}>
                  <ApiMethod method={operation.method} />
                  <span class="cl-docs-endpoints-name">{operation.summary}</span>
                  <code class="cl-docs-endpoints-path">{operation.path}</code>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</ApiPage>

<style>
  .cl-docs-endpoints {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: var(--container-prose);
  }
  .cl-docs-endpoints-title {
    margin: 0 0 8px;
    color: var(--text-color-ink);
    font-size: var(--text-title-sm);
    line-height: var(--text-title-sm--line-height);
    font-weight: 500;
  }
  .cl-docs-endpoints-list {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }
  .cl-docs-endpoints-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--spacing-control-lg);
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-rule);
    color: var(--text-color-ink);
    text-decoration: none;
    transition: background-color var(--transition-duration-fast) var(--ease-standard);
  }
  .cl-docs-endpoints-row:hover {
    background: var(--color-well);
  }
  .cl-docs-endpoints-name {
    flex-shrink: 0;
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    font-weight: 500;
  }
  .cl-docs-endpoints-path {
    min-width: 0;
    margin-left: auto;
    overflow: hidden;
    color: var(--text-color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-data);
    line-height: var(--text-data--line-height);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 639px) {
    .cl-docs-endpoints-path {
      display: none;
    }
  }
</style>
