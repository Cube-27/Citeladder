---
import ParamTable from '../../../components/ParamTable.astro';
import TypeLabel from '../../../components/TypeLabel.astro';
import ApiPage from '../../../layouts/ApiPage.astro';
import { API_OPERATIONS, API_SCHEMAS } from '../../../lib/api-reference';

export function getStaticPaths() {
  return API_SCHEMAS.map((schema) => ({ params: { name: schema.name }, props: { schema } }));
}

const { schema } = Astro.props;
const users = API_OPERATIONS.filter((operation) =>
  [operation.request, operation.response.body].some((body) =>
    [...(body?.type ?? []), ...(body?.rows.flatMap((row) => row.type) ?? [])].some(
      (part) => part.schema === schema.name,
    ),
  ),
);
---

<ApiPage
  title={schema.name}
  eyebrow="Schema"
  description={schema.description}
>
  <div class="cl-docs-schema">
    {
      schema.rows.length > 0 ? (
        <ParamTable title="Fields" rows={schema.rows} />
      ) : (
        <p class="cl-docs-schema-type">
          Type: <TypeLabel parts={schema.type} />
        </p>
      )
    }
    {
      users.length > 0 && (
        <div>
          <h2 class="cl-docs-schema-sub">Used by</h2>
          <ul class="cl-docs-schema-users">
            {users.map((operation) => (
              <li>
                <a href={operation.href}>{operation.summary}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</ApiPage>

<style>
  .cl-docs-schema {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: var(--container-prose);
  }
  .cl-docs-schema-type {
    color: var(--text-color-ink-2);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-docs-schema-type :global(code) {
    color: var(--text-color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-data);
  }
  .cl-docs-schema-sub {
    margin: 0 0 8px;
    color: var(--text-color-ink);
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    font-weight: 500;
  }
  .cl-docs-schema-users {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  .cl-docs-schema-users a {
    color: var(--text-color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-control-line);
    text-underline-offset: 2px;
  }
</style>
