              "gemini",
              "google_ai_overview",
              "chatgpt_search",
              "gemini_consumer"
            ]
          },
          "cohort": {
            "default": "core",
            "type": "string",
            "enum": ["core", "comparison"]
          },
          "cursor": {
            "type": ["string", "null"]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": ["project_id"],
        "additionalProperties": false
      },
      "access": "read"
    },
