        "additionalProperties": false
      },
      "access": "read"
    },
    {
      "name": "read_ai_ads",
      "title": "Read ads in AI answers",
      "description": "Paid ads shown in ChatGPT Search answers for the latest or a chosen run: ad presence rate (\"N of M ChatGPT answers\"), advertisers with share and first/last seen, the ad share and best rank of the brand itself, text creatives (paged) and prompts that surface ads with competitor ads beside organic brand mentions. Only ChatGPT Search shows ads; other engines are not_applicable, never zero. Ads are paid placements: report them separately, never as citations, sources or a cause of visibility.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "audit_id": {
            "type": "string",
            "format": "uuid"
          },
          "engine": {
            "type": "string",
