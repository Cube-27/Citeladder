{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "citeladder-app",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.citeladder.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"],
  },
  "secrets": { "required": ["ORIGIN_TOKEN"] },
  "vars": {
    "ORIGIN_UPSTREAM": "https://origin.citeladder.com",
    "PUBLIC_APP_HOST": "app.citeladder.com",
  },
}
