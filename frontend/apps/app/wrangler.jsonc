{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "citeladder-app",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.citeladder.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "secrets": { "required": ["ORIGIN_TOKEN"] },
  "vars": {
    "ORIGIN_UPSTREAM": "https://citeladder-api-44437656491.us-central1.run.app",
    "PUBLIC_APP_HOST": "app.citeladder.com",
  },
  "observability": {
    "enabled": true,
    // Invocation logs record full URLs (OAuth `code`/`state`, emailed tokens);
    // the Worker logs each request path itself (lib/server/worker-request-log.ts).
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
