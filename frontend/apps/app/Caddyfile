{
  admin off
  auto_https off
}

:3001 {
  encode zstd gzip

  handle /health {
    header Cache-Control "no-store"
    header Content-Type "application/json"
    respond `{"status":"ok"}` 200
  }

  # Backend-owned protocol endpoints must bypass the SPA. Root /register is
  # intentionally absent: it remains a browser route, while /mcp/register is
  # covered by the MCP matcher.
  # Route families the TypeScript API service owns (route-ownership manifest
  # in packages/contracts); the longer paths sort ahead of @backend.
  @ts_api path /api/v1/executions/* /api/v1/projects/*/ai-referrals /api/v1/projects/*/visibility /api/v1/projects/*/visibility/* /api/v1/projects/*/visibility/sources/* /api/v1/projects/*/performance /api/v1/projects/*/performance/table /api/v1/projects/*/performance/range /api/v1/projects/*/performance/range/* /api/v1/projects/*/demand/* /api/v1/projects/*/demand/query-evidence/summary /api/v1/projects/*/opportunities /api/v1/projects/*/opportunities/* /api/v1/opportunities/* /api/v1/projects/*/actions /api/v1/actions/* /api/v1/projects/*/search-intelligence /api/v1/projects/*/search-intelligence/preferences /api/v1/projects/*/search-intelligence/runs /api/v1/projects/*/search-intelligence/runs/* /api/v1/projects/*/search-intelligence/runs/*/confirm /api/v1/projects/*/search-intelligence/runs/*/cancel /api/v1/projects/*/search-intelligence/datasets/*/rows /api/v1/projects/*/search-intelligence/content-handoff /api/v1/projects/*/search-intelligence/citation-matches /api/v1/projects/*/commerce/catalog /api/v1/projects/*/commerce/catalog/import /api/v1/projects/*/commerce/competitors /api/v1/projects/*/commerce/competitors/discoveries /api/v1/projects/*/commerce/competitors/*-*-*-*-* /api/v1/projects/*/commerce/buyer-prompts/generate /api/v1/projects/*/commerce/buyer-prompts/manual /api/v1/projects/*/commerce/buyer-prompts /api/v1/projects/*/commerce/buyer-prompts/*-*-*-*-* /api/v1/projects/*/commerce/ai-shelf /api/v1/projects/*/brand-profile /api/v1/projects/*/business-map /api/v1/projects/*/competitor-suggestions /api/v1/projects/*/competitor-suggestions/*/accept /api/v1/projects/*/logo /api/v1/projects/*/topics /api/v1/topics/* /api/v1/prompt-sets /api/v1/prompt-sets/*-*-*-*-* /api/v1/prompt-sets/*/generate /api/v1/prompt-sets/*/prompts /api/v1/prompt-sets/*/prompts/bulk-status /api/v1/prompt-sets/*/import /api/v1/prompt-sets/*/candidates /api/v1/prompt-sets/*/candidates/review /api/v1/prompts/* /api/v1/projects/*/competitors/*/logo /api/v1/projects/*/site-health/internal-links /api/v1/projects/*/site-health/internal-links/* /api/v1/projects/*/site-health/internal-links/analyses/*/cancel /api/v1/projects /api/v1/projects/*-*-*-*-* /api/v1/projects/*/logos/refresh /api/v1/projects/*/command-center /api/v1/brand-discovery-catalog /api/v1/brand-discoveries /api/v1/brand-discoveries/*
  handle @ts_api {
    reverse_proxy {$API_SERVICE_ORIGIN}
  }

  @backend path /api /api/* /mcp /mcp/* /authorize /token /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp
  handle @backend {
    reverse_proxy {$BACKEND_ORIGIN}
  }

  # Vite fingerprints emitted assets. Do not turn a missing chunk into the SPA
  # document; immutable cache entries must either be the requested file or 404.
  handle /app-assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle {
    root * /srv
    header Cache-Control "no-store"
    try_files {path} /index.html
    file_server
  }
}
