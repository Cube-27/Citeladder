{
  admin off
  auto_https off
}

:3001 {
  encode zstd gzip

  handle /health {
    header Cache-Control "no-store"
    header Content-Type "application/json"
    respond `{"status":"ok"}` 200
  }

  # Backend-owned protocol endpoints must bypass the SPA. Root /register is
  # intentionally absent: it remains a browser route, while /mcp/register is
  # covered by the MCP matcher.
  @backend path /api /api/* /mcp /mcp/* /authorize /token /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp
  handle @backend {
    reverse_proxy {$BACKEND_ORIGIN}
  }

  # Vite fingerprints emitted assets. Do not turn a missing chunk into the SPA
  # document; immutable cache entries must either be the requested file or 404.
  handle /assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
