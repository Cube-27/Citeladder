{
  admin off
  auto_https off
}

:3001 {
  encode zstd gzip

  handle /health {
    header Cache-Control "no-store"
    header Content-Type "application/json"
    respond `{"status":"ok"}` 200
  }

  # Protocol endpoints bypass the SPA; /register remains a browser route.
  @api path /api /api/* /mcp /mcp/* /authorize /token /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp
  handle @api {
    reverse_proxy {$API_SERVICE_ORIGIN}
  }

  # Vite fingerprints emitted assets. Do not turn a missing chunk into the SPA
  # document; immutable cache entries must either be the requested file or 404.
  handle /app-assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle {
    root * /srv
    header Cache-Control "no-store"
    try_files {path} /index.html
    file_server
  }
}
