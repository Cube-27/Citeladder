{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "citeladder-api-host",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  // API-OWNED machine host: no assets, so the marketing Worker keeps serving
  // its static files without a Worker invocation.
  "routes": [{ "pattern": "api.citeladder.com", "custom_domain": true }],
  "secrets": { "required": ["ORIGIN_TOKEN"] },
  "vars": {
    "ORIGIN_UPSTREAM": "https://citeladder-api-44437656491.us-central1.run.app",
    "PUBLIC_API_HOST": "api.citeladder.com",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
}
