artifacts/
.artifacts/
**/.terraform/

# Env / secrets
.env
*.env
!.env.example

# Node / frontend (F1+)
node_modules/
/.playwright/
frontend/.playwright-cli/
frontend/apps/app/.wrangler/
frontend/apps/app/.dev.vars*
frontend/apps/marketing/.wrangler/
frontend/apps/marketing/.dev.vars*
frontend/apps/docs/.wrangler/
frontend/.wrangler/
frontend/apps/docs/.astro/
frontend/apps/docs/dist/
frontend/apps/docs/public/fonts/
frontend/apps/docs/public/citeladder-logo.svg
frontend/apps/docs/public/citeladder-favicon.ico
/.playwright-cli/

# The root package.json only delegates to frontend/; it declares
# no dependencies. pnpm still materializes an empty project there on any root
# `pnpm run`, and a second lockfile at the repository root would move the
# workspace root that frontend tooling infers. frontend/pnpm-lock.yaml
# (not anchored here) stays tracked.
/pnpm-lock.yaml

# OS
.DS_Store

# Local screenshot/debug scratch scripts and their output
frontend/.*.mjs
frontend/.*.png
.runtime/


# Playwright CLI saved browser state. These files hold live session cookies
# and auth tokens. The skill's own examples write `auth.json` and
# `my-auth-state.json` as well as the `*.auth-state.json` it recommends
# ignoring, so all three shapes are covered -- a footgun that only bites once.
auth.json
*.auth-state.json
*-auth-state.json
.auth/

# Coding-agent config. `.claude/settings.json` is shared (it carries the
# permission rules for the repository's own tooling) and stays tracked; the
# rest is per-developer — a personal output style, a local launch profile.
.claude/*
!.claude/settings.json

# Fonts: pulled from the private Cube-27/cube27-fonts repo by
# `pnpm fonts:pull`, never committed (some licences forbid redistribution).
frontend/public/fonts/
# Bundled MCP App HTML is generated from source, including in the API image.
frontend/services/api/assets/mcp-app/
frontend/packages/mcp-app/dist/
