{
  admin off
  auto_https disable_redirects
  servers {
    trusted_proxies static __CLOUDFLARE_CIDRS__
    client_ip_headers CF-Connecting-IP X-Forwarded-For
  }
}

# Worker subrequests only. The secret is a dedicated GCP/Worker credential;
# the public host is independently allowlisted before being used upstream.
https://__ORIGIN_DOMAIN_NAME__ {
  tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key
  # This host carries authenticated Worker traffic. No edge or browser cache
  # may reuse a response for a different caller or ingress token.
  header >Cache-Control "private, no-store"
  @authorized {
    header X-CiteLadder-Origin-Token {$CITELADDER_ORIGIN_TOKEN}
    header X-CiteLadder-Origin-Token {$CITELADDER_ORIGIN_TOKEN_PREVIOUS}
  }
  @apex header X-CiteLadder-Public-Host __DOMAIN_NAME__
  @app header X-CiteLadder-Public-Host __APP_DOMAIN_NAME__
  # Route families the TypeScript API service owns (route-ownership manifest
  # in frontend/packages/contracts); every other path stays on :8000.
  @ts_api path /api/v1/executions/* /api/v1/projects/*/ai-referrals /api/v1/projects/*/visibility/sources/series /api/v1/projects/*/visibility/sources/url /api/v1/projects/*/visibility/surface-rates /api/v1/projects/*/performance /api/v1/projects/*/performance/table /api/v1/projects/*/performance/range /api/v1/projects/*/performance/range/* /api/v1/projects/*/demand/* /api/v1/projects/*/demand/query-evidence/summary /api/v1/projects/*/opportunities /api/v1/projects/*/opportunities/* /api/v1/opportunities/* /api/v1/projects/*/actions /api/v1/actions/* /api/v1/projects/*/search-intelligence /api/v1/projects/*/search-intelligence/preferences /api/v1/projects/*/search-intelligence/runs /api/v1/projects/*/search-intelligence/runs/* /api/v1/projects/*/search-intelligence/runs/*/confirm /api/v1/projects/*/search-intelligence/runs/*/cancel /api/v1/projects/*/search-intelligence/datasets/*/rows /api/v1/projects/*/search-intelligence/content-handoff /api/v1/projects/*/search-intelligence/citation-matches /api/v1/projects/*/commerce/catalog /api/v1/projects/*/commerce/catalog/import /api/v1/projects/*/commerce/competitors /api/v1/projects/*/commerce/competitors/discoveries /api/v1/projects/*/commerce/competitors/*-*-*-*-* /api/v1/projects/*/commerce/buyer-prompts /api/v1/projects/*/commerce/buyer-prompts/*-*-*-*-* /api/v1/projects/*/commerce/ai-shelf
  route {
    handle @authorized {
      handle @apex {
        handle @ts_api {
          reverse_proxy 127.0.0.1:8100 {
            header_up Host __DOMAIN_NAME__
            header_up X-Forwarded-Host __DOMAIN_NAME__
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
            header_up -X-CiteLadder-Origin-Token
            header_up -X-CiteLadder-Public-Host
          }
        }
        reverse_proxy 127.0.0.1:8000 {
          header_up Host __DOMAIN_NAME__
          header_up X-Forwarded-Host __DOMAIN_NAME__
          header_up X-Forwarded-Proto https
          header_up X-Forwarded-For {client_ip}
          header_up -Forwarded
          header_up -X-Forwarded-Port
          header_up -X-Real-IP
          header_up -CF-Connecting-IP
          header_up -X-CiteLadder-Origin-Token
          header_up -X-CiteLadder-Public-Host
        }
      }
      handle @app {
        handle @ts_api {
          reverse_proxy 127.0.0.1:8100 {
            header_up Host __APP_DOMAIN_NAME__
            header_up X-Forwarded-Host __APP_DOMAIN_NAME__
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
            header_up -X-CiteLadder-Origin-Token
            header_up -X-CiteLadder-Public-Host
          }
        }
        reverse_proxy 127.0.0.1:8000 {
          header_up Host __APP_DOMAIN_NAME__
          header_up X-Forwarded-Host __APP_DOMAIN_NAME__
          header_up X-Forwarded-Proto https
          header_up X-Forwarded-For {client_ip}
          header_up -Forwarded
          header_up -X-Forwarded-Port
          header_up -X-Real-IP
          header_up -CF-Connecting-IP
          header_up -X-CiteLadder-Origin-Token
          header_up -X-CiteLadder-Public-Host
        }
      }
      respond 403
    }
    respond 403
  }
}
