  @ts_integrations path /api/v1/integrations /api/v1/integrations/* /api/v1/projects/*/performance/sync /api/v1/billing/catalog /api/v1/billing/entitlement /api/v1/billing/usage /api/v1/billing/early-access /api/v1/billing/early-access/claim /api/v1/billing/card-trial/quote /api/v1/billing/subscriptions /api/v1/billing/subscription /api/v1/billing/subscription/change /api/v1/billing/addons /api/v1/billing/topups /api/v1/billing/activations/* /api/v1/billing/activations/*/checkout /api/v1/billing/activations/*/verify /api/v1/billing/webhooks/* /api/v1/workspaces/*/entitlements
  route {
    handle @authorized {
      handle @apex {
        handle @ts_integrations {
          reverse_proxy 127.0.0.1:8100 {
            header_up Host __DOMAIN_NAME__
            header_up X-Forwarded-Host __DOMAIN_NAME__
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
            header_up -X-CiteLadder-Origin-Token
            header_up -X-CiteLadder-Public-Host
          }
        }
        handle @ts_api {
          reverse_proxy 127.0.0.1:8100 {
            header_up Host __DOMAIN_NAME__
            header_up X-Forwarded-Host __DOMAIN_NAME__
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
            header_up -X-CiteLadder-Origin-Token
            header_up -X-CiteLadder-Public-Host
          }
        }
        reverse_proxy 127.0.0.1:8000 {
          header_up Host __DOMAIN_NAME__
          header_up X-Forwarded-Host __DOMAIN_NAME__
          header_up X-Forwarded-Proto https
          header_up X-Forwarded-For {client_ip}
          header_up -Forwarded
          header_up -X-Forwarded-Port
          header_up -X-Real-IP
          header_up -CF-Connecting-IP
          header_up -X-CiteLadder-Origin-Token
          header_up -X-CiteLadder-Public-Host
        }
      }
      handle @app {
        handle @ts_integrations {
          reverse_proxy 127.0.0.1:8100 {
            header_up Host __APP_DOMAIN_NAME__
            header_up X-Forwarded-Host __APP_DOMAIN_NAME__
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
            header_up -X-CiteLadder-Origin-Token
            header_up -X-CiteLadder-Public-Host
          }
        }
        handle @ts_api {
          reverse_proxy 127.0.0.1:8100 {
            header_up Host __APP_DOMAIN_NAME__
            header_up X-Forwarded-Host __APP_DOMAIN_NAME__
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {client_ip}
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
            header_up -X-CiteLadder-Origin-Token
            header_up -X-CiteLadder-Public-Host
          }
        }
        reverse_proxy 127.0.0.1:8000 {
          header_up Host __APP_DOMAIN_NAME__
          header_up X-Forwarded-Host __APP_DOMAIN_NAME__
          header_up X-Forwarded-Proto https
          header_up X-Forwarded-For {client_ip}
          header_up -Forwarded
          header_up -X-Forwarded-Port
          header_up -X-Real-IP
          header_up -CF-Connecting-IP
          header_up -X-CiteLadder-Origin-Token
          header_up -X-CiteLadder-Public-Host
        }
      }
      respond 403
    }
    respond 403
  }
}
