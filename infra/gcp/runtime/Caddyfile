{
  admin off
  auto_https disable_redirects
  servers {
    trusted_proxies static __CLOUDFLARE_CIDRS__
    client_ip_headers CF-Connecting-IP X-Forwarded-For
  }
}

http://__DOMAIN_NAME__ {
  redir https://{host}{uri} permanent
}

https://__DOMAIN_NAME__ {
  tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  # /register is deliberately absent: it is the frontend's signup page. MCP's
  # RFC 7591 registration endpoint lives at /mcp/register, covered by /mcp/*.
  @mcp_protocol path /mcp /mcp/* /authorize /token /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp
  reverse_proxy @mcp_protocol 127.0.0.1:8000 {
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto https
  }

  reverse_proxy 127.0.0.1:3000 {
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto https
  }
}
