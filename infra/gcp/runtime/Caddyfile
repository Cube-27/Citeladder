{
  admin off
  auto_https disable_redirects
  servers {
    trusted_proxies static __CLOUDFLARE_CIDRS__
    client_ip_headers CF-Connecting-IP X-Forwarded-For
  }
}

# Worker subrequests only. The secret is a dedicated GCP/Worker credential;
# the public host is independently allowlisted before being used upstream.
https://__ORIGIN_DOMAIN_NAME__ {
  tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key
  # This host carries authenticated Worker traffic. No edge or browser cache
  # may reuse a response for a different caller or ingress token.
  header >Cache-Control "private, no-store"
  @authorized {
    header X-CiteLadder-Origin-Token {$CITELADDER_ORIGIN_TOKEN}
    header X-CiteLadder-Origin-Token {$CITELADDER_ORIGIN_TOKEN_PREVIOUS}
  }
  @apex header X-CiteLadder-Public-Host __DOMAIN_NAME__
  @app header X-CiteLadder-Public-Host __APP_DOMAIN_NAME__
  # Route families the TypeScript API service owns (route-ownership manifest
  # in frontend/packages/contracts); every other path stays on :8000.
  @ts_api path /api/v1/executions/* /api/v1/projects/*/ai-referrals /api/v1/projects/*/visibility /api/v1/projects/*/visibility/* /api/v1/projects/*/visibility/sources/* /api/v1/projects/*/performance /api/v1/projects/*/performance/table /api/v1/projects/*/performance/range /api/v1/projects/*/performance/range/* /api/v1/projects/*/demand/* /api/v1/projects/*/demand/query-evidence/summary /api/v1/projects/*/opportunities /api/v1/projects/*/opportunities/* /api/v1/opportunities/* /api/v1/projects/*/actions /api/v1/actions/* /api/v1/projects/*/search-intelligence /api/v1/projects/*/search-intelligence/preferences /api/v1/projects/*/search-intelligence/runs /api/v1/projects/*/search-intelligence/runs/* /api/v1/projects/*/search-intelligence/runs/*/confirm /api/v1/projects/*/search-intelligence/runs/*/cancel /api/v1/projects/*/search-intelligence/datasets/*/rows /api/v1/projects/*/search-intelligence/content-handoff /api/v1/projects/*/search-intelligence/citation-matches /api/v1/projects/*/commerce/catalog /api/v1/projects/*/commerce/catalog/import /api/v1/projects/*/commerce/competitors /api/v1/projects/*/commerce/competitors/discoveries /api/v1/projects/*/commerce/competitors/*-*-*-*-* /api/v1/projects/*/commerce/buyer-prompts/generate /api/v1/projects/*/commerce/buyer-prompts/manual /api/v1/projects/*/commerce/buyer-prompts /api/v1/projects/*/commerce/buyer-prompts/*-*-*-*-* /api/v1/projects/*/commerce/ai-shelf /api/v1/projects/*/brand-profile /api/v1/projects/*/business-map /api/v1/projects/*/competitor-suggestions /api/v1/projects/*/competitor-suggestions/*/accept /api/v1/projects/*/logo /api/v1/projects/*/topics /api/v1/topics/* /api/v1/prompt-sets /api/v1/prompt-sets/*-*-*-*-* /api/v1/prompt-sets/*/generate /api/v1/prompt-sets/*/prompts /api/v1/prompt-sets/*/prompts/bulk-status /api/v1/prompt-sets/*/import /api/v1/prompt-sets/*/candidates /api/v1/prompt-sets/*/candidates/review /api/v1/prompts/* /api/v1/projects/*/competitors/*/logo /api/v1/entitlements /api/v1/si