# Shared by local Compose and production ingress. Caddy preserves the original
# host and supplies X-Forwarded-Host/Proto for each upstream automatically.
# /register is a browser route; dynamic MCP registration is /mcp/register.
@backend path /api /api/* /mcp /mcp/* /authorize /token /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/mcp
reverse_proxy @backend {$BACKEND_ORIGIN:127.0.0.1:8000}

@vite_assets path /app-assets/*
reverse_proxy @vite_assets {$VITE_ORIGIN:127.0.0.1:3001}

@astro_assets path /_astro/*
reverse_proxy @astro_assets {$MARKETING_ORIGIN:127.0.0.1:3000}

# Exact application paths and bounded dynamic routes retain Vite ownership.
# Unknown descendants fall through to Astro and return a real 404.
@vite_exact path /login /login/ /register /register/ /projects /projects/ /onboarding /onboarding/ /site /site/ /issues /issues/ /demand /demand/ /search-intelligence /search-intelligence/ /performance /performance/ /opportunities /opportunities/ /visibility /visibility/ /runs /runs/ /prompts /prompts/ /content /content/ /products /products/ /ai-referrals /ai-referrals/ /settings /settings/ /invitations/accept /invitations/accept/
reverse_proxy @vite_exact {$VITE_ORIGIN:127.0.0.1:3001} {
  header_down Cache-Control "no-store"
}
@vite_dynamic path_regexp vite_dynamic ^/(?:runs/[^/]+|site/crawls/[^/]+/pages/[^/]+)/?$
reverse_proxy @vite_dynamic {$VITE_ORIGIN:127.0.0.1:3001} {
  header_down Cache-Control "no-store"
}

reverse_proxy {$MARKETING_ORIGIN:127.0.0.1:3000}
