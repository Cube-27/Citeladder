# Line endings are LF in the index and in every working tree, whatever the
# local git configuration. The formatter writes LF, and the tooling (migration
# checksums, generated-file checks) reads files byte for byte.
* text=auto eol=lf

# Binary assets: never touched, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Vendored data: GitHub collapses it in pull request diffs.
frontend/services/api/src/config/disposable-email-domains.json linguist-generated=true
